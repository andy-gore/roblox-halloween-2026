		<Item class="Folder" referent="RBXce6bf6c42f124ed4ae11fe1a54672ff9">
      <Properties>
        <string name="Name">HalloweenServer</string>
      </Properties>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_1">
        <Properties>
          <string name="Name">AssetDressing</string>
          <string name="Source">--!strict
-- Placement and collision stay on the server; original GLB visuals load locally on clients.
local Props = require(script.Parent.PubProps)
local Dressing = {}
local function ref(parent: Instance, name: string, value: Instance)
    local object = Instance.new("ObjectValue") object.Name, object.Value, object.Parent = name, value, parent
end
function Dressing.reroll(map: Folder)
    local folder = map:FindFirstChild("AssetPlacements")
    if not folder then return end
    local candidates = {}
    for _, object in folder:GetChildren() do
        if object:GetAttribute("CobwebCandidate") then table.insert(candidates, object) end
    end
    local random = Random.new()
    for i = #candidates, 2, -1 do
        local j = random:NextInteger(1, i) candidates[i], candidates[j] = candidates[j], candidates[i]
    end
    for i, object in candidates do object:SetAttribute("Enabled", i &lt;= 10) end
end
function Dressing.build(map: Folder)
    local folder = Instance.new("Folder") folder.Name, folder.Parent = "AssetPlacements", map
    local number = 0
    local function add(asset: string, origin: CFrame, scale: Vector3?, replacements: {Instance}?, target: Instance?, mode: string?): Part
        number += 1
        local marker = Props.part(folder, "Asset" .. number, Vector3.new(0.02, 0.02, 0.02), origin, Color3.new())
        marker.Transparency = 1
        marker:SetAttribute("AssetName", asset) marker:SetAttribute("AssetScale", scale or Vector3.one)
        marker:SetAttribute("Enabled", true) marker:SetAttribute("Mode", mode or "Static")
        for i, object in replacements or {} do ref(marker, "Replacement" .. i, object) end
        if target then
            ref(marker, "Target", target)
            if target:IsA("BasePart") then marker:SetAttribute("FollowOffset",target.CFrame:ToObjectSpace(origin)) end
        end
        return marker
    end
    local function at(name: string, position: Vector3, radius: number): {Instance}
        local result = {}
        for _, object in map:GetDescendants() do
            if object:IsA("BasePart") and object.Name == name and (object.Position - position).Magnitude &lt; radius then table.insert(result, object) end
        end
        return result
    end
    local function append(a: {Instance}, b: {Instance}) for _, v in b do table.insert(a, v) end end
    -- Existing solid furniture proxies are retained, including their original dimensions.
    for _, object in map:GetChildren() do
        if object:IsA("BasePart") and (object.Name == "PubTable" or object.Name == "SnugTable" or object.Name == "OfficeDesk") then
            local replacements: {Instance} = {object}
            for _, name in {"TablePlank", "TableLeg", "TableApron", "TableCrossRail", "TableStretcher"} do append(replacements, at(name, object.Position, 8)) end
            add("PubTable", CFrame.new(object.Position.X, 0.5, object.Position.Z), Vector3.new(object.Size.X/7, 1, object.Size.Z/6), replacements)
        end
    end
    for _, p in {Vector3.new(-17,0.5,33.3), Vector3.new(25,0.5,33.3), Vector3.new(-41,0.5,-3), Vector3.new(-37,0.5,-37.3), Vector3.new(-2,0.5,60)} do
        local replacements = {}
        for _, name in {"ChairSeat","ChairBackPost","ChairFrontLeg","ChairRail","ChairBackRail","ChairSlat","BurgundyCushion"} do append(replacements, at(name,p+Vector3.new(0,2,0),4)) end
        local yaw = if p.X == -41 then math.pi/2 elseif p.Z &lt; -30 then 0 else math.pi
        add("PubChair", CFrame.new(p)*CFrame.Angles(0,yaw,0), nil, replacements)
    end
    -- Eight bedrooms: exact Blender furniture, collision proxies and nine key spots unchanged.
    for sideIndex, side in {-1, 1} do
        for i, z in {-30,-10,10,30} do
            local room = (sideIndex-1)*4+i
            -- Keep the tested room fill lights while removing their temporary glowing cubes.
            for _,old in at("GuestLantern",Vector3.new(side*23,27,z),0.2) do
                (old :: BasePart).Transparency=1
            end
            local bedPosition = Vector3.new(side*40,17.8,z+3)
            local replacements = at("BedroomBed",bedPosition,1)
            append(replacements,at("BedroomHeadboard",bedPosition,5))
            for _, name in {"IvoryMattress","BurgundyBedspread","IvoryPillow"} do append(replacements,at(name,bedPosition,5)) end
            add("InnSingleBed",CFrame.new(side*40,16.5,z+3),nil,replacements)
            local dresser = Vector3.new(side*25,18,z-6)
            replacements = at("BedroomDresser",dresser,1)
            for _,name in {"DresserDrawer","BrassDrawerHandle"} do append(replacements,at(name,dresser,4)) end
            add("DresserMirror",CFrame.new(side*25,16.5,z-6),Vector3.new(5/3.9,3/2.79,2.4/1.9),replacements)
            replacements=at("BedroomWardrobe",Vector3.new(side*43,20,z-6),1)
            append(replacements,at("WardrobeBrass",Vector3.new(side*43,20,z-6),3))
            add("InnWardrobe",CFrame.new(side*43,16.5,z-6),nil,replacements)
            local cabinet=Vector3.new(side*36,16.5,z+3.5)
            local collision=Props.part(map,"BedsideCabinetCollider",Vector3.new(2.05,2.425,1.7),CFrame.new(cabinet+Vector3.new(0,1.2125,0)),Color3.new())
            collision.Transparency,collision.CanCollide,collision.CanQuery=1,true,true
            collision:SetAttribute("BlocksNavigation",true)
            add("BedsideCabinet",CFrame.new(cabinet))
            local top=cabinet+Vector3.new(0,2.425,0)
            add("BedsideLamp",CFrame.new(top+Vector3.new(-0.45,0,0)),Vector3.one*0.8)
            add("BedsideBooks",CFrame.new(top+Vector3.new(0.55,0,0)),Vector3.one*0.6)
            local bulb=Props.part(folder,"BedsideBulb",Vector3.one*0.08,CFrame.new(top+Vector3.new(-0.45,1.08,0)),Color3.fromRGB(255,210,144),Enum.Material.Neon)
            local light=Instance.new("PointLight") light.Name,light.Range,light.Brightness,light.Color="PowerLight",10,0.35,bulb.Color light.Parent=bulb
            if room%2==1 then add("TravellerSuitcase",CFrame.new(side*44.4,16.5,z+7.8)*CFrame.Angles(0,0.15*side,0),Vector3.one*0.9) end
            add("BedroomCoatRail",CFrame.new(side*32,23,z-9.35))
            add(if room%2==1 then "PortraitFrame" else "LandscapeFrame",CFrame.new(side*40,23,z-9.3))
            -- Door plaques sit beside, rather than over, the readable existing room labels.
            local origin=CFrame.new(side*7.35,22.5,z+7.7)*CFrame.Angles(0,-side*math.pi/2,0)
            add("BedroomNumberBlank",origin,Vector3.one*1.5)
            -- One shared original plaque mesh, with editable native numerals on its front.
            local face=Props.part(folder,"BedroomPlaqueLettering",Vector3.new(1.05,1.35,.01)*1.5,origin*CFrame.new(0,.675*1.5,.18*1.5),Color3.new())
            face.Transparency=1
            face:SetAttribute("RoomNumber",room)
            local gui=Instance.new("SurfaceGui") gui.Face=Enum.NormalId.Back
            gui.SizingMode,gui.PixelsPerStud,gui.LightInfluence,gui.Brightness=Enum.SurfaceGuiSizingMode.PixelsPerStud,100,0,.9
            gui.Parent=face
            local label=Instance.new("TextLabel") label.BackgroundTransparency=1
            label.Position,label.Size=UDim2.fromScale(.24,.25),UDim2.fromScale(.52,.5)
            label.Text,label.TextScaled,label.TextColor3=tostring(room),true,Color3.fromRGB(240,223,188)
            label.FontFace=Font.new("rbxasset://fonts/families/Fondamento.json") label.Parent=gui
        end
    end
    -- Countertop and storage dressing kept clear of the established walking routes.
    add("OpenGuestbook",CFrame.new(-32,4.62,17.1))
    add("StonewareMug",CFrame.new(-24,4.62,16.8))
    add("BedsideBooks",CFrame.new(-40,3.55,-34.1),Vector3.one*0.7,at("OldLedger",Vector3.new(-39.3,4.1,-34.5),2))
    for _,y in {5.425,7.625} do
        for i=0,6 do
            local p=Vector3.new(-34+i*2,y,9.2)
            local replacements=at("DustyBottle",p+Vector3.new(0,0.675,0),0.5)
            append(replacements,at("BottleNeck",p+Vector3.new(0,1.525,0),0.5))
            add(if i%2==0 then "GreenBottle" else "AmberBottle",CFrame.new(p),nil,replacements)
        end
    end
    add("KitchenStockpot",CFrame.new(19,3.7,-31))
    add("KitchenFryingPan",CFrame.new(19,3.7,-25)*CFrame.Angles(0,math.pi/2,0))
    add("KitchenPlateStack",CFrame.new(19,3.7,-18))
    add("CellarShelf",CFrame.new(21,0.5,-37.7))
    add("CellarBucket",CFrame.new(21,0.5,-15.5))
    add("CellarBroom",CFrame.new(21,0.5,-14))
    add("OpenCellarCrate",CFrame.new(69.5,-15.5,-37))
    add("ClosedCellarCrate",CFrame.new(69.5,-15.5,-42))
    add("CellarShelf",CFrame.new(69.5,-15.5,-49))
    add("CellarBucket",CFrame.new(69.5,-15.5,-54))
    for _,x in {44,52} do for _,z in {-46,-38} do
        local replacements={}
        for _,name in {"BarrelStave","IronBarrelHoop","BarrelHead"} do append(replacements,at(name,Vector3.new(x,-13.5,z),2.9)) end
        add("CellarBarrel",CFrame.new(x,-15.5,z),nil,replacements)
    end end
    local loose=map.CellarDressing:FindFirstChild("LooseCellarCrate") :: BasePart
    add("ClosedCellarCrate",loose.CFrame*CFrame.new(0,-2,0),Vector3.new(3.5/2.18,4/1.635,3.5/1.649),{loose},loose,"Crate")
    local bell=map.Bell :: BasePart
    add("ServiceBell",CFrame.new(-20,4.62,17),nil,{bell},bell,"Bell")
    local key=map.OfficeKey :: BasePart
    add("ExitKey",key.CFrame,Vector3.one*1.5,nil,key,"Key")
    local door=map.ExitDoor :: BasePart
    add("ExitDoorLock",CFrame.new(-36,3.5,39.35)*CFrame.Angles(0,math.pi,0),nil,at("ExitHandle",Vector3.new(-36,5.5,39.25),1),door,"Door")
    local main=map.CellarFuseBox :: BasePart
    local hide: {Instance}={main,map.CellarDressing.CellarFuseBoxHandle,map.CellarDressing.CellarFuseBoxIndicator}
    add("CellarFuseBox",CFrame.new(25.5,-13.7,-43)*CFrame.Angles(0,math.pi/2,0),nil,hide,map.CellarPowerPanel,"Power")
    -- Curated high, quiet corners. The subset changes only on a server run reset.
    for sideIndex,side in {-1,1} do for i,z in {-30,-10,10,30} do
        local web=add("CornerCobweb",CFrame.new(side*46.8,29,z-9.35)*CFrame.Angles(0,if side&lt;0 then 0 else math.pi,0),Vector3.one*0.9)
        web:SetAttribute("CobwebCandidate",true) web:SetAttribute("Room",(sideIndex-1)*4+i)
    end end
    for _,row in {
        {"HangingCobweb",CFrame.new(69,-3,-61),0.95},
        {"CornerCobweb",CFrame.new(25.2,-2.3,-62.8)*CFrame.Angles(0,math.pi/2,0),1},
        {"ShelfCobweb",CFrame.new(68,-11.1,-49),0.9},
        {"CornerCobweb",CFrame.new(-46.8,12.4,-38.8),1},
        {"CornerCobweb",CFrame.new(-46.8,12.4,-14.9),0.8},
        {"ShelfCobweb",CFrame.new(19.4,4.9,-37.5),0.75},
        {"HangingCobweb",CFrame.new(-44,12.7,37.5),0.8},
        {"CornerCobweb",CFrame.new(47,28.8,86.8)*CFrame.Angles(0,math.pi,0),0.85},
    } do
        local web=add(row[1] :: string,row[2] :: CFrame,Vector3.one*(row[3] :: number))
        web:SetAttribute("CobwebCandidate",true)
    end
    require(script.Parent.StormWindows).build(map,add)
    require(script.Parent.AtmosphereDressing).build(map,add)
    Dressing.reroll(map)
    folder:SetAttribute("PlacementCount",number)
end
return Dressing
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_2">
        <Properties>
          <string name="Name">AtmosphereDressing</string>
          <string name="Source">--!strict
-- Original atmosphere-pack placements; all visuals are non-colliding client meshes.
local Props=require(script.Parent.PubProps)
local Dressing={}
type Add=(string,CFrame,Vector3?,{Instance}?,Instance?,string?)-&gt;Part
function Dressing.build(map: Folder,add: Add)
    add("TwinBeerPump",CFrame.new(-32,4.62,16))
    add("BarDripTray",CFrame.new(-32,4.62,17.2))
    add("PewterTankardRack",CFrame.new(-40,6,8.8))
    add("CoasterStack",CFrame.new(-16,3.55,29))
    add("SinglePewterMug",CFrame.new(-18,3.55,29))
    add("StoppedPubClock",CFrame.new(-27,10,8.8))
    add("FramedCountryside",CFrame.new(-34,7,-39.2))
    add("FramedWoodland",CFrame.new(-47.2,7,-10)*CFrame.Angles(0,math.pi/2,0))
    add("PubDartboard",CFrame.new(-47.2,5,-12)*CFrame.Angles(0,math.pi/2,0))
    -- Beads/trails only: the exporter omits the pack's full backing pane.
    for _,window in map.StormViewWindows:GetChildren() do
        if window:IsA("BasePart") and window.Name=="WindowBarrier" then
            local wide=window.Size.Z&gt;5
            local side=math.sign(window.Position.X)
            local cf=CFrame.new(side*47.7,window.Position.Y-window.Size.Y/2,window.Position.Z)*CFrame.Angles(0,-side*math.pi/2,0)
            add(if wide then "RainStreakPaneWide" else "RainStreakPaneNarrow",cf,Vector3.new(window.Size.Z/(if wide then 4.8 else 2.4),window.Size.Y/4.4,1))
        end
    end
    -- Native transparent water avoids spending six mesh allocations on three floor films.
    local water=Instance.new("Folder") water.Name="AtmosphereWater" water.Parent=map
    for _,row in {{"SmallPuddle",Vector3.new(-54,.51,105),Vector3.new(2.293,.025,1.338)},
        {"DoorwayPuddle",Vector3.new(6,.53,95),Vector3.new(4.378,.025,1.646)},
        {"CourtyardPuddle",Vector3.new(-36,.53,60),Vector3.new(5.838,.025,3.292)}} do
        for i=1,3 do
            local size=row[3] :: Vector3
            local origin=row[2] :: Vector3
            local film=Props.part(water,row[1] :: string,size*Vector3.new(.65,1,.8),CFrame.new(origin+Vector3.new((i-2)*size.X*.18,0,(i%2)*size.Z*.08))*CFrame.Angles(0,(i-2)*.16,0),Color3.fromRGB(66,88,106),Enum.Material.Glass)
            film.Shape,film.Transparency,film.Reflectance=Enum.PartType.Ball,.48,.12
            film:SetAttribute("SourceAsset","assets/props/atmosphere-set/storm/"..(row[1] :: string)..".glb")
        end
    end
    add("GalvanisedBin",CFrame.new(-49.5,.5,53))
    add("BrokenCourtyardPlanter",CFrame.new(-49,.5,66))
    for _,x in {-.6,12.6} do
        for _,y in {1.4,6.4} do add("DrainpipeStraight",CFrame.new(x,y,89.3)) end
        add("DrainpipeOffset",CFrame.new(x,11.4,89.3))
        add("DrainpipeShoe",CFrame.new(x,.5,89.3))
    end
    local decor=Instance.new("Folder") decor.Name="AtmosphereLights" decor.Parent=map
    for _,position in {Vector3.new(-50.3,5.2,58),Vector3.new(-21.7,5.2,82)} do
        local cf=CFrame.new(position)*CFrame.Angles(0,if position.X&lt; -30 then math.pi/2 else -math.pi/2,0)
        add("CourtyardWallLantern",cf)
        local bulb=Props.part(decor,"LanternLightSource",Vector3.one*.1,cf*CFrame.new(0,1,.65),Color3.fromRGB(255,189,105))
        bulb.Transparency=1
        local l=Instance.new("PointLight") l.Color,l.Brightness,l.Range,l.Shadows,l.Parent=bulb.Color,.65,16,true,bulb
    end
end
return Dressing
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_3">
        <Properties>
          <string name="Name">BreakerSequence</string>
          <string name="Source">--!strict
-- Small server-owned sequence; only the final lever can complete the power objective.
local Sequence = {}
local order = {"Cellar", "Guest", "Bar"}
function Sequence.new()
    local progress, powered = 0, false
    local controller = {}
    function controller.reset() progress, powered = 0, false end
    function controller.progress(): number return progress end
    function controller.powered(): boolean return powered end
    function controller.press(circuit: string): boolean
        if powered then return false end
        if circuit ~= order[progress+1] then progress=0 return false end
        progress+=1
        return true
    end
    function controller.pullMain(): boolean
        if powered or progress~=#order then return false end
        powered=true
        return true
    end
    return controller
end
return Sequence
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_4">
        <Properties>
          <string name="Name">CellarMap</string>
          <string name="Source">--!strict
-- Fixed cellar expansion below the pub; the original stair opening stays in place.
local Props=require(script.Parent.PubProps)
local Cellar={}
Cellar.MonsterHome=Vector3.new(64,-11.5,-60)
function Cellar.build(map: Folder)
    local stone,wood=Color3.fromRGB(77,80,86),Color3.fromRGB(59,37,29)
    local decor=Instance.new("Folder") decor.Name="CellarDressing"
    local function solid(name: string,size: Vector3,position: Vector3): Part
        local p=Instance.new("Part") p.Name,p.Size,p.Position=name,size,position
        p.Anchored,p.Color,p.Material=true,stone,Enum.Material.Slate
        p:SetAttribute("BlocksNavigation",not string.find(name,"Floor") and not string.find(name,"Step"))
        p.Parent=map return p
    end
    local function detail(name: string,size: Vector3,position: Vector3,color: Color3): Part
        return Props.part(decor,name,size,CFrame.new(position),color)
    end
    local function label(name: string,text: string,position: Vector3,width: number,height: number,angle: number): Part
        local board=detail(name,Vector3.new(width,height,0.12),position,Color3.fromRGB(37,30,30))
        board.CFrame*=CFrame.Angles(0,angle,0)
        for _,face in {Enum.NormalId.Front,Enum.NormalId.Back} do
            local gui=Instance.new("SurfaceGui") gui.Face,gui.LightInfluence=face,0
            gui.SizingMode,gui.PixelsPerStud,gui.Parent=Enum.SurfaceGuiSizingMode.PixelsPerStud,65,board
            local textLabel=Instance.new("TextLabel")
            textLabel.Size,textLabel.Position=UDim2.fromScale(0.94,0.9),UDim2.fromScale(0.03,0.05)
            textLabel.BackgroundTransparency,textLabel.TextScaled,textLabel.TextWrapped=1,true,true
            textLabel.Font,textLabel.TextColor3,textLabel.Text=Enum.Font.GothamBold,Color3.fromRGB(255,232,188),text
            textLabel.Parent=gui
        end
        return board
    end
    local function lamp(name: string,position: Vector3,brightness: number,range: number): PointLight
        local bulb=detail("CellarLantern",Vector3.new(0.6,0.9,0.6),position,Color3.fromRGB(255,189,105))
        bulb.Material=Enum.Material.Neon
        local light=Instance.new("PointLight") light.Name,light.Color,light.Brightness,light.Range=name,bulb.Color,brightness,range
        light.Shadows,light.Parent=true,bulb return light
    end
    solid("CellarFloor",Vector3.new(48,1,74),Vector3.new(48,-16,-27))
    solid("CellarWestWall",Vector3.new(1,16,74),Vector3.new(24,-8,-27))
    solid("CellarEastWall",Vector3.new(1,16,74),Vector3.new(72,-8,-27))
    solid("CellarNorthWall",Vector3.new(48,16,1),Vector3.new(48,-8,-64))
    solid("CellarSouthWall",Vector3.new(48,16,1),Vector3.new(48,-8,10))
    -- Cover the new underground area without sealing the original stairs.
    solid("CellarCeilingFloor",Vector3.new(48,0.5,40),Vector3.new(48,-0.9,-44))
    solid("CellarEastCeilingFloor",Vector3.new(24,0.5,34),Vector3.new(60,-0.9,-7))
    for step=0,15 do
        solid("CellarStep",Vector3.new(22,1,2),Vector3.new(36,-step,7-step*2)).Color=Color3.fromRGB(133,132,124)
        local edge=detail("StairEdge",Vector3.new(21,0.08,0.18),Vector3.new(36,0.55-step,6.1-step*2),Color3.fromRGB(255,195,85))
        edge.Material=Enum.Material.Neon
    end
    lamp("StairSafetyLight",Vector3.new(46,3,4),2,36)
    lamp("CellarSafetyLight",Vector3.new(27,-6,-30),0.8,27)
    lamp("CellarSafetyLight",Vector3.new(27,-6,-53),1,22)
    lamp("PanelWorkLight",Vector3.new(29,-7,-50),2.5,24).Color=Color3.fromRGB(255,226,169)
    lamp("CellarSafetyLight",Vector3.new(69,-6,-28),0.6,26)
    lamp("PowerLight",Vector3.new(67,-4,-47),0.35,36)
    lamp("PowerLight",Vector3.new(48,-4,-58),0.35,34)
    lamp("CellarCueLight",Vector3.new(66,-5,-60),0,24)
    -- One solid rack leaves wide west/east passages and cross-passages at both ends.
    local rack=solid("CellarRack",Vector3.new(16,8,16),Vector3.new(48,-11.5,-42))
    rack.Transparency=1
    for _,y in {-15.3,-11.4,-7.5} do detail("RackShelf",Vector3.new(16,0.25,16),Vector3.new(48,y,-42),wood) end
    for _,x in {40.3,48,55.7} do
        for _,z in {-49.7,-34.3} do detail("RackUpright",Vector3.new(0.5,8,0.5),Vector3.new(x,-11.5,z),wood) end
    end
    for _,x in {44,52} do
        for _,z in {-46,-38} do
            -- Leave the upper shelf open so the raised tankard and head can be seen beyond it.
            Props.barrel(decor,CFrame.new(x,-15.5,z))
        end
    end
    local crate=solid("CellarCrateCollider",Vector3.new(3.5,4,3.5),Vector3.new(58,-13.5,-51)) crate.Transparency=1
    detail("LooseCellarCrate",crate.Size,crate.Position,Color3.fromRGB(89,55,34))
    local panel=solid("CellarPowerPanel",Vector3.new(0.8,7,20),Vector3.new(24.9,-10.2,-51))
    panel.Color,panel.Material=Color3.fromRGB(52,62,66),Enum.Material.Metal
    for _,z in {-61,-41} do
        detail("PanelSafetyTrim",Vector3.new(0.2,6.8,0.25),Vector3.new(25.4,-10.2,z),Color3.fromRGB(229,168,57))
    end
    local function station(name: string,text: string,z: number): Part
        local p=Instance.new("Part") p.Name,p.Size,p.Position=name,Vector3.new(0.8,1.8,2.4),Vector3.new(26,-11.6,z)
        p.Anchored,p.CanCollide,p.Color,p.Material=true,false,Color3.fromRGB(211,128,40),Enum.Material.Metal
        p.Parent=map
        local prompt=Instance.new("ProximityPrompt") prompt.ActionText,prompt.ObjectText="Flip switch",text
        -- Third-person camera occlusion must not conceal the controls; server eye rays still validate use.
        prompt.MaxActivationDistance,prompt.HoldDuration,prompt.RequiresLineOfSight=6,0.25,false
        prompt.Enabled,prompt.Parent=false,p
        label("BreakerLabel",text,Vector3.new(26.5,-9.6,z),3.4,.6,math.pi/2)
        local handle=detail(name.."Handle",Vector3.new(0.7,1.4,0.5),Vector3.new(26.9,-11.8,z),Color3.fromRGB(239,186,70))
        handle.Material=Enum.Material.Metal
        local indicator=detail(name.."Indicator",Vector3.new(0.2,0.5,0.5),Vector3.new(26.6,-11.1,z+0.75),Color3.fromRGB(77,63,45))
        indicator.Material=Enum.Material.Neon
        return p
    end
    station("CellarBreakerCellar","CELLAR",-58)
    station("CellarBreakerGuest","GUEST ROOMS",-53)
    station("CellarBreakerBar","BAR",-48)
    local main=station("CellarFuseBox","MAIN SUPPLY",-43)
    main.Size,main.Color=Vector3.new(0.8,2.4,2.4),Color3.fromRGB(104,44,35)
    local mainHandle=decor:FindFirstChild("CellarFuseBoxHandle") :: BasePart
    mainHandle.Size,mainHandle.Color=Vector3.new(0.8,1.7,0.6),Color3.fromRGB(210,62,43)
    local mainPrompt=main:FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
    mainPrompt.ActionText,mainPrompt.HoldDuration="Pull main lever",0.4
    local monster=Instance.new("Part") monster.Name,monster.Size,monster.Position="ChuggernaughtPlaceholder",Vector3.new(4,8,4),Cellar.MonsterHome
    monster.Anchored,monster.CanCollide,monster.CanQuery,monster.Transparency=true,false,false,1
    monster.Parent=map
    decor.Parent=map
end
function Cellar.addRoutes(positions: {Vector3},edges: {{number}})
    local function node(position: Vector3): number table.insert(positions,position) return #positions end
    local function link(a: number,b: number) table.insert(edges,{a,b}) end
    local front=node(Vector3.new(33,-11.5,-28))
    local west=node(Vector3.new(33,-11.5,-57))
    local east=node(Vector3.new(64,-11.5,-57))
    local right=node(Vector3.new(64,-11.5,-28))
    local panel=node(Vector3.new(31,-11.5,-53))
    local main=node(Vector3.new(31,-11.5,-43))
    link(15,front) link(front,west) link(west,east) link(east,right) link(right,15) link(east,16)
    link(west,panel) link(panel,main) link(main,front)
end
return Cellar
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_5">
        <Properties>
          <string name="Name">CellarPower</string>
          <string name="Source">--!strict
-- Server-owned panel presentation and anticipation cues; no monster or objective advancement here.
local Sequence=require(script.Parent.BreakerSequence)
local TweenService=game:GetService("TweenService")
local Power={}
local circuits={"Cellar","Guest","Bar"}
function Power.new(map: Folder)
    local sequence=Sequence.new()
    local decor=map:WaitForChild("CellarDressing")
    local panel=map:WaitForChild("CellarPowerPanel")
    local cue=map:FindFirstChild("CellarCueLight",true) :: PointLight
    local crate=decor:WaitForChild("LooseCellarCrate") :: BasePart
    local crateHome=crate.CFrame
    local handles: {[string]: BasePart}={}
    local indicators: {[string]: BasePart}={}
    local bind: {[string]: CFrame}={}
    local names={"CellarBreakerCellar","CellarBreakerGuest","CellarBreakerBar","CellarFuseBox"}
    for _,name in names do
        handles[name]=decor:WaitForChild(name.."Handle") :: BasePart
        indicators[name]=decor:WaitForChild(name.."Indicator") :: BasePart
        bind[name]=handles[name].CFrame
    end
    local function sound(name: string,parent: Instance,path: string,volume: number,pitch: number): Sound
        local s=Instance.new("Sound") s.Name,s.SoundId,s.Volume,s.PlaybackSpeed=name,path,volume,pitch
        s.RollOffMinDistance,s.RollOffMaxDistance,s.Parent=7,70,parent return s
    end
    -- Existing bundled local placeholders; no asset uploads.
    local click=sound("BreakerClunk",panel,"rbxasset://sounds/action_footsteps_plastic.mp3",0.4,0.6)
    local thud=sound("BarrelShift",crate,"rbxasset://sounds/action_footsteps_plastic.mp3",0.55,0.4)
    local glug=sound("CellarGlug",cue.Parent :: Instance,"rbxasset://sounds/impact_water.mp3",0.5,0.65)
    local tween: Tween?=nil
    local wrong: string?=nil
    local controller={}
    local function apply()
        local progress=sequence.progress()
        for i,name in names do
            local on=if i==4 then sequence.powered() else i&lt;=progress
            handles[name].CFrame=bind[name]*CFrame.Angles(0,0,if on then -0.8 else 0.15)
            indicators[name].Color=if wrong==name then Color3.fromRGB(215,61,42)
                elseif on or (i==4 and progress==3) then Color3.fromRGB(113,222,112) else Color3.fromRGB(107,77,41)
        end
        cue.Brightness=if sequence.powered() then 2.6 elseif progress&gt;0 then 1.2+progress*0.3 else 0
        panel:SetAttribute("BreakerProgress",progress)
        panel:SetAttribute("Powered",sequence.powered())
        for i,name in names do
            local prompt=(map:FindFirstChild(name) :: BasePart):FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
            prompt.ObjectText=if i==4 then (if progress==3 then "MAIN SUPPLY — READY" else "MAIN SUPPLY — "..progress.."/3 CIRCUITS")
                else (if i==1 then "CELLAR" elseif i==2 then "GUEST ROOMS" else "BAR")..(if i&lt;=progress then " — ON" else " — OFF")
        end
    end
    function controller.reset()
        sequence.reset() wrong=nil
        if tween then tween:Cancel() tween=nil end
        crate.CFrame=crateHome
        click:Stop() thud:Stop() glug:Stop()
        apply()
    end
    function controller.available(enabled: boolean)
        for _,name in names do
            local prompt=(map:FindFirstChild(name) :: BasePart):FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
            prompt.Enabled=enabled
        end
    end
    function controller.use(name: string): (boolean,string)
        if name=="CellarFuseBox" then
            if not sequence.pullMain() then
                click.PlaybackSpeed=0.45 click:Play()
                return false,"The main supply is not ready. Set the three circuits first."
            end
            wrong=nil apply()
            return true,"The lights are back on. Something is waking up."
        end
        local circuit: string?=nil
        for _,id in circuits do if name=="CellarBreaker"..id then circuit=id break end end
        if not circuit then return false,"Unknown circuit." end
        if sequence.powered() then return false,"The lights are already restored." end
        local accepted=sequence.press(circuit)
        wrong=if accepted then nil else name
        click.PlaybackSpeed=if accepted then 0.9 else 0.45 click:Play()
        apply()
        if not accepted then
            if tween then tween:Cancel() tween=nil end
            crate.CFrame=crateHome thud:Stop() glug:Stop()
            return false,"Wrong circuit. Sequence reset. Try a different order."
        end
        local progress=sequence.progress()
        if progress==1 then return false,"Cellar circuit set. A light comes on behind the barrels."
        elseif progress==2 then
            thud:Play()
            if tween then tween:Cancel() end
            crate.CFrame=crateHome*CFrame.Angles(0,0,0.045)
            tween=TweenService:Create(crate,TweenInfo.new(0.5,Enum.EasingStyle.Bounce),{CFrame=crateHome}) tween:Play()
            return false,"Guest rooms circuit set. Something shifted behind the racks."
        end
        glug:Play()
        return false,"Bar circuit set. GLUG… The main lever is ready."
    end
    controller.reset()
    return controller
end
return Power
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_6">
        <Properties>
          <string name="Name">ExitKeyVisual</string>
          <string name="Source">--!strict
-- Native brass key geometry follows the authoritative pickup; all cues respect walls.
local Visual={}
function Visual.new(key: BasePart)
    key.Size,key.Color,key.Material=Vector3.new(1.9,0.2,0.2),Color3.fromRGB(240,190,65),Enum.Material.Metal
    key.CastShadow=false
    local model=Instance.new("Model") model.Name="BrassKey" model.Parent=key
    local pieces: {{part: BasePart, offset: CFrame}}={}
    local function piece(name: string,size: Vector3,offset: CFrame)
        local p=Instance.new("Part") p.Name,p.Size,p.Color,p.Material=name,size,key.Color,Enum.Material.Metal
        p.Anchored,p.CanCollide,p.CanTouch,p.CanQuery,p.CastShadow=true,false,false,false,false
        p.Transparency,p.Parent=1,model
        table.insert(pieces,{part=p,offset=offset})
    end
    for i=0,11 do
        local angle=i*math.pi/6
        local position=Vector3.new(-1.55+math.cos(angle)*0.6,0,math.sin(angle)*0.6)
        piece("KeyBow",Vector3.new(0.34,0.2,0.16),CFrame.new(position)*CFrame.Angles(0,-angle-math.pi/2,0))
    end
    for _,x in {0.45,0.8} do piece("KeyTooth",Vector3.new(0.18,0.2,0.55),CFrame.new(x,0,0.25)) end
    local light=Instance.new("PointLight") light.Name="ExitKeyGlow"
    light.Color,light.Range,light.Brightness,light.Enabled=key.Color,7,0.65,false light.Parent=key
    local tag=Instance.new("BillboardGui") tag.Name,tag.Adornee="ExitKeyLabel",key
    tag.Size,tag.StudsOffsetWorldSpace,tag.MaxDistance=UDim2.fromOffset(110,26),Vector3.new(0,1,0),18
    tag.AlwaysOnTop,tag.Enabled,tag.Parent=false,false,key
    local textLabel=Instance.new("TextLabel") textLabel.Size,textLabel.BackgroundTransparency=UDim2.fromScale(1,1),1
    textLabel.Text,textLabel.Font,textLabel.TextSize="EXIT KEY",Enum.Font.GothamBold,16
    textLabel.TextColor3,textLabel.TextStrokeTransparency,textLabel.Parent=key.Color,0.2,tag
    local controller={}
    function controller.refresh(visible: boolean)
        for _,entry in pieces do
            entry.part.CFrame=key.CFrame*entry.offset
            entry.part.Transparency=if visible then 0 else 1
        end
        light.Enabled,tag.Enabled=visible,visible
    end
    controller.refresh(false)
    return controller
end
return Visual
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_7">
        <Properties>
          <string name="Name">ExteriorCar</string>
          <string name="Source">--!strict
-- Working parked car. The legacy model name is retained for existing scenery references.
local Props=require(script.Parent.PubProps)
local Car={}
function Car.build(parent: Instance): Model
    local model=Instance.new("Model") model.Name="BrokenDownCar"
    local origin=CFrame.new(-62,0,112)*CFrame.Angles(0,math.rad(-8),0)
    local paint=Color3.fromRGB(39,61,75)
    local function part(name: string,size: Vector3,position: Vector3,color: Color3,material: Enum.Material?): Part
        return Props.part(model,name,size,origin*CFrame.new(position),color,material)
    end
    local body=part("CarBody",Vector3.new(13,1.4,5.5),Vector3.new(0,2.1,0),paint,Enum.Material.Metal)
    body.CanCollide,body.CanQuery=true,true
    local cabin=part("CarCabin",Vector3.new(6.3,2.2,5.1),Vector3.new(-1.3,3.85,0),paint,Enum.Material.Metal)
    cabin.CanCollide,cabin.CanQuery=true,true
    part("Roof",Vector3.new(6.6,0.25,5.3),Vector3.new(-1.3,5,0),paint,Enum.Material.Metal)
    for _,side in {-1,1} do
        for _,x in {-2.9,0.3} do
            local glass=part("CarSideWindow",Vector3.new(2.7,1.35,0.06),Vector3.new(x,3.95,side*2.58),Color3.fromRGB(64,83,98),Enum.Material.Glass)
            glass.Transparency,glass.Reflectance=0.2,0.2
            part("DoorHandle",Vector3.new(0.8,0.15,0.12),Vector3.new(x,2.9,side*2.81),Color3.fromRGB(150,156,157),Enum.Material.Metal)
        end
        for _,x in {-4.2,4.2} do
            local wheel=part("Tyre",Vector3.new(0.7,2.4,2.4),Vector3.new(x,1.5,side*2.85),Color3.fromRGB(20,22,26),Enum.Material.Rubber)
            wheel.Shape=Enum.PartType.Cylinder wheel.CFrame*=CFrame.Angles(0,math.pi/2,0)
            wheel.CanCollide,wheel.CanQuery=true,true
            local hub=part("WheelHub",Vector3.new(0.72,1.3,1.3),Vector3.new(x,1.5,side*2.86),Color3.fromRGB(100,107,116),Enum.Material.Metal)
            hub.Shape=Enum.PartType.Cylinder hub.CFrame*=CFrame.Angles(0,math.pi/2,0)
        end
        local headlight=part("Headlight",Vector3.new(0.12,0.55,1.3),Vector3.new(6.56,2.3,side*1.65),Color3.fromRGB(240,223,173),Enum.Material.Glass)
        local light=Instance.new("SpotLight") light.Face,light.Range,light.Brightness,light.Angle=Enum.NormalId.Right,60,2,75
        light.Enabled,light.Color,light.Parent=false,headlight.Color,headlight
        part("RearLamp",Vector3.new(0.12,0.55,1.3),Vector3.new(-6.56,2.3,side*1.65),Color3.fromRGB(94,23,29),Enum.Material.Glass)
        for _,endX in {-6.58,6.58} do
            part("HazardLamp",Vector3.new(0.15,0.45,0.45),Vector3.new(endX,2.3,side*2.3),Color3.fromRGB(239,139,44),Enum.Material.Neon)
        end
    end
    part("Windscreen",Vector3.new(0.06,1.5,4.7),Vector3.new(1.9,3.85,0),Color3.fromRGB(67,88,106),Enum.Material.Glass)
    part("RearGlass",Vector3.new(0.06,1.5,4.7),Vector3.new(-4.5,3.85,0),Color3.fromRGB(51,68,85),Enum.Material.Glass)
    part("EngineBay",Vector3.new(4.3,0.12,4.8),Vector3.new(4.3,2.87,0),Color3.fromRGB(19,21,25),Enum.Material.Metal)
    part("Engine",Vector3.new(2.4,0.5,2.3),Vector3.new(4.2,3.1,0),Color3.fromRGB(78,83,88),Enum.Material.Metal)
    part("ClosedBonnet",Vector3.new(4.3,0.18,5.3),Vector3.new(4.3,3.5,0),paint,Enum.Material.Metal)
    for _,x in {-6.6,6.6} do part("Bumper",Vector3.new(0.3,0.45,5.5),Vector3.new(x,1.7,0),Color3.fromRGB(48,49,52)) end
    local marker=part("CarLocation",Vector3.one,Vector3.new(0,0.8,-5),Color3.new()) marker.Transparency=1
    local door=part("EscapeCar",Vector3.new(1,1.5,0.5),Vector3.new(-1.3,2.8,-4.5),paint)
    door.Transparency,door.CanQuery=1,true
    local prompt=Instance.new("ProximityPrompt") prompt.ActionText,prompt.ObjectText="Get in and drive","Your car"
    prompt.MaxActivationDistance,prompt.HoldDuration,prompt.RequiresLineOfSight,prompt.Enabled=8,0.35,false,false prompt.Parent=door
    local tag=Instance.new("BillboardGui") tag.Name,tag.Adornee,tag.Size="CarGoal",door,UDim2.fromOffset(180,38)
    tag.StudsOffsetWorldSpace,tag.MaxDistance,tag.Enabled,tag.AlwaysOnTop=Vector3.new(0,3,0),100,false,false tag.Parent=door
    local text=Instance.new("TextLabel") text.Size,text.BackgroundTransparency=UDim2.fromScale(1,1),1
    text.Text,text.Font,text.TextSize,text.TextColor3="YOUR CAR",Enum.Font.GothamBold,22,Color3.fromRGB(255,224,170) text.Parent=tag
    model:SetAttribute("HazardsEnabled",false)
    model.PrimaryPart=body model.Parent=parent
    return model
end
return Car
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_8">
        <Properties>
          <string name="Name">ExteriorFinish</string>
          <string name="Source">--!strict
-- Added surface depth on the disposable facade; doors, windows and routes remain clear.
local Props=require(script.Parent.PubProps)
local Finish={}
function Finish.build(map: Folder)
    local decor=Instance.new("Folder") decor.Name="ExteriorFinishes"
    local oak=Color3.fromRGB(47,33,28)
    local stone=Color3.fromRGB(98,95,98)
    local function p(name: string,size: Vector3,position: Vector3,color: Color3,material: Enum.Material?): Part
        return Props.part(decor,name,size,CFrame.new(position),color,material)
    end
    local function beam(a: Vector3,b: Vector3,width: number)
        return Props.part(decor,"CarvedFacadeBrace",Vector3.new(width,width,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),oak)
    end
    -- Individual masonry blocks break up the broad flat plaster at ground level.
    for _,span in {{-8,0},{12,48}} do
        for row=0,1 do
            local x=span[1]
            while x&lt;span[2] do
                local width=math.min(if row==0 then 3 else 2.5,span[2]-x)
                p("WeatheredPlinthStone",Vector3.new(width-.06,.65,.38),Vector3.new(x+width/2,.85+row*.7,88.63),stone,Enum.Material.Cobblestone)
                x+=width
            end
        end
    end
    for _,x in {-7.4,47.4} do
        for row=0,26 do
            p("CornerQuoin",Vector3.new(if row%2==0 then 1.5 else 1.1,.9,.5),Vector3.new(x,2.5+row,88.85),if row%3==0 then Color3.fromRGB(116,110,108) else stone,Enum.Material.Slate)
        end
    end
    -- Diagonal carpentry sits in the plaster bays between the existing windows.
    for _,span in {{16.4,20.5},{29.5,35.5}} do
        beam(Vector3.new(span[1],18,88.95),Vector3.new(span[2],28.5,88.95),.4)
    end
    for _,y in {3.1,14.7,29.2} do
        for _,span in {{-4,8},{30,36}} do p("FacadeStringCourse",Vector3.new(span[2],.18,.45),Vector3.new(span[1],y,88.9),oak) end
    end
    -- Recessed entrance surround and a shallow slate canopy shelter the doorway.
    for _,x in {.2,11.8} do
        p("CarvedDoorPost",Vector3.new(.45,10.7,.8),Vector3.new(x,5.85,89.15),oak)
        p("DoorPostCapital",Vector3.new(.8,.5,1),Vector3.new(x,10.8,89.2),stone,Enum.Material.Slate)
    end
    p("PorchLintel",Vector3.new(13,.5,1),Vector3.new(6,11.2,89.2),oak)
    local canopy=p("SlateEntranceCanopy",Vector3.new(14,.28,3.2),Vector3.new(6,11.65,90),Color3.fromRGB(48,48,60),Enum.Material.Slate)
    canopy.CFrame*=CFrame.Angles(math.rad(8),0,0)
    for _,x in {-.4,12.4} do beam(Vector3.new(x,9.7,89.2),Vector3.new(x,11.2,91.1),.22) end
    -- Stone sills and lintels give the front windows depth without covering the glass.
    for _,row in {{-2,7,5},{25,7,7},{40,7,7},{6,23,6},{25,23,6},{40,23,6}} do
        p("FrontWindowSill",Vector3.new(row[3]+.9,.3,.85),Vector3.new(row[1],row[2]-4.05,89.1),stone,Enum.Material.Slate)
    end
    -- Patched plaster and subtle water marks stay away from signs and glazing.
    for _,x in {17.4,31.6,45.5} do
        p("RainWeathering",Vector3.new(.14,3,.03),Vector3.new(x,7.5,88.54),Color3.fromRGB(74,70,77),Enum.Material.Plaster)
        p("RainWeathering",Vector3.new(.08,1.7,.03),Vector3.new(x+.28,6.7,88.54),Color3.fromRGB(82,77,80),Enum.Material.Plaster)
    end
    -- Low shrubs flank the frontage; the entrance and courtyard are kept open.
    for _,x in {-10,51} do
        p("StonePlantTrough",Vector3.new(3.2,1.2,2),Vector3.new(x,.95,90.8),stone,Enum.Material.Slate)
        for i=1,3 do
            local shrub=p("DryShrub",Vector3.new(.9,1.3,.9),Vector3.new(x-1+i*.5,2,90.8),Color3.fromRGB(60,66,48),Enum.Material.Grass)
            shrub.Shape=Enum.PartType.Ball
        end
    end
    decor.Parent=map
end
return Finish
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_9">
        <Properties>
          <string name="Name">InteriorFinish</string>
          <string name="Source">--!strict
-- Cosmetic finishes only: no collision, ray queries or changes to objective surfaces.
local Props=require(script.Parent.PubProps)
local Finish={}
local oak=Color3.fromRGB(43,29,27)
local brass=Color3.fromRGB(137,104,59)
function Finish.build(map: Folder)
    local decor=Instance.new("Folder") decor.Name="InteriorFinishes"
    local function part(name: string,size: Vector3,cf: CFrame,color: Color3,material: Enum.Material?): Part
        return Props.part(decor,name,size,cf,color,material)
    end
    -- Thin surfaces follow the existing wall segments, including the bedroom doorways.
    -- Outer window walls are deliberately left alone so the storm views remain open.
    for _,wall in map:GetChildren() do
        if wall:IsA("BasePart") and (wall.Name=="BedroomDoorWall" or wall.Name=="BedroomPartition"
            or wall.Name=="RoomFrontWall" or wall.Name=="OfficeSnugPartition" or wall.Name=="LoungeWestWall") then
            local alongX=wall.Size.X&gt;wall.Size.Z
            local length=if alongX then wall.Size.X else wall.Size.Z
            local floor=if wall.Position.Y&gt;16 then 16.5 else 0.5
            for _,side in {-1,1} do
                local cf=wall.CFrame*CFrame.new(if alongX then 0 else side*(wall.Size.X/2+0.04),0,if alongX then side*(wall.Size.Z/2+0.04) else 0)
                local yaw=if alongX then 0 else math.pi/2
                local origin=CFrame.new(cf.Position.X,floor,cf.Position.Z)*CFrame.Angles(0,yaw,0)
                part("OakWainscot",Vector3.new(length,3,0.08),origin*CFrame.new(0,1.5,0),oak)
                for _,y in {0.18,2.95} do part("DadoMoulding",Vector3.new(length,0.16,0.16),origin*CFrame.new(0,y,0),brass,Enum.Material.Metal) end
                local count=math.max(1,math.floor(length/3))
                for i=1,count do
                    part("PanelStile",Vector3.new(0.1,2.5,0.13),origin*CFrame.new(-length/2+(i-.5)*length/count,1.5,0),Color3.fromRGB(71,45,34))
                end
                -- A low-contrast repeat reads as aged wallpaper rather than a glowing sign.
                local paper=part("FadedWallpaper",Vector3.new(length,6.5,0.025),origin*CFrame.new(0,6.3,0),Color3.fromRGB(70,67,65),Enum.Material.Fabric)
                local gui=Instance.new("SurfaceGui") gui.Face=if side==1 then Enum.NormalId.Back else Enum.NormalId.Front
                gui.SizingMode,gui.PixelsPerStud,gui.LightInfluence=Enum.SurfaceGuiSizingMode.PixelsPerStud,32,1 gui.Parent=paper
                for i=1,math.floor(length/2) do
                    local diamond=Instance.new("Frame") diamond.AnchorPoint=Vector2.new(.5,.5)
                    diamond.Position,diamond.Size=UDim2.fromScale((i-.5)/math.floor(length/2),.5),UDim2.fromOffset(13,45)
                    diamond.Rotation,diamond.BorderSizePixel,diamond.BackgroundColor3,diamond.BackgroundTransparency=45,0,Color3.fromRGB(109,94,73),.55
                    diamond.Parent=gui
                end
            end
        end
    end
    local function rug(cf: CFrame,width: number,length: number,color: Color3)
        part("WornRugBorder",Vector3.new(width,.025,length),cf,Color3.fromRGB(104,78,49),Enum.Material.Fabric)
        part("WornRugField",Vector3.new(width-.4,.028,length-.4),cf*CFrame.new(0,.018,0),color,Enum.Material.Fabric)
        for _,z in {-length/2+.6,length/2-.6} do
            part("RugWovenBand",Vector3.new(width-.7,.03,.12),cf*CFrame.new(0,.035,z),Color3.fromRGB(151,114,75),Enum.Material.Fabric)
        end
        for _,z in {-length*.25,0,length*.25} do
            part("RugDiamond",Vector3.new(.65,.03,.65),cf*CFrame.new(0,.04,z)*CFrame.Angles(0,math.pi/4,0),Color3.fromRGB(132,97,65),Enum.Material.Fabric)
        end
    end
    rug(CFrame.new(6,.55,66),8,25,Color3.fromRGB(74,34,42))
    rug(CFrame.new(-8,.55,23),7,17,Color3.fromRGB(61,58,48))
    local colours={Color3.fromRGB(66,58,52),Color3.fromRGB(52,65,62),Color3.fromRGB(68,49,59),Color3.fromRGB(55,58,76)}
    for sideIndex,side in {-1,1} do
        for i,z in {-30,-10,10,30} do
            local number=(sideIndex-1)*4+i
            rug(CFrame.new(side*31,16.55,z+2),5,10,colours[i])
            -- Small room-specific finish on the existing headboard; no new furniture volume.
            part("UpholsteredHeadboard",Vector3.new(4.2,1.5,.08),CFrame.new(side*40,19.3,z-.28),colours[i],Enum.Material.Fabric)
            part("BedroomCeilingBeam",Vector3.new(38,.28,.35),CFrame.new(side*28,29.7,z),oak)
            -- Brass cap over the doorway, kept above head height and clear of the number.
            part("DoorHeaderMoulding",Vector3.new(.18,.2,12),CFrame.new(side*7.4,27,z),brass,Enum.Material.Metal)
        end
    end
    for _,z in {48,64,80} do
        part("LoungeCeilingTie",Vector3.new(55,.4,.5),CFrame.new(20,29.6,z),oak)
    end
    -- Frame existing signs in place, retaining their text, dimensions and orientation.
    for _,object in map:GetDescendants() do
        if object:IsA("BasePart") and (object.Name=="GuestSign" or object.Name=="PubName" or object.Name=="SnugLabel" or object.Name=="HallLabel") then
            local size=object.Size
            for _,y in {-1,1} do part("SignFrame",Vector3.new(size.X+.3,.13,size.Z+.12),object.CFrame*CFrame.new(0,y*(size.Y/2+.08),0),brass,Enum.Material.Metal) end
            for _,x in {-1,1} do part("SignFrame",Vector3.new(.13,size.Y+.3,size.Z+.12),object.CFrame*CFrame.new(x*(size.X/2+.08),0,0),oak) end
        end
    end
    decor.Parent=map
end
return Finish
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_10">
        <Properties>
          <string name="Name">Journey</string>
          <string name="Source">--!strict
-- Server-owned entrance collapse and car escape. All scenery/driver state resets together.
local TweenService=game:GetService("TweenService")
local Config=require(game.ReplicatedStorage:WaitForChild("HalloweenShared"):WaitForChild("Config"))
local Journey={}
Journey.Intro="HALLOWEEN DARE: get the lights on in the abandoned Firefly Tavern. Your working car is parked here."
function Journey.new(map: Folder,clock: (() -&gt; number)?)
    local time=clock or os.clock
    local decor=map.JourneyDressing
    local front=map.FrontDoor :: BasePart
    local beam=decor.FallingEntranceBeam :: BasePart
    local blocker=map.FrontEntranceBlocker :: BasePart
    local car=map.Exterior.BrokenDownCar :: Model
    local parked=car:GetPivot()
    local offset=front.Position-Vector3.new(6,5.5,88)
    local beamHome,doorHome,exitHome=beam.CFrame,front.CFrame,map.ExitDoor.CFrame
    local opened,collapsed=false,false
    local entryUntil,driveAt=0,0
    local driving=false
    local entryAt=0
    local tween: Tween?=nil
    local driver: BasePart?=nil
    local restoreDriver: (() -&gt; ())?=nil
    local wheels: {[BasePart]: CFrame}={}
    for _,p in car:GetChildren() do
        if p:IsA("BasePart") and (p.Name=="Tyre" or p.Name=="WheelHub") then wheels[p]=parked:ToObjectSpace(p.CFrame) end
    end
    local crash=Instance.new("Sound") crash.Name,crash.SoundId="EntranceCrash","rbxasset://sounds/impact_explosion_03.mp3"
    crash.Volume,crash.PlaybackSpeed,crash.RollOffMaxDistance,crash.Parent=0.65,0.75,120,beam
    local doorSound=Instance.new("Sound") doorSound.Name,doorSound.SoundId="ExitClatter","rbxasset://sounds/impact_explosion_03.mp3"
    doorSound.Volume,doorSound.PlaybackSpeed,doorSound.RollOffMaxDistance,doorSound.Parent=0.3,1.1,90,map.ExitDoor
    local engine=Instance.new("Sound") engine.Name,engine.SoundId="CarEngine","rbxasset://sounds/action_swim.mp3"
    engine.Volume,engine.PlaybackSpeed,engine.Looped,engine.RollOffMaxDistance,engine.Parent=0.12,0.45,true,65,car.PrimaryPart
    local function lights(enabled: boolean)
        for _,p in car:GetChildren() do
            if p:IsA("BasePart") and (p.Name=="Headlight" or p.Name=="RearLamp") then
                p.Material=if enabled then Enum.Material.Neon else Enum.Material.Glass
                local light=p:FindFirstChildOfClass("SpotLight") if light then light.Enabled=enabled end
            end
        end
    end
    local controller={}
    function controller.entryActive(): boolean return time()&lt;entryUntil end
    function controller.driveStarted(): number return driveAt end
    function controller.openEntrance()
        if opened or collapsed then return end
        opened=true
        front.CFrame=CFrame.new(offset+Vector3.new(1.5,5.5,88))*CFrame.Angles(0,-math.pi/2,0)*CFrame.new(4.5,0,0)
    end
    function controller.crossed(position: Vector3): boolean
        position-=offset
        return opened and not collapsed and position.X&gt;0 and position.X&lt;12 and position.Y&gt;0 and position.Y&lt;11
            and position.Z&lt;85.5 and position.Z&gt;80
    end
    function controller.collapse()
        if collapsed then return end
        collapsed=true entryAt=time() entryUntil=entryAt+Config.EntrySceneSeconds
        map:SetAttribute("EntranceCollapseStarted",workspace:GetServerTimeNow())
        blocker.CanCollide=true map:SetAttribute("EntranceCollapsed",true)
        crash:Play()
        tween=TweenService:Create(beam,TweenInfo.new(0.75,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{CFrame=CFrame.new(offset+Vector3.new(6,4.2,88))*CFrame.Angles(0,0,0.2)})
        tween:Play()
        for _,p in decor:GetChildren() do if p:IsA("BasePart") and p.Name=="EntranceDebris" then p.Transparency=0 end end
    end
    function controller.phase(stage: number)
        local entry=map.FrontEntrance :: BasePart
        entry.Position=offset+(if collapsed then Vector3.new(6,5,85) else Vector3.new(6,5,90))
        local prompt=entry:FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
        prompt.Enabled=(stage==0 and not opened) or (collapsed and stage&lt;6)
        prompt.ActionText,prompt.ObjectText=if collapsed then "Inspect wreckage" else "Open front door",if collapsed then "Front entrance — blocked" else "The Firefly Tavern"
        local escape=car.EscapeCar
        escape.ProximityPrompt.Enabled=stage==5
        escape.CarGoal.Enabled=stage==5
        for _,label in map.EntranceLabel:GetDescendants() do if label:IsA("TextLabel") then label.Text=if collapsed then "FRONT ENTRANCE — BLOCKED" else "FRONT ENTRANCE" end end
    end
    function controller.openExit()
        map.ExitDoor.CanCollide=false map.ExitDoor.Transparency=0.8
        doorSound:Play()
    end
    function controller.beginDrive(character: Model,root: BasePart,humanoid: Humanoid)
        if driving then return end
        driving=true driveAt=time()
        local original,anchored=root.CFrame,root.Anchored
        local speed,jumpPower,jumpHeight,rotate,sit=humanoid.WalkSpeed,humanoid.JumpPower,humanoid.JumpHeight,humanoid.AutoRotate,humanoid.Sit
        local collisions: {[BasePart]: boolean}={}
        for _,p in character:GetDescendants() do if p:IsA("BasePart") then collisions[p]=p.CanCollide p.CanCollide=false end end
        root.Anchored=true root.AssemblyLinearVelocity,root.AssemblyAngularVelocity=Vector3.zero,Vector3.zero
        humanoid.WalkSpeed,humanoid.JumpPower,humanoid.JumpHeight,humanoid.AutoRotate,humanoid.Sit=0,0,0,false,true
        driver=root lights(true) engine:Play()
        restoreDriver=function()
            for p,value in collisions do if p.Parent then p.CanCollide=value end end
            if root.Parent then root.CFrame=original root.Anchored=anchored root.AssemblyLinearVelocity,root.AssemblyAngularVelocity=Vector3.zero,Vector3.zero
                if not anchored then pcall(function() root:SetNetworkOwnershipAuto() end) end end
            if humanoid.Parent then humanoid.WalkSpeed,humanoid.JumpPower,humanoid.JumpHeight,humanoid.AutoRotate,humanoid.Sit=speed,jumpPower,jumpHeight,rotate,sit end
        end
    end
    function controller.finishDrive() if driving then driveAt=time()-Config.DriveSeconds end end
    function controller.stepDrive(): boolean
        if not driving then return false end
        local elapsed=math.max(0,time()-driveAt)
        local junction=CFrame.new(-40+offset.X,parked.Y,132+offset.Z)
        local cf
        if elapsed&lt;1.3 then
            local t=elapsed/1.3 cf=parked:Lerp(junction,t*t*(3-2*t))
        else cf=junction:Lerp(CFrame.new(190+offset.X,parked.Y,132+offset.Z),math.clamp((elapsed-1.3)/(Config.DriveSeconds-1.3),0,1)) end
        car:PivotTo(cf)
        for wheel,bind in wheels do wheel.CFrame=cf*bind*CFrame.Angles(elapsed*22,0,0) end
        if driver and driver.Parent then driver.CFrame=cf*CFrame.new(-1,0.4,0) end
        return elapsed&gt;=Config.DriveSeconds
    end
    function controller.reset()
        if restoreDriver then restoreDriver() restoreDriver=nil end
        driver=nil driving=false driveAt=0 entryUntil=0 opened=false collapsed=false
        if tween then tween:Cancel() tween=nil end
        crash:Stop() doorSound:Stop() engine:Stop()
        front.CFrame,beam.CFrame,blocker.CanCollide=doorHome,beamHome,false
        map.ExitDoor.CFrame=exitHome map.ExitDoor.CanCollide,map.ExitDoor.Transparency=true,0
        map:SetAttribute("EntranceCollapsed",false)
        car:PivotTo(parked)
        for wheel,bind in wheels do wheel.CFrame=parked*bind end
        lights(false)
        for _,p in decor:GetChildren() do if p:IsA("BasePart") and p.Name=="EntranceDebris" then p.Transparency=1 end end
        controller.phase(0)
    end
    controller.reset()
    return controller
end
return Journey
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_11">
        <Properties>
          <string name="Name">JourneyMap</string>
          <string name="Source">--!strict
-- Runtime arrival opening and two-corner courtyard. Authored Studio geometry is untouched.
local Props=require(script.Parent.PubProps)
local Map={}
Map.ExitNoise=Vector3.new(-36,0.5,44)
function Map.build(map: Folder)
    local wood=Color3.fromRGB(53,35,28)
    local decor=Instance.new("Folder") decor.Name,decor.Parent="JourneyDressing",map
    local function solid(name: string,size: Vector3,position: Vector3): Part
        local p=Instance.new("Part") p.Name,p.Size,p.Position=name,size,position
        p.Anchored,p.Color,p.Material=true,wood,Enum.Material.WoodPlanks
        p:SetAttribute("BlocksNavigation",true) p.Parent=map return p
    end
    local function sign(name: string,text: string,position: Vector3,width: number,height: number): Part
        local board=Props.part(decor,name,Vector3.new(width,height,0.15),CFrame.new(position),Color3.fromRGB(32,25,28))
        for _,face in {Enum.NormalId.Front,Enum.NormalId.Back} do
            local gui=Instance.new("SurfaceGui") gui.Face,gui.LightInfluence,gui.PixelsPerStud=face,0,50
            gui.SizingMode,gui.Parent=Enum.SurfaceGuiSizingMode.PixelsPerStud,board
            local label=Instance.new("TextLabel") label.Size,label.BackgroundTransparency=UDim2.fromScale(1,1),1
            label.Font,label.TextScaled,label.TextColor3,label.Text=Enum.Font.GothamBold,true,Color3.fromRGB(255,224,170),text label.Parent=gui
        end
        return board
    end
    local wall=map:FindFirstChild("LoungeSouthWall") :: BasePart
    wall:Destroy()
    for _,span in {{-4,8},{30,36}} do
        local p=solid("LoungeSouthWall",Vector3.new(span[2],30,1),Vector3.new(span[1],15,88))
        p.Material,p.Color=Enum.Material.Plaster,Color3.fromRGB(107,100,110)
    end
    solid("FrontDoorLintel",Vector3.new(12,19,1),Vector3.new(6,20.5,88))
    local old=map:FindFirstChild("JammedEntrance") if old then old:Destroy() end
    local facade=map.Exterior.PubFrontage
    local oldDoor=facade:FindFirstChild("ExteriorFrontDoor") if oldDoor then oldDoor:Destroy() end
    solid("FrontDoor",Vector3.new(9,10,0.5),Vector3.new(6,5.5,88))
    local blocker=solid("FrontEntranceBlocker",Vector3.new(12,11,1),Vector3.new(6,5.5,88))
    blocker.CanCollide,blocker.Transparency=false,1
    local entry=Instance.new("Part") entry.Name,entry.Size,entry.Position="FrontEntrance",Vector3.one,Vector3.new(6,5,90)
    entry.Anchored,entry.Transparency,entry.CanCollide,entry.Parent=true,1,false,map
    local prompt=Instance.new("ProximityPrompt") prompt.ActionText,prompt.ObjectText="Enter pub","The Firefly Tavern"
    prompt.MaxActivationDistance,prompt.RequiresLineOfSight,prompt.Parent=9,false,entry
    local beam=Props.part(decor,"FallingEntranceBeam",Vector3.new(14,2.8,2.8),CFrame.new(6,13.5,88),wood)
    for i=1,6 do
        local p=Props.part(decor,"EntranceDebris",Vector3.new(2.5,2.2,1.8),CFrame.new(1+i*1.5,1.3,87.8+(i%2)*0.6)*CFrame.Angles(0,i*0.4,i*0.1),Color3.fromRGB(112,102,99),Enum.Material.Plaster)
        p.Transparency=1
    end
    for _,object in {map:FindFirstChild("EntranceLabel"),map:FindFirstChild("OutsideSign"),facade:FindFirstChild("RoomsAvailable"),facade.HangingPubSign} do
        if object then for _,label in object:GetDescendants() do
            if label:IsA("TextLabel") then label.Text=if object.Name=="EntranceLabel" then "FRONT ENTRANCE" else "THE FIREFLY TAVERN\nCLOSED" end
        end end
    end
    local spawn=map.PrototypeSpawn :: SpawnLocation
    spawn.CFrame=CFrame.lookAt(Vector3.new(-59,0.8,102),Vector3.new(6,0.8,88))
    spawn.CanCollide,spawn.CanQuery=false,false
    -- Eight-stud privacy walls prevent jumping over the two route turns.
    for _,row in {{"YardWestWall",Vector3.new(1,8,56),Vector3.new(-51,4.3,68)},
        {"YardEastWall",Vector3.new(1,8,56),Vector3.new(-21,4.3,68)},
        {"YardFirstWall",Vector3.new(20,8,1),Vector3.new(-41,4.3,72)},
        {"YardSecondWall",Vector3.new(20,8,1),Vector3.new(-31,4.3,90)}} do
        local p=solid(row[1] :: string,row[2] :: Vector3,row[3] :: Vector3)
        p.Material,p.Color=Enum.Material.Brick,Color3.fromRGB(63,58,66)
    end
    for _,position in {Vector3.new(-23,6,72),Vector3.new(-49,6,90),Vector3.new(-47,6,99)} do
        local bulb=Props.part(decor,"YardLantern",Vector3.new(0.6,1,0.6),CFrame.new(position),Color3.fromRGB(255,192,98),Enum.Material.Neon)
        local light=Instance.new("PointLight") light.Color,light.Brightness,light.Range,light.Parent=bulb.Color,1.5,22,bulb
    end
    sign("YardEscapeSign","CAR PARK\nFOLLOW THE LIGHTS",Vector3.new(-41,6,71.4),12,2.5)
    sign("YardEscapeSign","CAR PARK",Vector3.new(-31,6,89.4),10,2)
end
function Map.addRoutes(positions: {Vector3},edges: {{number}})
    local previous=17
    for i,point in {Vector3.new(-36,4.5,48),Vector3.new(-36,4.5,61),Vector3.new(-26,4.5,64),
        Vector3.new(-26,4.5,80),Vector3.new(-46,4.5,80),Vector3.new(-46,4.5,101),Vector3.new(-62,4.5,106)} do
        table.insert(positions,point)
        table.insert(edges,{previous,#positions,if i==1 then 1 else 0})
        previous=#positions
    end
end
return Map
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_12">
        <Properties>
          <string name="Name">KeyPlacement</string>
          <string name="Source">--!strict
-- One server choice per new run; power restoration never rerolls the location.
local KeyPlacement = {}
function KeyPlacement.new(map: Folder, key: BasePart)
    local locations: {BasePart} = {}
    for _, object in map:WaitForChild("KeyLocations"):GetChildren() do
        if object:IsA("BasePart") then table.insert(locations, object) end
    end
    table.sort(locations, function(a, b) return a.Name &lt; b.Name end)
    assert(#locations == 9, "Expected office plus eight bedroom key locations")
    local random = Random.new()
    local placement = {}
    function placement.choose(index: number?): string
        local chosen = locations[index or random:NextInteger(1, #locations)]
        assert(chosen, "Invalid key location")
        key.CFrame = chosen.CFrame
        key:SetAttribute("KeyRoom",chosen.Name)
        return chosen.Name
    end
    return placement
end
return KeyPlacement
</string>
        </Properties>
      </Item>
      <Item class="Script" referent="RBXAssetIntegration0_13">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source">--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("HalloweenShared"):WaitForChild("Config"))
local RunState = require(script.Parent.RunState)
-- Only the separate prototype project enables this runtime greybox.
if workspace:GetAttribute("LastOrdersGreybox") ~= true then
    print("Last Orders code ready; greybox disabled in authored place")
    return
end
-- The scaffold baseplate otherwise seals the cellar opening when code is synced.
-- This changes only the temporary Play datamodel; Stop restores the authored part.
local starterPlate = workspace:FindFirstChild("Baseplate")
if starterPlate and starterPlate:IsA("Part") and starterPlate.Anchored
    and starterPlate.Size == Vector3.new(128, 1, 128)
    and starterPlate.Position == Vector3.new(0, -0.5, 0) then
    starterPlate.CanCollide, starterPlate.CanQuery, starterPlate.Transparency = false, false, 1
end
require(script.Parent.PubAtmosphere).apply()
local map = require(script.Parent.PrototypeMap).build()
local monster = map:WaitForChild("ChuggernaughtPlaceholder") :: Part
local key = map:WaitForChild("OfficeKey") :: Part
local keyPrompt = key:FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
local keyPlacement = require(script.Parent.KeyPlacement).new(map, key)
local keyVisual = require(script.Parent.ExitKeyVisual).new(key)
local power = require(script.Parent.CellarPower).new(map)
local journey = require(script.Parent.Journey).new(map)
local replay = Instance.new("RemoteEvent")
replay.Name, replay.Parent = "RestartJourney", game.ReplicatedStorage.HalloweenShared
local home = monster.CFrame
local navigation = require(script.Parent.MonsterNavigation).new(monster)
local encounter = require(script.Parent.MonsterEncounter).new(monster)
local senses = require(script.Parent.MonsterSenses).new(monster)
local grab = require(script.Parent.MonsterGrab).new()
local survival = require(script.Parent.PlayerSurvival).new()
local hold = require(script.Parent.PlayerHold).new(monster)
local hunt = require(script.Parent.MonsterHunt).new({
    Vector3.new(36, 0.5, 23), Vector3.new(-8, 0.5, 23),
    Vector3.new(-29, 0.5, -29), Vector3.new(9, 0.5, -29),
    Vector3.new(0, 16.5, -30), Vector3.new(0, 16.5, 30),
    Vector3.new(28, 0.5, 84), Vector3.new(-36, 0.5, 23),
}, nil, navigation.searchTargets)
local exitDoor = map:WaitForChild("ExitDoor") :: Part
local spawn = map:WaitForChild("PrototypeSpawn") :: SpawnLocation
local bell = map:WaitForChild("Bell") :: Part
local bellSound=Instance.new("Sound") bellSound.Name,bellSound.SoundId="BellRing","rbxasset://sounds/volume_slider.ogg"
bellSound.Volume,bellSound.PlaybackSpeed,bellSound.RollOffMinDistance,bellSound.RollOffMaxDistance=.65,1.35,10,90
bellSound.Parent=bell
local lastBell=-math.huge
local lights: {PointLight} = {}
for _, object in map:GetDescendants() do
    if object:IsA("PointLight") and object.Name == "PowerLight" then
        table.insert(lights, object)
    end
end
local state = RunState.new()
local activePlayer: Player? = nil
local graceUntil = 0
local SceneHistory=require(script.Parent.SceneHistory)
local Director=require(script.Parent.SceneDirector)
local scenes: any=nil
local noteSerial=0
local sceneRequest=Instance.new("RemoteEvent") sceneRequest.Name,sceneRequest.Parent="SceneRequest",game.ReplicatedStorage.HalloweenShared
sceneRequest.OnServerEvent:Connect(function(player,action,name)
    if player~=activePlayer or not scenes or typeof(action)~="string" or typeof(name)~="string" then return end
    scenes.request(action,name)
end)
local function showNote(text: string)
    if not activePlayer then return end
    noteSerial+=1
    activePlayer:SetAttribute("LastOrdersNoteText",text)
    activePlayer:SetAttribute("LastOrdersNoteSerial",noteSerial)
end
local function updateVitals()
    local player=activePlayer
    if not player then return end
    player:SetAttribute("LastOrdersArrivalScene",scenes~=nil and scenes.active("Arrival"))
    player:SetAttribute("LastOrdersRevealScene",scenes~=nil and scenes.active("Awakening"))
    player:SetAttribute("LastOrdersDriving",state.stage&gt;=6)
    player:SetAttribute("LastOrdersEntryScene",journey.entryActive())
    player:SetAttribute("LastOrdersDriveStarted",journey.driveStarted())
    player:SetAttribute("LastOrdersHealth",survival.health())
    player:SetAttribute("LastOrdersMaxHealth",Config.PlayerMaxHealth)
    player:SetAttribute("LastOrdersHeld",survival.locked())
    player:SetAttribute("LastOrdersGameOver",survival.phase()=="GameOver")
    player:SetAttribute("LastOrdersProtected",survival.protected())
end
local function update(message: string?)
    updateVitals()
    journey.phase(state.stage)
    power.available(state.stage == 2)
    key.Transparency = if state.stage == 3 then 0 else 1
    keyPrompt.Enabled = state.stage == 3
    key.CanQuery = state.stage == 3
    keyVisual.refresh(state.stage == 3)
    for _, light in lights do
        light.Brightness = if state.stage &gt;= 3 then 2 else 0.35
    end
    exitDoor.CanCollide = state.stage &lt; 5
    exitDoor.Transparency = if state.stage &gt;= 5 then 0.8 else 0
    local player = activePlayer
    if player then
        player:SetAttribute("LastOrdersStage", state.stage)
        player:SetAttribute("LastOrdersMessage", message or "")
        player:SetAttribute("HasExitKey", state.stage &gt;= 4)
        player:SetAttribute("CellarBreakerProgress", map.CellarPowerPanel:GetAttribute("BreakerProgress"))
    end
end
local function reset(message: string?)
    if scenes then scenes.cancel() end
    hold.release()
    survival.reset()
    journey.reset()
    state = RunState.new()
    power.reset()
    require(script.Parent.AssetDressing).reroll(map)
    graceUntil = os.clock() + 3
    keyPlacement.choose()
    navigation.reset()
    encounter.reset()
    hunt.reset()
    grab.reset()
    bell:SetAttribute("ReadyAt", 0)
    bellSound:Stop() lastBell=-math.huge
    monster.CFrame = home
    monster:SetAttribute("MonsterBehaviour", "Dormant")
    update(message)
    navigation.refresh()
end
replay.OnServerEvent:Connect(function(player)
    if player~=activePlayer or state.stage~=7 then return end
    reset(require(script.Parent.Journey).Intro)
    if player.Character then player.Character:PivotTo(spawn.CFrame+Vector3.new(0,4,0)) end
    if scenes then scenes.start("Arrival",Config.ArrivalSceneSeconds) updateVitals() end
end)
local function join(player: Player)
    if activePlayer then
        player:Kick("This is a solo game. Please join another server for your own run.")
        return
    end
    activePlayer = player
    scenes=nil
    local flags=SceneHistory.load(player.UserId)
    if activePlayer~=player or player.Parent~=Players then return end
    scenes=Director.new(player,flags,function(name,skipped)
        if name=="Awakening" then encounter.finishReveal() graceUntil=os.clock()+.8
        elseif name=="Escape" and skipped then journey.finishDrive() end
    end,function(seen) SceneHistory.save(player.UserId,seen) end)
    player.RespawnLocation = spawn
    local handledCharacter: Model?=nil
    local function characterAdded(character: Model)
        if handledCharacter==character then return end
        handledCharacter=character
        player.RespawnLocation = spawn
        reset(require(script.Parent.Journey).Intro)
        local humanoid=character:WaitForChild("Humanoid",10)
        if humanoid and humanoid:IsA("Humanoid") then humanoid.Died:Connect(function()
            if character==player.Character and scenes then scenes.cancel() updateVitals() end
        end) end
        local root=character:WaitForChild("HumanoidRootPart",10)
        if root and character==player.Character then
            character:PivotTo(spawn.CFrame+Vector3.new(0,3,0))
            scenes.start("Arrival",Config.ArrivalSceneSeconds)
            updateVitals()
        end
    end
    player.CharacterAdded:Connect(characterAdded)
    reset(require(script.Parent.Journey).Intro)
    if player.Character then task.spawn(characterAdded,player.Character) end
end
Players.PlayerAdded:Connect(join)
Players.PlayerRemoving:Connect(function(player)
    if activePlayer == player then
        activePlayer = nil
        reset()
    end
end)
for _, player in Players:GetPlayers() do join(player) end
local stations = { FrontEntrance = 0, EscapeCar = 5, Warning = 1, CellarFuseBox = 2, CellarBreakerCellar = 2, CellarBreakerGuest = 2,
    CellarBreakerBar = 2, OfficeKey = 3, Bell = 0, EmergencyExit = 4 }
for name, expected in stations do
    local station = map:FindFirstChild(name,true) :: Part
    local prompt = station:FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
    prompt.Triggered:Connect(function(player: Player)
        local character = player.Character
        local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
        local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
        if player ~= activePlayer or not character or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health &lt;= 0 then return end
        if not scenes or survival.locked() or journey.entryActive() or (scenes and scenes.active()) or state.stage&gt;=6 then return end
        if (root.Position - station.Position).Magnitude &gt; Config.InteractionDistance then return end
        local sight = RaycastParams.new()
        sight.FilterType = Enum.RaycastFilterType.Exclude
        sight.FilterDescendantsInstances = {character, monster}
        -- A waist-height ray hits counters even when the player can see the prompt.
        local head = character:FindFirstChild("Head")
        local eye = if head and head:IsA("BasePart") then head.Position else root.Position + Vector3.new(0, 2, 0)
        local obstruction = workspace:Raycast(eye, station.Position - eye, sight)
        if obstruction and obstruction.Instance ~= station then
            update("Move into view of the item to interact.")
            return
        end
        if name == "FrontEntrance" then
            if state.stage==0 then journey.openEntrance() update("The door is open. Step inside to begin the dare.")
            else update("The fallen beam blocks the entrance. Find the emergency exit key.") end
            return
        end
        if name == "Warning" and state.stage &gt; 1 then
            showNote(Config.StaffNote)
            update(Config.StaffNote)
            return
        end
        if string.sub(name, 1, 13) == "CellarBreaker" then
            if state.stage ~= 2 then update("Read the staff note before restoring power.") return end
            local _, message = power.use(name)
            update(message)
            return
        end
        if name == "Bell" then
            if os.clock()-lastBell&lt;.25 then return end
            lastBell=os.clock() bellSound:Play()
            if state.stage&lt;3 then update("The bell rings through the empty tavern.") return end
            if not hunt.ringBell(Vector3.new(-20, 0.5, 23)) then
                update("The bell rang. He will not fall for another distraction for " .. math.ceil(hunt.bellCooldown()) .. "s.")
                return
            end
            bell:SetAttribute("ReadyAt", workspace:GetServerTimeNow() + Config.BellCooldownSeconds)
            local visible = senses.sample(character, root, hunt.alert())
            update(if visible then "He can see you! The bell won't fool him. Break his sight and run!"
                else "The bell rang. Move away before he investigates!")
            return
        end
        if state.stage ~= expected then
            update("Follow the current objective first.")
            return
        end
        if name == "CellarFuseBox" then
            local completed, message = power.use(name)
            if not completed then update(message) return end
        end
        RunState.advance(state, expected)
        if expected==5 then
            survival.finish() encounter.stop() journey.beginDrive(character,root,humanoid)
            scenes.start("Escape",Config.DriveSeconds)
            update("You made it to the car. Get out of here!") return
        elseif expected==4 then
            journey.openExit() navigation.refresh()
            hunt.alarm(Vector3.new(-36,0.5,44)) encounter.rally()
            update("The exit is open! Follow the courtyard lights to your car!") return
        end
        if expected == 2 then
            local look = root.Position - monster.Position
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude &gt; 0.01 then monster.CFrame = CFrame.lookAt(monster.Position, monster.Position + flat.Unit) end
            encounter.wake()
            scenes.start("Awakening",Config.MonsterRevealSeconds)
            graceUntil = os.clock() + Config.MonsterRevealSeconds
            update("POWER RESTORED! He's waking beyond the barrel rack. Get to the stairs!")
        elseif expected == 3 then
            update("You have the exit key. Get to the emergency exit!")
        elseif expected == 1 then
            showNote(Config.StaffNote)
            update(Config.StaffNote)
        else
            update()
        end
    end)
end
RunService.Heartbeat:Connect(function(dt: number)
    local player = activePlayer
    if not player then return end
    if scenes then scenes.step() end
    updateVitals()
    if state.stage==7 then return end
    local character = player.Character
    local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
    local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
    if not character or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health &lt;= 0 then return end
    if state.stage&lt;6 and not survival.locked() and (root.Position.Y&lt; -45 or math.abs(root.Position.X)&gt;216 or math.abs(root.Position.Z)&gt;176) then
        character:PivotTo(if state.stage==0 then spawn.CFrame+Vector3.new(0,3,0) else CFrame.new(6,4,82))
        root.AssemblyLinearVelocity,root.AssemblyAngularVelocity=Vector3.zero,Vector3.zero
        graceUntil=os.clock()+3
        update("Back on safe ground. Your progress is preserved.")
        return
    end
    if state.stage==0 then
        updateVitals()
        if (scenes and scenes.active()) then return end
        if journey.crossed(root.Position) then
            RunState.advance(state,0) journey.collapse() navigation.refresh()
            update("The entrance beam has fallen! Find another way out. Read the staff note at the bar.")
        end
        return
    elseif state.stage==6 then
        if journey.stepDrive() then RunState.advance(state,6) update("You survived Last Orders. The dare is over.") end
        return
    elseif state.stage&lt;3 then updateVitals() return end
    if scenes and scenes.active("Awakening") then return end
    hold.step()
    local event=survival.step()
    if event=="Restart" then
        reset("Caught twice! Try again with two fresh health segments.")
        character:PivotTo(spawn.CFrame+Vector3.new(0,4,0))
        return
    elseif event=="Release" then
        hold.release()
        grab.reset()
        update("One hit left! He's recovering. Get away and break his sight!")
    end
    updateVitals()
    local phase=survival.phase()
    if phase=="Held" or phase=="Recovery" or phase=="GameOver" then
        encounter.step(if phase=="Held" then "Hold" elseif phase=="Recovery" then "Stunned" else "Defeat")
        return
    end
    if not encounter.active() then
        local _, message = encounter.step("Patrol")
        if message then update(message) end
        if not encounter.active() then return end
    end
    local visible, inReach, contact = senses.sample(character, root, hunt.alert())
    local feet = monster.Position - Vector3.new(0, 4, 0)
    if not visible and senses.footsteps(character, root) then
        if hunt.hearFootstep(root.Position - Vector3.new(0, 2.5, 0)) then
            update("He heard your footsteps. Break his sight and keep still to lose him.")
        end
    end
    local target, behaviour, looking = hunt.step(feet, root.Position - Vector3.new(0, 2.5, 0), visible)
    monster:SetAttribute("MonsterBehaviour", behaviour)
    local vulnerable=not survival.protected() and os.clock()&gt;graceUntil
    local action = grab.step(inReach and vulnerable, contact and vulnerable)
    if action == "Caught" then
        if survival.hit() then
            hold.begin(character,root,humanoid,survival.health()==0)
            grab.reset()
            encounter.step("Hold")
            update(if survival.health()&gt;0 then "He caught you! One hit left — get ready to run."
                else "He caught you again!")
        end
        return
    end
    local canMove, message = encounter.step(if action == "Ready" then behaviour else action)
    if message then update(message) end
    if not canMove then return end
    if os.clock() &lt; graceUntil then return end
    if looking then
        -- Searching turns his real sight cone; the client follows this authoritative facing.
        monster.CFrame *= CFrame.Angles(0, math.min(dt, 0.1) * 1.8, 0)
        return
    end
    local speed = if behaviour == "Chase" then Config.ChaseSpeed
        elseif behaviour == "Investigate" then Config.InvestigateSpeed
        elseif behaviour == "Search" then Config.SearchSpeed else Config.MonsterSpeed
    navigation.step(target, if state.stage==5 then Config.FinaleSpeed else encounter.speed(speed), dt)
end)
print("Last Orders prototype ready")
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_14">
        <Properties>
          <string name="Name">MonsterEncounter</string>
          <string name="Source">--!strict
-- Authoritative reveal, drinking pauses and bounded threat progression.
local Config=require(game.ReplicatedStorage:WaitForChild("HalloweenShared"):WaitForChild("Config"))
local Encounter={}
function Encounter.new(root: BasePart, clock: (() -&gt; number)?)
    local time = clock or os.clock
    local mode="Dormant"
    local finale=false
    local endsAt,nextDrink,drinks=0,math.huge,0
    local function setMode(value: string)
        if mode==value and root:GetAttribute("MonsterMode")==value then return end
        mode=value
        root:SetAttribute("MonsterMode",value)
        root:SetAttribute("MonsterModeStarted",workspace:GetServerTimeNow())
    end
    local controller={}
    function controller.reset()
        finale=false
        drinks,endsAt,nextDrink=0,0,math.huge
        root:SetAttribute("DrinkCount",0)
        setMode("Dormant")
    end
    function controller.wake()
        setMode("Reveal") endsAt=time()+Config.MonsterRevealSeconds
    end
    function controller.rally()
        finale=true nextDrink=math.huge
        if mode=="Chug" then setMode("Search") end
    end
    function controller.finishReveal()
        if mode=="Reveal" then nextDrink=time()+Config.MonsterDrinkInterval setMode("Patrol") end
    end
    function controller.stop() setMode("Stopped") end
    function controller.active(): boolean
        return mode~="Dormant" and mode~="Reveal" and mode~="Stopped"
    end
    function controller.speed(base: number): number
        return base+math.min(drinks,Config.MonsterMaxDrinkBoosts)*Config.MonsterDrinkSpeedBoost
    end
    function controller.step(activity: string): (boolean,string?)
        local now=time()
        if mode=="Dormant" or mode=="Stopped" then return false,nil end
        if mode=="Reveal" then
            if now&lt;endsAt then return false,nil end
            nextDrink=now+Config.MonsterDrinkInterval
            setMode(activity) return true,"LAST ORDERS! Break his sight, then keep quiet."
        end
        -- Grabbing or investigating interrupts a drink without granting a boost.
        if activity=="Grab" or activity=="Recover" or activity=="Hold" or activity=="Stunned" or activity=="Defeat" then
            if mode=="Chug" then nextDrink=now+Config.MonsterDrinkInterval end
            setMode(activity) return false,nil
        end
        if activity=="Investigate" and mode~="Investigate" then
            nextDrink=now+Config.MonsterDrinkInterval
            setMode(activity) return true,nil
        end
        if mode=="Chug" then
            if now&lt;endsAt then return false,nil end
            local previous=drinks
            drinks=math.min(drinks+1,Config.MonsterMaxDrinkBoosts)
            root:SetAttribute("DrinkCount",drinks)
            nextDrink=now+Config.MonsterDrinkInterval
            setMode(activity)
            return true,if drinks&gt;previous then "The Chuggernaught is getting faster." else "He finished his drink. Keep moving."
        end
        if not finale and now&gt;=nextDrink then
            endsAt=now+Config.MonsterChugSeconds setMode("Chug") return false,nil
        end
        setMode(activity)
        return true,nil
    end
    controller.reset()
    return controller
end
return Encounter
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_15">
        <Properties>
          <string name="Name">MonsterGrab</string>
          <string name="Source">--!strict
-- A visible windup followed by a fresh reach check lets the player dodge a grab.
local Config = require(game.ReplicatedStorage:WaitForChild("HalloweenShared"):WaitForChild("Config"))
local Grab = {}
function Grab.new(clock: (() -&gt; number)?)
    local time = clock or os.clock
    local mode, endsAt = "Ready", 0
    local contact = false
    local controller = {}
    function controller.reset() mode, endsAt, contact = "Ready", 0, false end
    function controller.step(inReach: boolean, touching: boolean?): string
        local now = time()
        -- Running through his body commits the grab; dodging around him still works.
        if mode == "Grab" and touching then contact = true end
        if mode == "Grab" and now &gt;= endsAt then
            mode, endsAt = "Recover", now + Config.GrabRecoverySeconds
            if inReach or contact then return "Caught" end
        end
        if mode == "Recover" and now &gt;= endsAt then mode = "Ready" end
        if mode == "Ready" and inReach then
            mode, endsAt = "Grab", now + Config.GrabWindupSeconds
            contact = touching == true
        end
        return mode
    end
    return controller
end
return Grab
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_16">
        <Properties>
          <string name="Name">MonsterHunt</string>
          <string name="Source">--!strict
-- Sight, remembered movement and audible footsteps drive the hunt, never hidden live positions.
local Config = require(game.ReplicatedStorage:WaitForChild("HalloweenShared"):WaitForChild("Config"))
local Hunt = {}
type Planner = (Vector3, Vector3) -&gt; {Vector3}
function Hunt.new(patrol: {Vector3}, clock: (() -&gt; number)?, plan: Planner?)
    assert(#patrol &gt; 0, "A hunt needs patrol destinations")
    local time = clock or os.clock
    local index = 1
    local lastKnown: Vector3? = nil
    local lastSight: Vector3? = nil
    local sightAt, chaseUntil, alertUntil = -math.huge, 0, 0
    local direction = Vector3.zero
    local checks: {Vector3} = {}
    local checkIndex, lookUntil, nextFootstep = 1, 0, 0
    local planned = false
    local noise: Vector3? = nil
    local noiseUntil, bellReady = 0, 0
    local mode = "Patrol"
    local controller = {}
    function controller.reset()
        index, lastKnown, lastSight, noise, mode = 1, nil, nil, nil, "Patrol"
        sightAt, chaseUntil, alertUntil = -math.huge, 0, 0
        direction, checks, checkIndex, lookUntil, nextFootstep = Vector3.zero, {}, 1, 0, 0
        planned, noiseUntil, bellReady = false, 0, 0
    end
    function controller.alert(): boolean
        return time() &lt; alertUntil
    end
    function controller.ringBell(position: Vector3): boolean
        local now = time()
        if now &lt; bellReady then return false end
        bellReady, noiseUntil = now + Config.BellCooldownSeconds, now + Config.DistractionSeconds
        noise, alertUntil = position, math.max(alertUntil, noiseUntil)
        return true
    end
    function controller.alarm(position: Vector3)
        lastKnown,noise,planned=position,nil,false
        direction=Vector3.new(0,0,1)
        chaseUntil,alertUntil=time()+Config.SightMemorySeconds,time()+40
    end
    function controller.bellCooldown(): number
        return math.max(0, bellReady - time())
    end
    function controller.hearFootstep(position: Vector3): boolean
        local now = time()
        if now &lt; nextFootstep then return false end
        nextFootstep = now + Config.FootstepInterval
        lastKnown, noise, planned = position, nil, false
        chaseUntil = 0
        alertUntil = math.max(alertUntil, now + Config.FootstepMemorySeconds)
        return true
    end
    function controller.step(position: Vector3, playerPosition: Vector3, visible: boolean): (Vector3, string, boolean)
        local now = time()
        if visible then
            local previous = lastSight
            local elapsed = now - sightAt
            -- Replicated positions arrive in bursts; sample across several heartbeats.
            if previous and elapsed &gt;= 0.1-0.00001 and elapsed &lt; 0.5 then
                local movement = playerPosition - previous
                if movement.Magnitude &gt; 0.05 and movement.Magnitude / elapsed &lt; 30 then direction = movement.Unit end
                lastSight, sightAt = playerPosition, now
            elseif not previous or elapsed &gt;= 0.5 then
                direction, lastSight, sightAt = Vector3.zero, playerPosition, now
            end
            lastKnown = playerPosition
            noise, planned = nil, false
            chaseUntil, alertUntil = now + Config.SightMemorySeconds, now + Config.SearchSeconds
            mode = "Chase"
            return playerPosition, mode, false
        end
        local heard = noise
        if heard and now &lt; noiseUntil then
            lastKnown, planned, mode = nil, false, "Investigate"
            return heard, mode, (position - heard).Magnitude &lt; 3
        end
        noise = nil
        local remembered = lastKnown
        if remembered and now &lt; alertUntil then
            if now &lt; chaseUntil then
                mode = "Chase"
                return remembered, mode, false
            end
            mode = "Search"
            if not planned then
                checks, checkIndex, lookUntil = {remembered}, 1, 0
                if plan then
                    for _,point in plan(remembered, direction) do
                        if (point - remembered).Magnitude &gt; 4 then table.insert(checks, point) end
                    end
                end
                planned = true
            end
            while checkIndex &lt;= #checks and (position - checks[checkIndex]).Magnitude &lt; 3 do
                -- Keep moving through the last sighting; inspect subsequent exits briefly.
                if checkIndex &gt; 1 then
                    if lookUntil == 0 then lookUntil = now + Config.SearchLookSeconds end
                    if now &lt; lookUntil then return checks[checkIndex], mode, true end
                end
                checkIndex += 1
                lookUntil = 0
            end
            local target = checks[checkIndex]
            return target or checks[#checks], mode, target == nil
        end
        lastKnown, lastSight, planned = nil, nil, false
        -- Resume locally after a thorough search rather than walking back to the cellar.
        if mode ~= "Patrol" then
            local nearest = math.huge
            for i, destination in patrol do
                local distance = (destination - position).Magnitude
                if distance &lt; nearest then index, nearest = i, distance end
            end
        end
        mode = "Patrol"
        if (position - patrol[index]).Magnitude &lt; 3 then index = index % #patrol + 1 end
        return patrol[index], mode, false
    end
    return controller
end
return Hunt
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_17">
        <Properties>
          <string name="Name">MonsterNavigation</string>
          <string name="Source">--!strict
-- Fixed walking routes for this compact greybox. No movement through blocked edges.
local Navigation = {}
local Cellar = require(script.Parent.CellarMap)
local positions = {
    Vector3.new(-8, 4.5, 23), -- 1 main bar
    Vector3.new(-36, 4.5, 23), -- 2 west bar
    Vector3.new(36, 4.5, 23), -- 3 east bar
    Vector3.new(-8, 4.5, 3), -- 4 hall entrance
    Vector3.new(-8, 4.5, -18), -- 5 hall middle
    Vector3.new(-8, 4.5, -29), -- 6 hall north
    Vector3.new(-23, 4.5, -29), -- 7 office entrance
    Vector3.new(-29, 4.5, -29), -- 8 office desk approach
    Vector3.new(-23, 4.5, -5), -- 9 snug entrance
    Vector3.new(-26, 4.5, -5), -- 10 snug
    Vector3.new(9, 4.5, -29), -- 11 kitchen north
    Vector3.new(9, 4.5, -4), -- 12 kitchen south
    Vector3.new(36, 4.5, 10), -- 13 stair entrance
    Vector3.new(36, 4.5, 7), -- 14 first step
    Vector3.new(36, -11.5, -27), -- 15 cellar landing
    Cellar.MonsterHome, -- 16 cellar reveal
    Vector3.new(-36, 4.5, 34), -- 17 exit
    Vector3.new(-8, 4.5, -5), -- 18 hall opposite snug
    Vector3.new(18, 4.5, 3), -- 19 kitchen doorway
    Vector3.new(18, 4.5, 14), -- 20 outside kitchen
}
local edges = {{1, 2}, {1, 3}, {1, 4}, {2, 17}, {4, 5}, {5, 6}, {6, 7}, {7, 8}, {5, 18}, {4, 18}, {18, 9}, {9, 10}, {6, 11}, {11, 12}, {12, 19}, {19, 20}, {20, 3}, {20, 1}, {3, 13}, {13, 14}}
-- Follow every stair tread; a straight top-to-bottom shortcut would cross the floor.
local previous = 14
for step = 1, 15 do
    table.insert(positions, Vector3.new(36, 4.5 - step, 7 - step * 2))
    local current = #positions
    table.insert(edges, {previous, current})
    previous = current
end
table.insert(edges, {previous, 15})
require(script.Parent.PubExpansion).addRoutes(positions, edges)
Cellar.addRoutes(positions, edges)
require(script.Parent.JourneyMap).addRoutes(positions,edges)
function Navigation.new(monster: BasePart)
    local map = monster.Parent :: Folder
    local offset = monster.Position - Cellar.MonsterHome
    local nodes: {Vector3} = {}
    local neighbours: {{number}} = {}
    for i, position in positions do
        nodes[i], neighbours[i] = position + offset, {}
    end
    local blockers: {Instance} = {}
    local floors: {Instance} = {}
    for _, object in map:GetChildren() do
        if object:IsA("BasePart") and (object:GetAttribute("BlocksNavigation") == true or string.find(object.Name, "Wall") or string.find(object.Name, "Partition")
            or object.Name == "Bar" or object.Name == "OfficeDesk" or object.Name == "SnugTable"
            or object.Name == "KitchenCounter" or object.Name == "PubTable" or object.Name == "ExitDoor") then
            table.insert(blockers, object)
        elseif object:IsA("BasePart") and object.CanCollide and (string.find(object.Name, "Floor") or string.find(object.Name, "Step")) then
            table.insert(floors, object)
        end
    end
    local cast = RaycastParams.new()
    cast.FilterType, cast.FilterDescendantsInstances, cast.RespectCanCollide = Enum.RaycastFilterType.Include, blockers, true
    local floorCast = RaycastParams.new()
    floorCast.FilterType, floorCast.FilterDescendantsInstances = Enum.RaycastFilterType.Include, floors
    local function clear(a: Vector3, b: Vector3): boolean
        local delta = b - a
        if delta.Magnitude &lt; 0.01 then return true end
        if workspace:Blockcast(CFrame.new(a), Vector3.new(4.2, 7.8, 4.2), delta, cast) then return false end
        -- Check upper-body clearance too, so routes cannot shortcut through floors or stairs.
        -- The lower two studs allow normal one-stud step climbing.
        return workspace:Blockcast(CFrame.new(a + Vector3.new(0,1,0)), Vector3.new(4.2,5.6,4.2), delta, floorCast) == nil
    end
    local function refreshEdges()
        for _,list in neighbours do table.clear(list) end
        for _,edge in edges do
            if clear(nodes[edge[1]],nodes[edge[2]]) then
                table.insert(neighbours[edge[1]],edge[2])
                table.insert(neighbours[edge[2]],edge[1])
            end
        end
    end
    refreshEdges()
    local searchStops: {[number]: boolean} = {}
    for i,position in positions do
        -- Inspect rooms and landings, rather than stopping halfway up a flight of stairs.
        searchStops[i] = position.Y==4.5 or position.Y==20.5 or position.Y==-11.5
    end
    local graph = require(script.Parent.MonsterRoutes).new(nodes, neighbours, searchStops)
    local function nearest(position: Vector3): number?
        local best: number? = nil
        local distance = math.huge
        for i, node in nodes do
            local length = (node - position).Magnitude
            if length &lt; distance and math.abs(node.Y - position.Y) &lt; 3 and clear(position, node) then
                best, distance = i, length
            end
        end
        return best
    end
    local route: {Vector3} = {}
    local nextPlan = 0
    local lastTarget: Vector3? = nil
    local controller = {}
    function controller.validate()
        for _,edge in edges do
            if edge[3]==1 and map.ExitDoor.CanCollide then continue end
            assert(table.find(neighbours[edge[1]],edge[2]), "Blocked pub route: "..tostring(nodes[edge[1]]).." -&gt; "..tostring(nodes[edge[2]]))
        end
    end
    function controller.reset()
        route, nextPlan, lastTarget = {}, 0, nil
    end
    function controller.refresh()
        refreshEdges() controller.reset()
    end
    function controller.searchTargets(position: Vector3, direction: Vector3): {Vector3}
        local first=nearest(position+Vector3.new(0,4,0))
        local result: {Vector3}={}
        if first then
            for _,node in graph.search(first,direction) do
                table.insert(result,nodes[node]-Vector3.new(0,4,0))
            end
        end
        return result
    end
    function controller.step(target: Vector3, speed: number, dt: number)
        local destination = target + Vector3.new(0, 4, 0)
        -- In clear space, pursue directly instead of returning to a graph node behind him.
        if math.abs(destination.Y-monster.Position.Y)&lt;0.75 and clear(monster.Position,destination) then
            local delta=destination-monster.Position
            if delta.Magnitude&gt;0.02 then
                local movement=delta.Unit*math.min(delta.Magnitude,speed*math.min(dt,0.1))
                local position=monster.Position+movement
                local flat=Vector3.new(movement.X,0,movement.Z)
                monster.CFrame=if flat.Magnitude&gt;0.001 then CFrame.lookAt(position,position+flat.Unit) else CFrame.new(position)*monster.CFrame.Rotation
            end
            route,nextPlan,lastTarget={},0,nil
            return
        end
        local previousTarget = lastTarget
        if os.clock() &gt;= nextPlan and (not previousTarget or (target - previousTarget).Magnitude &gt; 3 or #route == 0) then
            lastTarget = target
            nextPlan = os.clock() + 0.75
            route = {}
            local first, last = nearest(monster.Position), nearest(destination)
            if first and last then
                local path=graph.path(first,last)
                if #path&gt;0 then
                    for _,node in path do table.insert(route,nodes[node]) end
                    -- Only take a final approach if it has room for the full placeholder.
                    if clear(nodes[last], destination) then table.insert(route, destination) end
                end
            end
        end
        local waypoint = route[1]
        if not waypoint then return end
        -- Continue along an existing edge after replanning, but never cut room corners.
        local following = route[2]
        if following then
            local edge = following - waypoint
            if edge.Magnitude &gt; 0.01 then
                local progress = (monster.Position - waypoint):Dot(edge) / edge:Dot(edge)
                if progress &gt;= 0 and progress &lt;= 1
                    and (waypoint + edge * progress - monster.Position).Magnitude &lt; 0.05 then
                    table.remove(route, 1)
                    waypoint = route[1]
                end
            end
        end
        local delta = waypoint - monster.Position
        if delta.Magnitude &lt; 0.02 then table.remove(route, 1) return end
        local movement = delta.Unit * math.min(delta.Magnitude, speed * math.min(dt, 0.1))
        if clear(monster.Position, monster.Position + movement) then
            local position = monster.Position + movement
            local flat = Vector3.new(movement.X, 0, movement.Z)
            monster.CFrame = if flat.Magnitude &gt; 0.001 then CFrame.lookAt(position, position + flat.Unit) else CFrame.new(position) * monster.CFrame.Rotation
        end
    end
    return controller
end
return Navigation
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_18">
        <Properties>
          <string name="Name">MonsterRoutes</string>
          <string name="Source">--!strict
-- Distance-weighted routes and local search branches, using only the pub's known layout.
local Routes = {}
function Routes.new(nodes: {Vector3}, neighbours: {{number}}, stops: {[number]: boolean}?)
    local function distances(first: number)
        local costs: {[number]: number} = {[first] = 0}
        local parents: {[number]: number} = {[first] = 0}
        local closed: {[number]: boolean} = {}
        for _=1,#nodes do
            local current: number? = nil
            local best = math.huge
            for node,cost in costs do
                if not closed[node] and cost&lt;best then current,best=node,cost end
            end
            if not current then break end
            closed[current]=true
            for _,other in neighbours[current] do
                local cost=best+(nodes[other]-nodes[current]).Magnitude
                if cost&lt;(costs[other] or math.huge) then costs[other],parents[other]=cost,current end
            end
        end
        return costs,parents
    end
    local controller = {}
    function controller.path(first: number, last: number): {number}
        local _,parents=distances(first)
        local result: {number}={}
        if parents[last]==nil then return result end
        local current=last
        while current~=0 do table.insert(result,1,current) current=parents[current] end
        return result
    end
    function controller.search(first: number, direction: Vector3): {number}
        local costs,parents=distances(first)
        local flat=Vector3.new(direction.X,0,direction.Z)
        local heading=if flat.Magnitude&gt;0.1 then flat.Unit else Vector3.zero
        local branches: {[number]: {node: number, score: number}}={}
        for node,cost in costs do
            if cost&gt;=6 and cost&lt;=48 and (not stops or stops[node]) then
                local branch=node
                while parents[branch] and parents[branch]~=first and parents[branch]~=0 do branch=parents[branch] end
                local delta=nodes[node]-nodes[first]
                local horizontal=Vector3.new(delta.X,0,delta.Z)
                local alignment=if horizontal.Magnitude&gt;0.1 then heading:Dot(horizontal.Unit) else 0
                local feature=if #neighbours[node]==1 then 5 elseif #neighbours[node]&gt;=3 then 3 else 0
                local score=alignment*18+math.min(cost,24)*0.3-math.max(0,cost-24)*0.4+feature
                local previous=branches[branch]
                if not previous or score&gt;previous.score then branches[branch]={node=node,score=score} end
            end
        end
        local ranked: {{node: number, score: number}}={}
        for _,candidate in branches do table.insert(ranked,candidate) end
        table.sort(ranked,function(a,b) return if a.score==b.score then a.node&lt;b.node else a.score&gt;b.score end)
        local result: {number}={}
        for i=1,math.min(3,#ranked) do table.insert(result,ranked[i].node) end
        return result
    end
    return controller
end
return Routes
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_19">
        <Properties>
          <string name="Name">MonsterSenses</string>
          <string name="Source">--!strict
-- Server sight and reach share actual map occlusion; presentation never grants immunity.
local Config = require(game.ReplicatedStorage:WaitForChild("HalloweenShared"):WaitForChild("Config"))
local Senses = {}
function Senses.new(monster: BasePart)
    local cast = RaycastParams.new()
    cast.FilterType = Enum.RaycastFilterType.Exclude
    cast.RespectCanCollide = true
    local controller = {}
    function controller.sample(character: Model, playerRoot: BasePart, alert: boolean?): (boolean, boolean, boolean)
        cast.FilterDescendantsInstances = {monster, character}
        local head = character:FindFirstChild("Head")
        local eye = monster.Position + Vector3.new(0, 2.2, 0)
        local target = if head and head:IsA("BasePart") then head.Position else playerRoot.Position + Vector3.new(0, 1.5, 0)
        local delta = target - eye
        local flat = Vector3.new(delta.X, 0, delta.Z)
        local distance = flat.Magnitude
        local facing = if distance &gt; 0.01 then monster.CFrame.LookVector:Dot(flat.Unit) else 1
        local unobstructed = workspace:Raycast(eye, delta, cast) == nil
        local peripheral = if alert then Config.AlertPeripheralDistance else Config.SightPeripheralDistance
        local cone = if alert then Config.AlertSightConeCosine else Config.SightConeCosine
        local visible = unobstructed and delta.Magnitude &lt;= Config.SightDistance
            and (distance &lt;= peripheral or facing &gt;= cone)
        local sameLevel = math.abs(playerRoot.Position.Y - monster.Position.Y) &lt; 4
        local contact = unobstructed and sameLevel and distance &lt;= Config.MonsterContactDistance
        local reachable = contact or (unobstructed and sameLevel and distance &lt;= Config.CatchDistance and facing &gt;= 0)
        return visible, reachable, contact
    end
    function controller.footsteps(character: Model, playerRoot: BasePart): boolean
        local velocity=playerRoot.AssemblyLinearVelocity
        if Vector3.new(velocity.X,0,velocity.Z).Magnitude&lt;Config.FootstepSpeed then return false end
        local delta=playerRoot.Position-monster.Position
        if math.abs(delta.Y)&gt;4 or delta.Magnitude&gt;Config.FootstepDistance then return false end
        cast.FilterDescendantsInstances={monster,character}
        -- Airborne movement and different floors cannot create a ground-level sound trail.
        if not workspace:Raycast(playerRoot.Position,Vector3.new(0,-4.5,0),cast) then return false end
        local blocked=workspace:Raycast(monster.Position,delta,cast)~=nil
        return not blocked or delta.Magnitude&lt;=Config.FootstepOccludedDistance
    end
    return controller
end
return Senses
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_20">
        <Properties>
          <string name="Name">PlayerHold</string>
          <string name="Source">--!strict
-- Authoritative reach/lift/lower path; release restores the original safe position.
local Config=require(game.ReplicatedStorage:WaitForChild("HalloweenShared"):WaitForChild("Config"))
local Hold={}
local function smooth(value: number): number
    local t=math.clamp(value,0,1)
    return t*t*(3-2*t)
end
function Hold.new(monster: BasePart, clock: (() -&gt; number)?)
    local time=clock or os.clock
    local release: (() -&gt; ())?=nil
    local animate: (() -&gt; ())?=nil
    local controller={}
    function controller.step()
        if animate then animate() end
    end
    function controller.release()
        local restore=release
        release,animate=nil,nil
        if restore then restore() end
        monster:SetAttribute("HeldChestPosition",nil)
    end
    function controller.begin(character: Model,root: BasePart,humanoid: Humanoid,fatal: boolean?)
        controller.release()
        local original,anchored=root.CFrame,root.Anchored
        local speed,jumpPower,jumpHeight,rotate=humanoid.WalkSpeed,humanoid.JumpPower,humanoid.JumpHeight,humanoid.AutoRotate
        local collisions: {[BasePart]: boolean}={}
        local ray=RaycastParams.new() ray.FilterType=Enum.RaycastFilterType.Exclude
        ray.FilterDescendantsInstances,ray.RespectCanCollide={character,monster},true
        local overlap=OverlapParams.new() overlap.FilterType=Enum.RaycastFilterType.Exclude
        overlap.FilterDescendantsInstances,overlap.RespectCanCollide={character,monster},true
        local basis=CFrame.new(monster.Position-Vector3.new(0,4,0))*monster.CFrame.Rotation
        local function target(height: number): CFrame
            local position=basis:PointToWorldSpace(Vector3.new(-1.7,height,-2.1))
            return CFrame.lookAt(position,Vector3.new(monster.Position.X,position.Y,monster.Position.Z))
        end
        local low,raised=target(3.7),target(4.6)
        local size=Vector3.new(3,5.4,2.5)
        local function clear(a: CFrame,b: CFrame): boolean
            local delta=b.Position-a.Position
            return #workspace:GetPartBoundsInBox(b,size,overlap)==0
                and (delta.Magnitude&lt;0.01 or workspace:Blockcast(a,size,delta,ray)==nil)
        end
        -- Validate every leg of the motion, including overhead clearance for the lift.
        if not clear(original,low) or not clear(low,raised) then low,raised=original,original end
        for _,part in character:GetDescendants() do
            if part:IsA("BasePart") then collisions[part]=part.CanCollide part.CanCollide=false end
        end
        root.Anchored=true
        root.AssemblyLinearVelocity,root.AssemblyAngularVelocity=Vector3.zero,Vector3.zero
        humanoid.WalkSpeed,humanoid.JumpPower,humanoid.JumpHeight,humanoid.AutoRotate=0,0,0,false
        humanoid.Jump=false
        local started=time()
        animate=function()
            if not root.Parent then return end
            local elapsed=time()-started
            if elapsed&lt;0.24 then root.CFrame=original:Lerp(low,smooth(elapsed/0.24))
            elseif elapsed&lt;0.55 then root.CFrame=low:Lerp(raised,smooth((elapsed-0.24)/0.31))
            elseif fatal or elapsed&lt;Config.PlayerHoldSeconds-0.4 then root.CFrame=raised
            else root.CFrame=raised:Lerp(original,smooth((elapsed-Config.PlayerHoldSeconds+0.4)/0.4)) end
            monster:SetAttribute("HeldChestPosition",root.Position+Vector3.new(0,0.8,0))
        end
        controller.step()
        release=function()
            for part,collidable in collisions do if part.Parent then part.CanCollide=collidable end end
            if root.Parent then
                root.CFrame=original
                root.AssemblyLinearVelocity,root.AssemblyAngularVelocity=Vector3.zero,Vector3.zero
                root.Anchored=anchored
                if not anchored then pcall(function() root:SetNetworkOwnershipAuto() end) end
            end
            if humanoid.Parent then
                humanoid.WalkSpeed,humanoid.JumpPower,humanoid.JumpHeight,humanoid.AutoRotate=speed,jumpPower,jumpHeight,rotate
            end
        end
    end
    return controller
end
return Hold
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_21">
        <Properties>
          <string name="Name">PlayerSurvival</string>
          <string name="Source">--!strict
-- Run health is separate from Humanoid health so a fatal hit can finish its holding scene.
local Config=require(game.ReplicatedStorage:WaitForChild("HalloweenShared"):WaitForChild("Config"))
local Survival={}
function Survival.new(clock: (() -&gt; number)?)
    local time=clock or os.clock
    local health,phase,endsAt,protectedUntil=Config.PlayerMaxHealth,"Ready",0,0
    local controller={}
    function controller.reset()
        health,phase,endsAt,protectedUntil=Config.PlayerMaxHealth,"Ready",0,0
    end
    function controller.health(): number return health end
    function controller.phase(): string return phase end
    function controller.protected(): boolean return time()&lt;protectedUntil end
    function controller.locked(): boolean return phase=="Held" or phase=="GameOver" end
    function controller.hit(): boolean
        if phase~="Ready" or health&lt;=0 or time()&lt;protectedUntil then return false end
        health-=1
        phase,endsAt="Held",time()+Config.PlayerHoldSeconds
        return true
    end
    function controller.step(): string?
        local now=time()
        if now&lt;endsAt then return nil end
        if phase=="Held" then
            if health==0 then
                phase,endsAt="GameOver",now+Config.GameOverSeconds
                return "GameOver"
            end
            phase,endsAt="Recovery",now+Config.MonsterHitRecoverySeconds
            protectedUntil=now+Config.PlayerHitProtectionSeconds
            return "Release"
        elseif phase=="Recovery" then
            phase="Ready"
        elseif phase=="GameOver" then
            -- Deliver the restart event once; reset owns the next run.
            phase="Finished"
            return "Restart"
        end
        return nil
    end
    function controller.finish()
        phase,endsAt,protectedUntil="Ready",0,0
    end
    return controller
end
return Survival
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_22">
        <Properties>
          <string name="Name">PrototypeMap</string>
          <string name="Source">--!strict
-- Disposable greybox only; never replaces the Studio-authored place.
local Map = {}
function Map.build(): Folder
    local folder = Instance.new("Folder")
    folder.Name = "LastOrdersPrototype"
    local wood = Color3.fromRGB(83, 57, 40)
    local plaster = Color3.fromRGB(153, 139, 115)
    local stone = Color3.fromRGB(77, 80, 86)
    local function part(name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material?): Part
        local p = Instance.new("Part")
        p.Name, p.Size, p.Position, p.Color = name, size, position, color
        p.Material = material or Enum.Material.WoodPlanks
        p.Anchored = true
        p.Parent = folder
        return p
    end
    local function sign(name: string, text: string, position: Vector3, width: number): Part
        local board = part(name, Vector3.new(width, 3, 0.3), position, Color3.fromRGB(28, 22, 18))
        board.CanCollide, board.CanQuery = false, false
        for _, face in {Enum.NormalId.Front, Enum.NormalId.Back} do
            local surface = Instance.new("SurfaceGui")
            surface.Face = face
            surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
            surface.PixelsPerStud = 60
            surface.LightInfluence, surface.Brightness = 0, 2
            surface.Parent = board
            local label = Instance.new("TextLabel")
            label.Size = UDim2.fromScale(0.94, 0.88)
            label.Position = UDim2.fromScale(0.03, 0.06)
            label.BackgroundTransparency = 1
            label.TextColor3 = Color3.fromRGB(255, 241, 204)
            label.TextScaled, label.TextWrapped = true, true
            label.Font = Enum.Font.GothamBold
            label.Text = text
            label.Parent = surface
        end
        return board
    end
    local function station(name: string, position: Vector3, text: string, color: Color3): Part
        local p = part(name, Vector3.new(1.5, 1, 1.5), position, color, Enum.Material.Metal)
        p.CanCollide = false
        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText, prompt.ObjectText = text, name
        prompt.MaxActivationDistance, prompt.RequiresLineOfSight = 10, true
        prompt.Parent = p
        if name == "OfficeKey" then
            p.Transparency, prompt.Enabled = 1, false
        end
        return p
    end
    -- Ground level, with a real opening for the cellar stairs in the east wing.
    part("MainFloor", Vector3.new(72, 1, 80), Vector3.new(-12, 0, 0), wood)
    part("EastFrontFloor", Vector3.new(24, 1, 32), Vector3.new(36, 0, 24), wood)
    part("EastBackFloor", Vector3.new(24, 1, 16), Vector3.new(36, 0, -32), wood)
    part("NorthWall", Vector3.new(97, 14, 1), Vector3.new(0, 7, -40), plaster)
    part("WestWall", Vector3.new(1, 14, 80), Vector3.new(-48, 7, 0), plaster)
    part("EastWall", Vector3.new(1, 14, 80), Vector3.new(48, 7, 0), plaster)
    -- Emergency doorway, twelve studs wide. Front entrance remains visibly jammed.
    part("SouthLeft", Vector3.new(6, 14, 1), Vector3.new(-45, 7, 40), plaster)
    part("SouthRight", Vector3.new(78, 14, 1), Vector3.new(9, 7, 40), plaster)
    part("ExitLintel", Vector3.new(12, 3, 1), Vector3.new(-36, 12.5, 40), wood)
    part("ExitDoor", Vector3.new(12, 11, 1), Vector3.new(-36, 6, 40), Color3.fromRGB(53, 91, 66))
    part("JammedEntrance", Vector3.new(9, 10, 0.5), Vector3.new(6, 5.5, 39.3), wood)
    sign("EntranceLabel", "FRONT DOOR — JAMMED", Vector3.new(6, 11.5, 38.8), 13)
    sign("ExitLabel", "EMERGENCY EXIT", Vector3.new(-36, 12.5, 39.3), 12)
    -- Northern rooms open onto a central hall; all openings are at least ten studs wide.
    for _, x in {-16, 0} do
        part("HallWallNorth", Vector3.new(1, 14, 6), Vector3.new(x, 7, -37), plaster)
        part("HallWallMiddle", Vector3.new(1, 14, 12), Vector3.new(x, 7, -18), plaster)
        part("HallWallSouth", Vector3.new(1, 14, 6), Vector3.new(x, 7, 5), plaster)
    end
    part("OfficeSnugPartition", Vector3.new(32, 14, 1), Vector3.new(-32, 7, -16), plaster)
    part("KitchenStairWall", Vector3.new(1, 14, 48), Vector3.new(24, 7, -16), plaster)
    for _, segment in {{-40, 16}, {-18, 4}, {6, 12}, {46, 4}} do
        part("RoomFrontWall", Vector3.new(segment[2], 14, 1), Vector3.new(segment[1], 7, 8), plaster)
    end
    sign("HallLabel", "OFFICE  /  KITCHEN", Vector3.new(-8, 10, -38.9), 14).Orientation = Vector3.new(0, 180, 0)
    sign("SnugLabel", "THE SNUG", Vector3.new(-34, 10, -15.2), 12).Orientation = Vector3.new(0, 180, 0)
    require(script.Parent.CellarMap).build(folder)
    -- Low furniture leaves a generous route through each room.
    part("Bar", Vector3.new(18, 4, 4), Vector3.new(-27, 2.5, 17), wood)
    part("OfficeDesk", Vector3.new(10, 3, 5), Vector3.new(-37, 2, -33), wood)
    part("SnugTable", Vector3.new(8, 3, 6), Vector3.new(-36, 2, -3), wood)
    part("KitchenCounter", Vector3.new(6, 3, 20), Vector3.new(19, 2, -25), stone)
    for _, x in {-17, 25} do
        part("PubTable", Vector3.new(7, 3, 6), Vector3.new(x, 2, 29), wood)
    end
    sign("PubName", "THE FIREFLY TAVERN", Vector3.new(-22, 11, 9), 23).Orientation = Vector3.new(0, 180, 0)
    -- Put the note on the customer-facing side, clear of the counter and bar top.
    local warning = station("Warning", Vector3.new(-27, 3.2, 19.4), "Read staff note", Color3.fromRGB(230, 215, 170))
    warning.Size, warning.Material = Vector3.new(5, 1.8, 0.12), Enum.Material.SmoothPlastic
    local warningPrompt = warning:FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
    warningPrompt.ObjectText = "Staff note"
    -- Server distance and eye-level wall checks still apply; camera occlusion must not hide this prompt.
    warningPrompt.RequiresLineOfSight = false
    local paper = Instance.new("SurfaceGui")
    paper.Face, paper.SizingMode = Enum.NormalId.Back, Enum.SurfaceGuiSizingMode.PixelsPerStud
    paper.PixelsPerStud, paper.LightInfluence = 80, 0
    paper.Parent = warning
    local writing = Instance.new("TextLabel")
    writing.Size, writing.Position = UDim2.fromScale(0.92, 0.86), UDim2.fromScale(0.04, 0.07)
    writing.BackgroundTransparency = 1
    writing.TextColor3 = Color3.fromRGB(35, 22, 24)
    writing.Font, writing.TextScaled = Enum.Font.GothamBold, true
    writing.Text = "EMERGENCY EXIT LOCKED\nRESTORE LIGHTS · FIND THE KEY"
    writing.Parent = paper
    station("Bell", Vector3.new(-20, 5, 17), "Ring bell", Color3.fromRGB(210, 160, 65))
    local key = station("OfficeKey", Vector3.new(-37, 4, -33), "Take exit key", Color3.fromRGB(240, 195, 65))
    key.Size = Vector3.new(1.5, 0.3, 0.7)
    local keyPrompt = key:FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
    keyPrompt.ObjectText = "Emergency exit key"
    station("EmergencyExit", Vector3.new(-36, 5, 38), "Unlock and escape", Color3.fromRGB(65, 160, 90))
    -- Lamps stay dim before power so the route remains readable.
    for _, position in {Vector3.new(-24, 11, 22), Vector3.new(-35, 11, -28), Vector3.new(-35, 11, -5), Vector3.new(-8, 11, -20), Vector3.new(12, 11, -20), Vector3.new(36, 11, 10), Vector3.new(40, -3, -32)} do
        local lamp = part("PubLamp", Vector3.new(1.5, 0.5, 1.5), position, Color3.fromRGB(255, 184, 90), Enum.Material.Neon)
        lamp.CanCollide = false
        local light = Instance.new("PointLight")
        light.Name = "PowerLight"
        light.Color, light.Range, light.Brightness = lamp.Color, 32, 0.35
        light.Shadows = true
        light.Parent = lamp
    end
    part("EscapePath", Vector3.new(16, 1, 32), Vector3.new(-36, 0, 56), stone)
    sign("OutsideSign", "THE FIREFLY TAVERN — ROOMS AVAILABLE", Vector3.new(6, 12, 41), 24).Orientation = Vector3.new(0, 180, 0)
    local spawn = Instance.new("SpawnLocation")
    spawn.Name, spawn.Size, spawn.Position = "PrototypeSpawn", Vector3.new(6, 1, 6), Vector3.new(6, 1, 30)
    spawn.Anchored, spawn.Neutral, spawn.Transparency = true, true, 1
    spawn.Parent = folder
    require(script.Parent.PubExpansion).build(folder)
    require(script.Parent.PubDressing).build(folder)
    folder.Parent = workspace
    require(script.Parent.PubExterior).build(folder)
    require(script.Parent.ExteriorFinish).build(folder)
    require(script.Parent.JourneyMap).build(folder)
    require(script.Parent.TavernArchitecture).build(folder)
    require(script.Parent.AssetDressing).build(folder)
    require(script.Parent.InteriorFinish).build(folder)
    require(script.Parent.TavernSigns).build(folder)
    require(script.Parent.PubBoundary).build(folder)
    return folder
end
return Map
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_23">
        <Properties>
          <string name="Name">PubAtmosphere</string>
          <string name="Source">--!strict
-- Applied only in the temporary greybox Play datamodel; Stop restores Studio lighting.
local Atmosphere = {}
function Atmosphere.apply()
    local lighting = game:GetService("Lighting")
    lighting.ClockTime, lighting.Brightness = 21, 2
    lighting.Ambient = Color3.fromRGB(63, 55, 75)
    lighting.OutdoorAmbient = Color3.fromRGB(63, 72, 105)
    lighting.ExposureCompensation = -0.05
    lighting.GlobalShadows = true
    lighting.FogColor = Color3.fromRGB(34, 38, 61)
    lighting.FogStart, lighting.FogEnd = 100, 350
    local grade = Instance.new("ColorCorrectionEffect")
    grade.Name = "LastOrdersGothicGrade"
    grade.Contrast, grade.Saturation = 0.1, -0.12
    grade.TintColor = Color3.fromRGB(255, 240, 227)
    grade.Parent = lighting
    local bloom = Instance.new("BloomEffect")
    bloom.Name = "LastOrdersCandleBloom"
    bloom.Intensity, bloom.Size, bloom.Threshold = 0.18, 16, 1.8
    bloom.Parent = lighting
end
return Atmosphere
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_24">
        <Properties>
          <string name="Name">PubBoundary</string>
          <string name="Source">--!strict
-- Keep exploration on the supported ground; the drive-away endpoint stays inside.
local Props=require(script.Parent.PubProps)
local Boundary={}
function Boundary.build(map: Folder)
    local folder=Instance.new("Folder") folder.Name="GroundsBoundary"
    for _,row in {{Vector3.new(2,50,348),Vector3.new(-212,20,0)},
        {Vector3.new(2,50,348),Vector3.new(212,20,0)},
        {Vector3.new(426,50,2),Vector3.new(0,20,-172)},
        {Vector3.new(426,50,2),Vector3.new(0,20,172)}} do
        local barrier=Props.part(folder,"GroundsBarrier",row[1],CFrame.new(row[2]),Color3.fromRGB(34,43,38))
        barrier.CanCollide,barrier.CanQuery,barrier.Transparency=true,true,1
    end
    -- Dense distant hedges mark the limits through the fog rather than exposing a floor edge.
    for _,x in {-210,210} do for z=-160,160,20 do
        Props.part(folder,"BoundaryHedge",Vector3.new(5,12,21),CFrame.new(x,6,z),Color3.fromRGB(27,38,32),Enum.Material.Grass)
    end end
    for _,z in {-170,170} do for x=-200,200,20 do
        Props.part(folder,"BoundaryHedge",Vector3.new(21,12,5),CFrame.new(x,6,z),Color3.fromRGB(27,38,32),Enum.Material.Grass)
    end end
    folder.Parent=map
end
return Boundary
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_25">
        <Properties>
          <string name="Name">PubDressing</string>
          <string name="Source">--!strict
local Props = require(script.Parent.PubProps)
local Dressing = {}
local timber = Color3.fromRGB(36, 26, 24)
local brass = Color3.fromRGB(158, 113, 51)
local stone = Color3.fromRGB(79, 77, 85)
function Dressing.build(map: Folder)
    local decor = Instance.new("Folder")
    decor.Name = "GothicDressing"
    local function p(name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material?): Part
        return Props.part(decor, name, size, CFrame.new(position), color, material)
    end
    local function beam(a: Vector3, b: Vector3, width: number, color: Color3)
        return Props.part(decor, "GothicTimber", Vector3.new(width, width, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), color)
    end
    local function light(parent: BasePart, color: Color3, range: number, brightness: number, powered: boolean)
        local l = Instance.new("PointLight")
        l.Name = if powered then "PowerLight" else "Firelight"
        l.Color, l.Range, l.Brightness, l.Shadows = color, range, brightness, true
        l.Parent = parent
    end
    -- Keep the existing furniture blocks as invisible authoritative collision proxies.
    for _, object in map:GetChildren() do
        if object:IsA("Part") then
            if object.Name == "PubTable" or object.Name == "SnugTable" or object.Name == "OfficeDesk" then
                object.Transparency = 1
                Props.table(decor, CFrame.new(object.Position.X, 0.5, object.Position.Z), Vector3.new(object.Size.X / 7, 1, object.Size.Z / 6))
            elseif object.Name == "CellarBarrel" then
                object.Transparency = 1
                Props.barrel(decor, CFrame.new(object.Position.X, -15.5, object.Position.Z))
            elseif string.find(object.Name, "Wall") or object.Name == "OfficeSnugPartition" then
                object.Material, object.Color = Enum.Material.Plaster, Color3.fromRGB(107, 100, 110)
            elseif object.Name == "MainFloor" or object.Name == "EastFrontFloor" or object.Name == "EastBackFloor" then
                object.Color = Color3.fromRGB(59, 37, 29)
            end
        end
    end
    -- Chairs are tucked against their tables, outside the tested walking lanes.
    for _, x in {-17, 25} do
        Props.chair(decor, CFrame.new(x, 0.5, 33.3))
    end
    Props.chair(decor, CFrame.new(-41, 0.5, -3) * CFrame.Angles(0, -math.pi / 2, 0))
    Props.chair(decor, CFrame.new(-37, 0.5, -37.3) * CFrame.Angles(0, math.pi, 0))
    -- Bar front, carved panels and shelves; warning and bell retain their exact positions.
    local bar = map:FindFirstChild("Bar") :: Part
    bar.Color, bar.Material = timber, Enum.Material.Wood
    p("OakBarTop", Vector3.new(19, 0.22, 4.5), Vector3.new(-27, 4.5, 17), Color3.fromRGB(94, 49, 30))
    for _, x in {-34, -30.5, -27, -23.5, -20} do
        p("BarPanel", Vector3.new(2.9, 2.7, 0.15), Vector3.new(x, 2.6, 19.1), Color3.fromRGB(77, 38, 28))
        p("BarPanelInlay", Vector3.new(2.3, 0.08, 0.08), Vector3.new(x, 3.65, 19.22), brass, Enum.Material.Metal)
    end
    for _, y in {5.3, 7.5} do
        p("BackBarShelf", Vector3.new(15, 0.25, 1.4), Vector3.new(-28, y, 9.2), timber)
        for i = 0, 6 do
            local bottle = p("DustyBottle", Vector3.new(0.5, 1.3, 0.5), Vector3.new(-34 + i * 2, y + 0.8, 9.2), Color3.fromRGB(46, 67 + i * 3, 54), Enum.Material.Glass)
            bottle.Transparency = 0.15
            p("BottleNeck", Vector3.new(0.24, 0.45, 0.24), bottle.Position + Vector3.new(0, 0.85, 0), Color3.fromRGB(47, 69, 53), Enum.Material.Glass)
        end
    end
    -- Timber posts and wainscot are decorative, flush with the outer walls.
    for _, x in {-47.3, 47.3} do
        for _, z in {-38, -16, 7, 38} do p("OakPost", Vector3.new(0.7, 14, 0.8), Vector3.new(x, 7, z), timber) end
        p("WallDado", Vector3.new(0.28, 2.8, 78), Vector3.new(x, 1.9, 0), timber)
        p("BrassDadoRail", Vector3.new(0.4, 0.12, 78), Vector3.new(x, 3.35, 0), brass)
    end
    for _, z in {-39.3, 39.3} do
        for _, x in {-46, -16, 22, 46} do p("OakPost", Vector3.new(0.8, 14, 0.7), Vector3.new(x, 7, z), timber) end
    end
    for _, z in {-34, -8, 18, 36} do
        beam(Vector3.new(-48, 29.7, z), Vector3.new(0, 41.7, z), 0.85, timber)
        beam(Vector3.new(0, 41.7, z), Vector3.new(48, 29.7, z), 0.85, timber)
        beam(Vector3.new(-48, 13.2, z), Vector3.new(48, 13.2, z), 0.7, timber)
    end
    -- A vaulted slate roof closes the daylight opening without changing walking collision.
    local angle = math.atan(12 / 48)
    for _, side in {-1, 1} do
        local roof = p("SlateRoof", Vector3.new(math.sqrt(48 * 48 + 12 * 12) + 1, 0.8, 82), Vector3.new(side * 24, 36, 0), Color3.fromRGB(34, 33, 47), Enum.Material.Slate)
        roof.CFrame *= CFrame.Angles(0, 0, -side * angle)
        roof.CanQuery = true -- lets the third-person camera avoid the roof
    end
    -- Pointed stained-glass panels: blue/purple glass, lead tracery and brass corners.
    local function window(origin: CFrame)
        local function panel(name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material?)
            return Props.part(decor, name, size, origin * localCF, color, material)
        end
        panel("WindowRecess", Vector3.new(9.2, 10.2, 0.25), CFrame.new(0, 7.5, 0.08), timber)
        panel("StainedGlass", Vector3.new(7.6, 5.8, 0.1), CFrame.new(0, 6, -0.1), Color3.fromRGB(43, 60, 102), Enum.Material.Neon)
        panel("PointedGlass", Vector3.new(4.2, 4.2, 0.1), CFrame.new(0, 9.5, -0.12) * CFrame.Angles(0, 0, math.pi / 4), Color3.fromRGB(81, 47, 105), Enum.Material.Neon)
        for _, x in {-4.1, 0, 4.1} do panel("LeadMullion", Vector3.new(0.18, 6.2, 0.3), CFrame.new(x, 6, -0.25), timber, Enum.Material.Metal) end
        for _, y in {3, 6, 9} do panel("LeadCrossbar", Vector3.new(8.3, 0.16, 0.3), CFrame.new(0, y, -0.25), timber, Enum.Material.Metal) end
        for _, side in {-1, 1} do
            local a, b = origin:PointToWorldSpace(Vector3.new(side * 4.1, 9, -0.25)), origin:PointToWorldSpace(Vector3.new(0, 12.5, -0.25))
            beam(a, b, 0.28, brass)
        end
        for _, x in {-2, 2} do
            for _, y in {4.5, 7.5} do panel("GlassDiamond", Vector3.new(0.8, 0.8, 0.12), CFrame.new(x, y, -0.24) * CFrame.Angles(0, 0, math.pi / 4), Color3.fromRGB(116, 58, 87), Enum.Material.Neon) end
        end
    end
    for _, z in {-28, 26} do window(CFrame.new(-47.35, 0, z) * CFrame.Angles(0, -math.pi / 2, 0)) end
    for _, z in {-27, 27} do window(CFrame.new(47.35, 0, z) * CFrame.Angles(0, math.pi / 2, 0)) end
    -- A fireplace in the snug, flush to its far wall and away from the key route.
    p("FireplaceBacking", Vector3.new(1, 10, 11), Vector3.new(-46.5, 5.5, -3), stone, Enum.Material.Slate)
    p("FireplaceOpening", Vector3.new(0.2, 5, 6), Vector3.new(-45.9, 3.3, -3), Color3.fromRGB(17, 13, 18))
    for _, z in {-7, 1} do p("StoneFireplaceJamb", Vector3.new(1.5, 6, 1.4), Vector3.new(-45.3, 3.5, z), stone, Enum.Material.Slate) end
    p("StoneMantel", Vector3.new(2.2, 0.8, 10), Vector3.new(-45.3, 6.6, -3), stone, Enum.Material.Slate)
    p("Hearth", Vector3.new(3, 0.15, 10), Vector3.new(-45.3, 0.6, -3), stone, Enum.Material.Slate)
    local coal = p("GlowingCoals", Vector3.new(0.8, 0.3, 4), Vector3.new(-45.3, 1, -3), Color3.fromRGB(255, 105, 34), Enum.Material.Neon)
    local fire = Instance.new("Fire")
    fire.Size, fire.Heat = 3, 0
    fire.Color, fire.SecondaryColor = Color3.fromRGB(255, 156, 58), Color3.fromRGB(153, 52, 36)
    fire.Parent = coal
    light(coal, Color3.fromRGB(255, 160, 78), 24, 2.2, false)
    -- Candle chandeliers and wall sconces; all lights remain readable before power.
    for _, center in {Vector3.new(-10, 10.5, 27), Vector3.new(28, 10.5, 25), Vector3.new(-34, 10.5, -29), Vector3.new(-34, 10.5, -5)} do
        p("ChandelierStem", Vector3.new(0.12, 5, 0.12), center + Vector3.new(0, 2.5, 0), brass, Enum.Material.Metal)
        p("CandleArm", Vector3.new(4.6, 0.16, 0.16), center, brass, Enum.Material.Metal)
        for _, x in {-2, 0, 2} do
            p("WaxCandle", Vector3.new(0.28, 0.75, 0.28), center + Vector3.new(x, 0.45, 0), Color3.fromRGB(228, 207, 162))
            local flame = p("CandleFlame", Vector3.new(0.2, 0.4, 0.2), center + Vector3.new(x, 1, 0), Color3.fromRGB(255, 183, 82), Enum.Material.Neon)
            flame.Shape = Enum.PartType.Ball
            if x == 0 then light(flame, Color3.fromRGB(255, 189, 108), 27, 0.9, false) end
        end
    end
    -- Stair rails sit outside the walking lane and preserve the bright tread markers.
    for _, x in {25, 47} do
        beam(Vector3.new(x, 3.5, 7), Vector3.new(x, -11.5, -23), 0.22, brass)
        for step = 0, 15, 3 do
            p("StairBaluster", Vector3.new(0.14, 3, 0.14), Vector3.new(x, 2 - step, 7 - step * 2), timber, Enum.Material.Metal)
        end
    end
    -- Kitchen and office details, deliberately kept at the back of existing furniture.
    p("OfficeRunner", Vector3.new(8, 0.04, 3), Vector3.new(-37, 3.53, -33), Color3.fromRGB(93, 28, 46), Enum.Material.Fabric)
    for _, x in {-40, -39.3, -38.6} do p("OldLedger", Vector3.new(0.5, 1.2, 0.8), Vector3.new(x, 4.1, -34.5), Color3.fromRGB(73, 42, 38)) end
    p("KitchenWorktop", Vector3.new(6.2, 0.2, 20.2), Vector3.new(19, 3.6, -25), Color3.fromRGB(142, 135, 124), Enum.Material.Marble)
    local trim = p("ExitBrassHandle", Vector3.new(2, 0.25, 0.3), Vector3.new(-36, 5.5, 39.25), brass, Enum.Material.Metal)
    trim.Name = "ExitHandle"
    -- Original broad greybox light blocks become lantern fixtures.
    for _, object in map:GetChildren() do
        if object:IsA("Part") and object.Name == "PubLamp" then
            object.Color, object.Material, object.Transparency = brass, Enum.Material.Metal, 0
            local glow = p("LanternGlass", Vector3.new(0.8, 1.1, 0.8), object.Position - Vector3.new(0, 0.5, 0), Color3.fromRGB(255, 190, 100), Enum.Material.Neon)
            for _, side in {-1, 1} do p("LanternIron", Vector3.new(0.1, 1.4, 0.1), glow.Position + Vector3.new(side * 0.45, 0, 0.45), timber, Enum.Material.Metal) end
        end
    end
    decor.Parent = map
end
return Dressing
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_26">
        <Properties>
          <string name="Name">PubExpansion</string>
          <string name="Source">--!strict
-- Hand-authored extension of the disposable pub; original Studio geometry is untouched.
local Props = require(script.Parent.PubProps)
local Expansion = {}
local centers = {-30, -10, 10, 30}
function Expansion.build(map: Folder)
    local wood = Color3.fromRGB(59, 37, 29)
    local plaster = Color3.fromRGB(107, 100, 110)
    local brass = Color3.fromRGB(158, 113, 51)
    local function solid(name: string, size: Vector3, pos: Vector3, material: Enum.Material?): Part
        local p = Instance.new("Part")
        p.Name, p.Size, p.Position, p.Color = name, size, pos, plaster
        p.Material, p.Anchored, p.CanCollide = material or Enum.Material.Plaster, true, true
        p:SetAttribute("BlocksNavigation", not string.find(name, "Floor") and not string.find(name, "Step"))
        p.Parent = map
        return p
    end
    local decor = Instance.new("Folder")
    decor.Name = "GuestWingDressing"
    decor.Parent = map
    local function detail(name: string, size: Vector3, pos: Vector3, color: Color3, material: Enum.Material?): Part
        return Props.part(decor, name, size, CFrame.new(pos), color, material)
    end
    local function label(text: string, position: Vector3, rotation: number, width: number)
        local board = detail("GuestSign", Vector3.new(width, 1.7, 0.15), position, Color3.fromRGB(31, 23, 26))
        board.CFrame *= CFrame.Angles(0, rotation, 0)
        for _, face in {Enum.NormalId.Front, Enum.NormalId.Back} do
            local surface = Instance.new("SurfaceGui")
            surface.Face, surface.SizingMode = face, Enum.SurfaceGuiSizingMode.PixelsPerStud
            surface.PixelsPerStud, surface.LightInfluence = 60, 0
            surface.Parent = board
            local textLabel = Instance.new("TextLabel")
            textLabel.Size, textLabel.BackgroundTransparency = UDim2.fromScale(1, 1), 1
            textLabel.TextColor3, textLabel.Font = Color3.fromRGB(255, 225, 166), Enum.Font.GothamBold
            textLabel.TextScaled, textLabel.Text = true, text
            textLabel.Parent = surface
        end
    end
    local function lamp(position: Vector3)
        local base = detail("GuestLantern", Vector3.new(0.6, 0.9, 0.6), position, Color3.fromRGB(255, 190, 100), Enum.Material.Neon)
        local light = Instance.new("PointLight")
        light.Name, light.Color, light.Brightness, light.Range = "PowerLight", base.Color, 0.35, 30
        light.Shadows, light.Parent = true, base
    end
    -- The larger lounge occupies a south-east extension; the existing exit remains outdoors.
    local formerWall = map:FindFirstChild("SouthRight") :: Part
    formerWall.Size, formerWall.Position = Vector3.new(46, 14, 1), Vector3.new(-7, 7, 40)
    formerWall:SetAttribute("BlocksNavigation", true)
    solid("LoungeEntryWall", Vector3.new(8, 14, 1), Vector3.new(44, 7, 40))
    local floor = solid("LoungeFloor", Vector3.new(56, 1, 48), Vector3.new(20, 0, 64), Enum.Material.WoodPlanks)
    floor.Color = wood
    solid("LoungeWestWall", Vector3.new(1, 30, 48), Vector3.new(-8, 15, 64))
    solid("LoungeEastWall", Vector3.new(1, 30, 48), Vector3.new(48, 15, 64))
    solid("LoungeSouthWall", Vector3.new(56, 30, 1), Vector3.new(20, 15, 88))
    for _, name in {"JammedEntrance", "EntranceLabel", "OutsideSign"} do
        local object = map:FindFirstChild(name) :: BasePart
        object.Position += Vector3.new(0, 0, 48)
    end
    label("GUEST ROOMS — UPSTAIRS", Vector3.new(27, 10, 41), 0, 19)
    -- First-floor slab and broad landing. No slab is placed across the stair opening.
    local upper = solid("GuestFloor", Vector3.new(96, 1, 80), Vector3.new(0, 16, 0), Enum.Material.WoodPlanks)
    upper.Color = wood
    local landing = solid("GuestLandingFloor", Vector3.new(56, 1, 8), Vector3.new(20, 16, 44), Enum.Material.WoodPlanks)
    landing.Color = wood
    solid("GuestNorthWall", Vector3.new(97, 14, 1), Vector3.new(0, 23.5, -40))
    for _, x in {-48, 48} do solid("GuestOuterWall", Vector3.new(1, 14, 80), Vector3.new(x, 23.5, 0)) end
    for _, x in {-28, 28} do solid("GuestSouthWall", Vector3.new(40, 14, 1), Vector3.new(x, 23.5, 40)) end
    -- Ground floor and landing supply the end surfaces; do not overlay coplanar treads.
    for step = 0, 16 do
        local y, z = step, 78 - step * 2
        if step &gt; 0 and step &lt; 16 then
            solid("GuestStep", Vector3.new(24, 1, 2), Vector3.new(28, y, z), Enum.Material.WoodPlanks).Color = wood
        end
        detail("GuestStairEdge", Vector3.new(23, 0.06, 0.15), Vector3.new(28, y + 0.55, z - 0.85), brass, Enum.Material.Neon)
    end
    for _, x in {15.5, 40.5} do
        for step = 0, 16, 2 do
            detail("GuestBaluster", Vector3.new(0.15, 3, 0.15), Vector3.new(x, step + 2, 78 - step * 2), brass, Enum.Material.Metal)
        end
        local a, b = Vector3.new(x, 3.5, 78), Vector3.new(x, 19.5, 46)
        Props.part(decor, "GuestStairRail", Vector3.new(0.25, 0.25, (b-a).Magnitude), CFrame.lookAt((a+b)/2,b), brass)
        -- Stop the solid rail short of the landing so it cannot catch a turning avatar.
        local ga,gb=a-Vector3.new(0,1.3,0),b+Vector3.new(0,-2.3,2)
        local guard = solid("GuestStairGuard", Vector3.new(0.3, 3, (gb-ga).Magnitude), (ga+gb)/2)
        guard.CFrame = CFrame.lookAt(guard.Position, gb)
        guard.Transparency = 1
    end
    -- Guard the edges of the landing without obstructing the central stair mouth.
    for _, span in {{4, 24}, {44, 8}} do
        detail("LandingRail", Vector3.new(span[2], 0.3, 0.3), Vector3.new(span[1], 19.5, 47.5), brass)
        solid("GuestLandingGuard", Vector3.new(span[2],3,0.3), Vector3.new(span[1],18,47.5)).Transparency=1
        for x = span[1] - span[2]/2, span[1] + span[2]/2, 3 do
            detail("LandingBaluster", Vector3.new(0.15, 3, 0.15), Vector3.new(x, 18, 47.5), brass)
        end
    end
    -- Markers choose one fixed location per run; they are not collectible objects themselves.
    local locations = Instance.new("Folder")
    locations.Name, locations.Parent = "KeyLocations", map
    local function marker(name: string, position: Vector3)
        local spot = Instance.new("Part")
        spot.Name, spot.Size, spot.Position = name, Vector3.one, position
        spot.Anchored, spot.CanCollide, spot.CanTouch, spot.CanQuery, spot.Transparency = true, false, false, false, 1
        spot.Parent = locations
    end
    marker("Office", (map:FindFirstChild("OfficeKey") :: Part).Position-Vector3.new(0,0.2,0))
    for sideIndex, side in {-1, 1} do
        -- Four separate doorways along each side of the sixteen-stud corridor.
        for roomIndex, z in centers do
            local number = (sideIndex - 1) * 4 + roomIndex
            for _, edge in {-1, 1} do
                solid("BedroomDoorWall", Vector3.new(1, 14, 4), Vector3.new(side * 8, 23.5, z + edge * 8))
            end
            solid("BedroomDoorLintel", Vector3.new(1, 3, 12), Vector3.new(side * 8, 29, z))
            label("ROOM " .. number, Vector3.new(side * 7.35, 25.8, z), math.pi/2, 9)
            -- Beds, dresser and wardrobe are kept against the outer half of each room.
            local bed = solid("BedroomBed", Vector3.new(4.6, 2.6, 7.1), Vector3.new(side * 40, 17.8, z + 3), Enum.Material.Wood)
            bed.Color = Color3.fromRGB(46, 28, 26)
            detail("IvoryMattress", Vector3.new(4.4, 0.65, 6.8), Vector3.new(side * 40, 18.6, z + 3), Color3.fromRGB(213, 197, 164), Enum.Material.Fabric)
            detail("BurgundyBedspread", Vector3.new(4.45, 0.2, 4.5), Vector3.new(side * 40, 19, z + 4), Color3.fromRGB(90 + number * 3, 28, 45), Enum.Material.Fabric)
            detail("IvoryPillow", Vector3.new(3.5, 0.4, 1.2), Vector3.new(side * 40, 19.1, z + 0.3), Color3.fromRGB(233, 219, 188), Enum.Material.Fabric)
            solid("BedroomHeadboard", Vector3.new(4.8, 3.8, 0.3), Vector3.new(side * 40, 18.4, z - 0.5), Enum.Material.Wood).Color = wood
            local dresser = solid("BedroomDresser", Vector3.new(5, 3, 2.4), Vector3.new(side * 25, 18, z - 6), Enum.Material.Wood)
            dresser.Color = wood
            for _, y in {17.2, 18.1, 19} do
                detail("DresserDrawer", Vector3.new(4.7, 0.7, 0.12), Vector3.new(side * 25, y, z - 4.75), Color3.fromRGB(89, 47, 30))
                detail("BrassDrawerHandle", Vector3.new(0.8, 0.1, 0.2), Vector3.new(side * 25, y, z - 4.6), brass, Enum.Material.Metal)
            end
            local wardrobe = solid("BedroomWardrobe", Vector3.new(4.3, 7, 2.7), Vector3.new(side * 43, 20, z - 6), Enum.Material.Wood)
            wardrobe.Color = wood
            detail("WardrobeBrass", Vector3.new(0.12, 1.2, 0.15), Vector3.new(side * 43, 20, z - 4.55), brass, Enum.Material.Metal)
            marker(string.format("Room%02d", number), Vector3.new(side * 25, 19.7, z - 5.6))
            lamp(Vector3.new(side * 23, 27, z))
        end
        for _, z in {-20, 0, 20} do
            if side == -1 and z == -20 then
                -- Only rooms 1 and 2 adjoin; the other six retain a single doorway.
                solid("BedroomPartition",Vector3.new(24,14,1),Vector3.new(-36,23.5,z))
                solid("BedroomPartition",Vector3.new(6,14,1),Vector3.new(-11,23.5,z))
                solid("AdjoiningDoorLintel",Vector3.new(10,3,1),Vector3.new(-19,29,z)).Color=wood
                for _,x in {-24,-14} do
                    detail("AdjoiningDoorFrame",Vector3.new(0.3,11,1.2),Vector3.new(x,22,z),wood)
                end
                label("ADJOINING ROOMS 1 / 2",Vector3.new(-19,26,z),0,10)
            else
                solid("BedroomPartition", Vector3.new(40, 14, 1), Vector3.new(side * 28, 23.5, z))
            end
        end
    end
    for _, z in centers do
        lamp(Vector3.new(0, 27, z))
        detail("CorridorRunner", Vector3.new(8, 0.04, 18), Vector3.new(0, 16.53, z), Color3.fromRGB(83, 28, 44), Enum.Material.Fabric)
    end
    label("ROOMS 1–4  /  5–8", Vector3.new(0, 25.8, 39), 0, 16)
    lamp(Vector3.new(6, 11, 60))
    lamp(Vector3.new(28, 27, 62))
    lamp(Vector3.new(28, 7, 82))
    Props.table(decor, CFrame.new(-2, 0.5, 56))
    Props.chair(decor, CFrame.new(-2, 0.5, 60))
    -- Roof over the extension, separate from the raised roof over the eight bedrooms.
    for _, side in {-1, 1} do
        local roof = detail("LoungeRoof", Vector3.new(math.sqrt(28*28 + 7*7) + 1, 0.8, 48), Vector3.new(20 + side*14, 33.5, 65), Color3.fromRGB(34, 33, 47), Enum.Material.Slate)
        roof.CFrame *= CFrame.Angles(0, 0, -side * math.atan(7/28))
        roof.CanQuery = true
    end
    require(script.Parent.StaffStairs).build(map)
end
function Expansion.addRoutes(positions: {Vector3}, edges: {{number}})
    local function node(position: Vector3): number
        table.insert(positions, position)
        return #positions
    end
    local function link(a: number, b: number) table.insert(edges, {a,b}) end
    local approach = node(Vector3.new(40,4.5,36))
    local entry = node(Vector3.new(28,4.5,36))
    local inner = node(Vector3.new(28,4.5,44))
    local near = node(Vector3.new(6,4.5,44))
    local south = node(Vector3.new(6,4.5,84))
    local bottom = node(Vector3.new(28,4.5,84))
    link(3,approach) link(approach,entry) link(entry,inner) link(inner,near) link(near,south) link(south,bottom)
    local previous = bottom
    for step = 0,16 do
        local current = node(Vector3.new(28,4.5+step,78-step*2))
        link(previous,current) previous=current
    end
    local landing = node(Vector3.new(28,20.5,44))
    local corridorEnd = node(Vector3.new(0,20.5,44))
    link(previous,landing) link(landing,corridorEnd)
    previous = corridorEnd
    local adjoining: {number} = {}
    for i = #centers,1,-1 do
        local z = centers[i]
        local hall = node(Vector3.new(0,20.5,z))
        link(previous,hall) previous=hall
        for _,side in {-1,1} do
            local door=node(Vector3.new(side*14,20.5,z))
            local room=node(Vector3.new(side*26,20.5,z))
            link(hall,door) link(door,room)
            if side==-1 and (z==-30 or z==-10) then table.insert(adjoining,room) end
        end
    end
    require(script.Parent.StaffStairs).addRoutes(positions,edges,previous)
    local a=node(Vector3.new(-19,20.5,-10))
    local b=node(Vector3.new(-19,20.5,-30))
    link(adjoining[1],a) link(a,b) link(b,adjoining[2])
end
return Expansion
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_27">
        <Properties>
          <string name="Name">PubExterior</string>
          <string name="Source">--!strict
-- Fixed exterior scenery around the existing pub. No objectives/spawns/doors are changed.
local Props=require(script.Parent.PubProps)
local Exterior={}
local timber=Color3.fromRGB(40,29,27)
local stone=Color3.fromRGB(72,73,85)
function Exterior.build(map: Folder)
    local root=Instance.new("Folder") root.Name="Exterior" root.Parent=map
    local ground=Instance.new("Folder") ground.Name="Ground" ground.Parent=root
    local facade=Instance.new("Folder") facade.Name="PubFrontage" facade.Parent=root
    local landscape=Instance.new("Folder") landscape.Name="Woodland" landscape.Parent=root
    local function p(parent: Instance,name: string,size: Vector3,position: Vector3,color: Color3,material: Enum.Material?): Part
        return Props.part(parent,name,size,CFrame.new(position),color,material)
    end
    local function solid(parent: Instance,name: string,size: Vector3,position: Vector3,color: Color3,material: Enum.Material?): Part
        local part=p(parent,name,size,position,color,material)
        part.CanCollide,part.CanQuery=true,true return part
    end
    local function beam(parent: Instance,name: string,a: Vector3,b: Vector3,width: number,color: Color3)
        return Props.part(parent,name,Vector3.new(width,width,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),color)
    end
    -- Ground is split around the L-shaped pub, never across the cellar opening.
    local regions={
        {Vector3.new(171.5,1,360),Vector3.new(-134.25,-0.2,0)},
        {Vector3.new(171.5,1,360),Vector3.new(134.25,-0.2,0)},
        {Vector3.new(97,1,139.5),Vector3.new(0,-0.2,-110.25)},
        {Vector3.new(40,1,139.5),Vector3.new(-28.5,-0.2,110.25)},
        {Vector3.new(57,1,91.5),Vector3.new(20,-0.2,134.25)},
    }
    for _,r in regions do solid(ground,"CountrysideGround",r[1],r[2],Color3.fromRGB(34,46,39),Enum.Material.Grass) end
    solid(ground,"WetRoad",Vector3.new(440,0.25,24),Vector3.new(0,0.4,132),Color3.fromRGB(30,35,45),Enum.Material.Asphalt).Reflectance=0.16
    solid(ground,"GravelLayby",Vector3.new(66,0.12,20),Vector3.new(-60,0.36,112),Color3.fromRGB(79,80,84),Enum.Material.Pebble)
    for x=-210,210,28 do p(ground,"RoadMarking",Vector3.new(13,0.02,0.22),Vector3.new(x,0.55,132),Color3.fromRGB(178,180,170),Enum.Material.SmoothPlastic) end
    for _,z in {120.4,143.6} do p(ground,"RoadEdge",Vector3.new(440,0.02,0.16),Vector3.new(0,0.55,z),Color3.fromRGB(150,153,146)) end
    -- Broad wet paving continues to the car; it is clear of the actual exit doorway.
    solid(ground,"ExitCourtyard",Vector3.new(25,0.12,38),Vector3.new(-36,0.38,90),stone,Enum.Material.Slate)
    solid(ground,"FrontPath",Vector3.new(13,0.12,25),Vector3.new(6,0.38,101),stone,Enum.Material.Slate)
    solid(ground,"ConnectingPath",Vector3.new(53,0.12,10),Vector3.new(-15,0.38,109),stone,Enum.Material.Slate)
    local path=map:FindFirstChild("EscapePath") :: Part
    path.Material,path.Color,path.Reflectance=Enum.Material.Slate,stone,0.12
    for _,v in {Vector3.new(-50,0.48,104),Vector3.new(25,0.34,115),Vector3.new(85,0.34,93),Vector3.new(-105,0.34,104)} do
        local puddle=p(ground,"Puddle",Vector3.new(9,0.02,4),v,Color3.fromRGB(51,63,82),Enum.Material.Glass)
        puddle.Transparency,puddle.Reflectance=0.35,0.3
    end
    local function board(parent: Instance,name: string,text: string,position: Vector3,width: number,height: number): Part
        local part=p(parent,name,Vector3.new(width,height,0.25),position,timber)
        for _,face in {Enum.NormalId.Front,Enum.NormalId.Back} do
            local surface=Instance.new("SurfaceGui") surface.Face=face
            surface.SizingMode,surface.PixelsPerStud,surface.LightInfluence=Enum.SurfaceGuiSizingMode.PixelsPerStud,45,0
            surface.Parent=part
            local label=Instance.new("TextLabel") label.Size,label.Position=UDim2.fromScale(0.94,0.9),UDim2.fromScale(0.03,0.05)
            label.BackgroundTransparency,label.TextScaled,label.TextWrapped=1,true,true
            label.Font,label.TextColor3,label.Text=Enum.Font.GothamBold,Color3.fromRGB(255,221,157),text label.Parent=surface
        end
        return part
    end
    local function lantern(position: Vector3)
        p(facade,"LanternBack",Vector3.new(1,1.8,0.3),position,timber,Enum.Material.Metal)
        local glass=p(facade,"ExteriorLantern",Vector3.new(0.7,1.1,0.7),position+Vector3.new(0,0,0.4),Color3.fromRGB(255,172,72),Enum.Material.Neon)
        local light=Instance.new("PointLight") light.Color,light.Brightness,light.Range=glass.Color,1.2,24 light.Shadows=true light.Parent=glass
    end
    -- Exterior stained-glass panels remain decorative over the tested structural walls.
    local function window(origin: CFrame,width: number)
        local function localPart(name: string,size: Vector3,cf: CFrame,color: Color3,material: Enum.Material?)
            return Props.part(facade,name,size,origin*cf,color,material)
        end
        localPart("WindowRecess",Vector3.new(width+0.7,7.8,0.25),CFrame.new(0,0,0.04),timber)
        local glow=localPart("WarmWindow",Vector3.new(width,5.6,0.12),CFrame.new(0,-0.7,0.22),Color3.fromRGB(196,118,49),Enum.Material.Neon)
        local spill=Instance.new("SurfaceLight")
        spill.Face,spill.Color,spill.Brightness,spill.Range,spill.Angle=Enum.NormalId.Back,glow.Color,0.45,14,115
        spill.Shadows,spill.Parent=false,glow
        localPart("PointedWindow",Vector3.new(width*0.6,width*0.6,0.12),CFrame.new(0,2,0.23)*CFrame.Angles(0,0,math.pi/4),Color3.fromRGB(153,87,49),Enum.Material.Neon)
        for _,x in {-width/2,0,width/2} do localPart("WindowLead",Vector3.new(0.16,5.9,0.3),CFrame.new(x,-0.7,0.34),timber) end
        for _,y in {-3.6,-0.7,2.2} do localPart("WindowLead",Vector3.new(width+0.2,0.16,0.3),CFrame.new(0,y,0.34),timber) end
        for _,side in {-1,1} do
            beam(facade,"PointedWindowFrame",origin:PointToWorldSpace(Vector3.new(side*width/2,2.2,0.34)),origin:PointToWorldSpace(Vector3.new(0,5,0.34)),0.25,timber)
        end
    end
    for _,x in {-2,25,40} do window(CFrame.new(x,7,88.65),if x==-2 then 5 else 7) end
    for _,x in {6,25,40} do window(CFrame.new(x,23,88.65),6) end
    for _,x in {-40,-18} do window(CFrame.new(x,23,40.65),7) end
    window(CFrame.new(-18,7,40.65),7)
    for _,side in {-1,1} do
        for _,z in {-30,-10,10,30} do
            window(CFrame.new(side*48.65,23,z)*CFrame.Angles(0,side*math.pi/2,0),7)
        end
    end
    -- Dark half-timber framing on both visible fronts and the bedroom side walls.
    for _,x in {-7,15,33,47} do p(facade,"FrontTimber",Vector3.new(0.7,30,0.6),Vector3.new(x,15,88.7),timber) end
    for _,y in {1,15.8,30} do p(facade,"FrontBeam",Vector3.new(56,0.7,0.6),Vector3.new(20,y,88.7),timber) end
    for _,side in {-1,1} do
        for _,z in {-39,-20,0,20,39} do p(facade,"UpperTimber",Vector3.new(0.6,14,0.65),Vector3.new(side*48.7,23,z),timber) end
        for _,y in {16.5,30} do p(facade,"UpperTimberRail",Vector3.new(0.6,0.6,80),Vector3.new(side*48.7,y,0),timber) end
    end
    -- Triangular gables close the roof ends without touching any walking space.
    local function gable(centerX: number,z: number,halfWidth: number,height: number)
        for _,side in {-1,1} do
            local wedge=Instance.new("WedgePart") wedge.Name="GothicGable"
            wedge.Size=Vector3.new(0.5,height,halfWidth)
            wedge.CFrame=CFrame.new(centerX+side*halfWidth/2,30+height/2,z)*CFrame.Angles(0,-side*math.pi/2,0)
            wedge.Color,wedge.Material=Color3.fromRGB(95,91,103),Enum.Material.Plaster
            wedge.Anchored,wedge.CanCollide,wedge.CanQuery=true,false,false wedge.Parent=facade
            beam(facade,"GableTimber",Vector3.new(centerX+side*halfWidth,30,z+0.35),Vector3.new(centerX,30+height,z+0.35),0.55,timber)
        end
    end
    gable(0,-40.65,48,12) gable(0,40.65,48,12) gable(20,88.65,28,7)
    for _,v in {Vector3.new(-30,38,-20),Vector3.new(30,38,6)} do
        p(facade,"StoneChimney",Vector3.new(4,12,5),v,stone,Enum.Material.Brick)
        p(facade,"ChimneyCap",Vector3.new(5,0.6,6),v+Vector3.new(0,6,0),Color3.fromRGB(45,42,49),Enum.Material.Slate)
    end
    board(facade,"FrontPubName","THE FIREFLY TAVERN",Vector3.new(20,13,89.1),37,2.5)
    board(facade,"RoomsAvailable","ROOMS AVAILABLE",Vector3.new(6,8,89.1),9,1.4)
    p(facade,"ExteriorFrontDoor",Vector3.new(9,10,0.3),Vector3.new(6,5.5,88.7),Color3.fromRGB(50,32,29))
    for _,x in {0.5,11.5} do p(facade,"FrontDoorFrame",Vector3.new(0.6,11,0.7),Vector3.new(x,5.7,88.9),timber) end
    lantern(Vector3.new(-0.7,9,89.1)) lantern(Vector3.new(12.7,9,89.1))
    lantern(Vector3.new(-44,9,40.8))
    board(facade,"OutsideExitLabel","EMERGENCY EXIT",Vector3.new(-36,12.6,40.8),12,1.4)
    -- Hanging inn sign, pivoted at its upper attachment for a gentle local wind sway.
    solid(facade,"SignPost",Vector3.new(0.7,15,0.7),Vector3.new(-5,7.8,100),timber)
    beam(facade,"SignArm",Vector3.new(-5,14.5,100),Vector3.new(2,14.5,100),0.55,timber)
    local sign=Instance.new("Model") sign.Name="HangingPubSign" sign.Parent=facade
    board(sign,"SignBoard","THE FIREFLY TAVERN\nROOMS AVAILABLE",Vector3.new(-0.5,11,100),8,4)
    for _,x in {-3,2} do p(sign,"SignChain",Vector3.new(0.1,1.5,0.1),Vector3.new(x,13.75,100),Color3.fromRGB(87,82,75),Enum.Material.Metal) end
    sign.WorldPivot=CFrame.new(-0.5,14.5,100)
    require(script.Parent.ExteriorCar).build(root)
    -- Fixed tree positions leave the road, courtyard and car approach clear.
    local trees={Vector3.new(-100,0,52),Vector3.new(-128,0,22),Vector3.new(-85,0,-38),Vector3.new(-128,0,-76),Vector3.new(-24,0,-97),Vector3.new(22,0,-112),Vector3.new(84,0,-62),Vector3.new(119,0,-20),Vector3.new(98,0,40),Vector3.new(130,0,84),Vector3.new(172,0,106),Vector3.new(-163,0,108),Vector3.new(-140,0,160),Vector3.new(-73,0,165),Vector3.new(0,0,170),Vector3.new(80,0,165),Vector3.new(155,0,160)}
    for i,position in trees do
        local height=24+(i%4)*3
        local trunk=solid(landscape,"BareTreeTrunk",Vector3.new(1.6,height,1.6),position+Vector3.new(0,height/2,0),Color3.fromRGB(37,33,36),Enum.Material.Wood)
        for _,side in {-1,1} do
            local a=trunk.Position+Vector3.new(0,3,0)
            local b=position+Vector3.new(side*7,height+2,(i%3-1)*5)
            beam(landscape,"BareBranch",a,b,0.7,Color3.fromRGB(37,33,36))
            beam(landscape,"BareTwig",b-Vector3.new(side*2,3,0),b+Vector3.new(side*3,2,2),0.35,Color3.fromRGB(37,33,36))
        end
    end
    for _,x in {-110,95} do
        for z=0,100,10 do solid(landscape,"FencePost",Vector3.new(0.45,3,0.45),Vector3.new(x,1.8,z),timber) end
        for _,y in {1.3,2.5} do p(landscape,"FenceRail",Vector3.new(0.25,0.2,100),Vector3.new(x,y,50),timber) end
    end
    root:SetAttribute("StormyExterior",true)
end
return Exterior
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_28">
        <Properties>
          <string name="Name">PubProps</string>
          <string name="Source">--!strict
-- Local Part equivalents of assets/props/pub-set/build.py; no mesh uploads.
local Props = {}
local oak = {Color3.fromRGB(66, 34, 20), Color3.fromRGB(80, 43, 25), Color3.fromRGB(93, 52, 30), Color3.fromRGB(72, 37, 23)}
local iron = Color3.fromRGB(33, 35, 39)
function Props.part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
    local p = Instance.new("Part")
    p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
    p.Material = material or Enum.Material.Wood
    p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end
function Props.table(parent: Instance, origin: CFrame, scale: Vector3?)
    local s = scale or Vector3.one
    local function box(name: string, pos: Vector3, size: Vector3, color: Color3)
        Props.part(parent, name, size * s, origin * CFrame.new(pos * s), color)
    end
    for i = 0, 4 do box("TablePlank", Vector3.new(0, 2.8, (i - 2) * 1.2), Vector3.new(7, 0.4, 1.17), oak[i % 4 + 1]) end
    for _, x in {-2.65, 2.65} do
        for _, z in {-2.2, 2.2} do box("TableLeg", Vector3.new(x, 1.3, z), Vector3.new(0.48, 2.6, 0.48), oak[1]) end
        box("TableApron", Vector3.new(x, 2.35, 0), Vector3.new(0.24, 0.6, 4.5), oak[2])
        box("TableCrossRail", Vector3.new(x, 0.7, 0), Vector3.new(0.32, 0.35, 4.5), oak[2])
    end
    for _, z in {-2.2, 2.2} do box("TableApron", Vector3.new(0, 2.35, z), Vector3.new(5.4, 0.6, 0.24), oak[1]) end
    box("TableStretcher", Vector3.new(0, 0.7, 0), Vector3.new(5.5, 0.35, 0.32), oak[2])
end
function Props.chair(parent: Instance, origin: CFrame)
    local function box(name: string, pos: Vector3, size: Vector3, color: Color3)
        Props.part(parent, name, size, origin * CFrame.new(pos), color)
    end
    for i = -1, 1 do box("ChairSeat", Vector3.new(0, 1.85, i * 0.8), Vector3.new(2.5, 0.3, 0.77), oak[i + 2]) end
    for _, x in {-0.96, 0.96} do
        box("ChairBackPost", Vector3.new(x, 2.2, 0.93), Vector3.new(0.3, 4.4, 0.3), oak[1])
        box("ChairFrontLeg", Vector3.new(x, 0.85, -0.93), Vector3.new(0.34, 1.7, 0.34), oak[1])
        box("ChairRail", Vector3.new(x, 0.65, 0), Vector3.new(0.18, 0.2, 1.9), oak[2])
    end
    for _, y in {2.65, 3.75} do box("ChairBackRail", Vector3.new(0, y, 0.93), Vector3.new(2.2, 0.45, 0.26), oak[3]) end
    for _, x in {-0.55, 0, 0.55} do box("ChairSlat", Vector3.new(x, 3.2, 0.93), Vector3.new(0.2, 0.7, 0.18), oak[2]) end
    box("BurgundyCushion", Vector3.new(0, 2.04, 0), Vector3.new(2.3, 0.16, 2.1), Color3.fromRGB(90, 28, 45))
end
function Props.barrel(parent: Instance, origin: CFrame)
    for i = 0, 15 do
        local angle = i * math.pi / 8
        local stave = origin * CFrame.Angles(0, angle, 0) * CFrame.new(0, 2, 1.8)
        Props.part(parent, "BarrelStave", Vector3.new(0.68, 3.8, 0.25), stave, oak[i % 4 + 1])
    end
    for _, y in {0.45, 1.2, 2.8, 3.55} do
        for i = 0, 15 do
            local cf = origin * CFrame.Angles(0, i * math.pi / 8, 0) * CFrame.new(0, y, 1.95)
            Props.part(parent, "IronBarrelHoop", Vector3.new(0.79, 0.23, 0.12), cf, iron, Enum.Material.Metal)
        end
    end
    for _, y in {0.1, 3.9} do
        local head = Props.part(parent, "BarrelHead", Vector3.new(0.16, 3.7, 3.7), origin * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.pi / 2), oak[2])
        head.Shape = Enum.PartType.Cylinder
    end
end
return Props
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_29">
        <Properties>
          <string name="Name">RunState</string>
          <string name="Source">--!strict
local RunState = {}
export type State = { stage: number }
function RunState.new(): State
    return { stage = 0 }
end
function RunState.advance(state: State, expected: number): boolean
    if state.stage ~= expected or expected &lt; 0 or expected &gt; 6 then
        return false
    end
    state.stage += 1
    return true
end
return RunState
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_30">
        <Properties>
          <string name="Name">SceneDirector</string>
          <string name="Source">--!strict
-- Authoritative first-view eligibility, scene completion and uninterrupted skip holds.
local Director={}
type Flags={[string]: boolean}
function Director.new(player: Player,seen: Flags,onEnd: (string,boolean)-&gt;(),onSeen: (Flags)-&gt;(),clock: (() -&gt; number)?)
    local time=clock or os.clock
    local scene=""
    local endsAt,holdAt=0,0
    local holding=false
    local function publish()
        player:SetAttribute("LastOrdersScene",scene)
        player:SetAttribute("LastOrdersSceneSkippable",scene~="" and seen[scene]==true)
    end
    local function finish(skipped: boolean)
        local name=scene
        if name=="" then return end
        scene="" holding=false publish()
        if not skipped and not seen[name] then seen[name]=true onSeen(table.clone(seen)) end
        onEnd(name,skipped)
    end
    local controller={}
    function controller.start(name: string,duration: number)
        scene=name endsAt=time()+duration holding=false
        player:SetAttribute("LastOrdersSceneStarted",workspace:GetServerTimeNow())
        player:SetAttribute("LastOrdersSceneDuration",duration)
        publish()
    end
    function controller.active(name: string?): boolean return scene~="" and (name==nil or scene==name) end
    function controller.step() if scene~="" and time()&gt;=endsAt then finish(false) end end
    function controller.request(action: string,expected: string)
        if scene=="" or scene~=expected or not seen[scene] then return end
        if action=="Begin" then
            if not holding then holding=true holdAt=time() end
        elseif action=="Cancel" then holding=false
        elseif action=="Finish" and holding and time()-holdAt&gt;=1 then finish(true) end
    end
    function controller.cancel() scene="" holding=false publish() end
    function controller.completed(name: string): boolean return seen[name]==true end
    publish()
    return controller
end
return Director
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_31">
        <Properties>
          <string name="Name">SceneHistory</string>
          <string name="Source">--!strict
-- Only completed cinematic flags persist. Studio never touches live data stores.
local RunService=game:GetService("RunService")
local DataStoreService=game:GetService("DataStoreService")
local History={}
local keys={Arrival=true,Awakening=true,Escape=true}
local pending=0
local store=if RunService:IsStudio() then nil else DataStoreService:GetDataStore("LastOrdersSceneHistory_v1")
function History.merge(old: any,seen: {[string]: boolean}): {[string]: boolean}
    local merged: {[string]: boolean}={}
    for name in keys do if seen[name] or (typeof(old)=="table" and old[name]==true) then merged[name]=true end end
    return merged
end
function History.load(userId: number): {[string]: boolean}
    local result: {[string]: boolean}={}
    if not store or userId&lt;=0 then return result end
    local ok,value=pcall(function() return store:GetAsync(tostring(userId)) end)
    if ok and typeof(value)=="table" then
        result=History.merge(value,{})
    elseif not ok then warn("Scene history unavailable; first-view rules used for this session") end
    return result
end
function History.save(userId: number,seen: {[string]: boolean})
    if not store or userId&lt;=0 then return end
    local snapshot=table.clone(seen)
    pending+=1
    task.spawn(function()
        local ok=pcall(function()
            store:UpdateAsync(tostring(userId),function(old)
                return History.merge(old,snapshot)
            end)
        end)
        pending-=1
        if not ok then warn("Completed scene flags could not be saved; session flags remain available") end
    end)
end
if store then game:BindToClose(function()
    local deadline=os.clock()+12
    while pending&gt;0 and os.clock()&lt;deadline do task.wait(.1) end
end) end
return History
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_32">
        <Properties>
          <string name="Name">StaffStairs</string>
          <string name="Source">--!strict
-- Enclosed rear service stair: upstairs corridor -&gt; kitchen, with a walking return below.
local Props = require(script.Parent.PubProps)
local Stairs = {}
function Stairs.build(map: Folder)
    local wood, brass = Color3.fromRGB(59,37,29), Color3.fromRGB(158,113,51)
    local decor = Instance.new("Folder")
    decor.Name, decor.Parent = "StaffStairDressing", map
    local function solid(name: string, size: Vector3, position: Vector3): Part
        local p = Instance.new("Part")
        p.Name, p.Size, p.Position = name, size, position
        p.Anchored, p.CanCollide = true, true
        p.Color, p.Material = wood, Enum.Material.WoodPlanks
        p:SetAttribute("BlocksNavigation", not string.find(name,"Floor") and not string.find(name,"Step"))
        p.Parent = map
        return p
    end
    local function detail(name: string, size: Vector3, position: Vector3, color: Color3): Part
        return Props.part(decor, name, size, CFrame.new(position), color)
    end
    local function doorway(wall: BasePart, left: number, right: number)
        local a, b = wall.Position.X-wall.Size.X/2, wall.Position.X+wall.Size.X/2
        local position, size, name = wall.Position, wall.Size, wall.Name
        wall:Destroy()
        for _, span in {{a,left},{right,b}} do
            local p = solid(name,Vector3.new(span[2]-span[1],size.Y,size.Z),Vector3.new((span[1]+span[2])/2,position.Y,position.Z))
            p.Color, p.Material = Color3.fromRGB(107,100,110), Enum.Material.Plaster
        end
        solid("StaffDoorLintel",Vector3.new(right-left,3,1),Vector3.new((left+right)/2,position.Y+5.5,position.Z))
    end
    doorway(map:FindFirstChild("NorthWall") :: BasePart,2,16)
    doorway(map:FindFirstChild("GuestNorthWall") :: BasePart,-6,6)
    solid("StaffFloor",Vector3.new(32,1,46),Vector3.new(8,0,-63))
    solid("StaffLandingFloor",Vector3.new(32,1,8),Vector3.new(8,16,-44))
    for _,x in {-8,24} do solid("StaffOuterWall",Vector3.new(1,31,46),Vector3.new(x,15.5,-63)) end
    solid("StaffNorthWall",Vector3.new(32,31,1),Vector3.new(8,15.5,-86))
    for step=1,15 do
        solid("StaffStep",Vector3.new(12,1,2),Vector3.new(12,step,-78+step*2))
        local edge=detail("StaffStairEdge",Vector3.new(11.5,0.06,0.15),Vector3.new(12,step+0.55,-78+step*2+0.85),brass)
        edge.Material=Enum.Material.Neon
    end
    for _,x in {5.5,18.5} do
        local a,b=Vector3.new(x,3.5,-78),Vector3.new(x,19.5,-46)
        Props.part(decor,"StaffStairRail",Vector3.new(0.25,0.25,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),brass)
        for step=0,16,2 do detail("StaffBaluster",Vector3.new(0.15,3,0.15),Vector3.new(x,step+2,-78+step*2),brass) end
        local ga,gb=a-Vector3.new(0,1.3,0),b+Vector3.new(0,-2.3,-2)
        local guard=solid("StaffStairGuard",Vector3.new(0.3,3,(gb-ga).Magnitude),(ga+gb)/2)
        guard.CFrame,guard.Transparency=CFrame.lookAt(guard.Position,gb),1
    end
    -- The upper landing edge is solid except at the stair mouth.
    for _,span in {{-1,13},{21.5,5}} do
        solid("StaffLandingGuard",Vector3.new(span[2],3,0.3),Vector3.new(span[1],18,-47.5)).Transparency=1
        detail("StaffLandingRail",Vector3.new(span[2],0.25,0.25),Vector3.new(span[1],19.5,-47.5),brass)
        for x=span[1]-span[2]/2,span[1]+span[2]/2,2.5 do
            detail("StaffLandingBaluster",Vector3.new(0.15,3,0.15),Vector3.new(x,18,-47.5),brass)
        end
    end
    for _,side in {-1,1} do
        local roof=detail("StaffSlateRoof",Vector3.new(math.sqrt(16*16+5*5)+1,0.8,46),Vector3.new(8+side*8,33.5,-63),Color3.fromRGB(34,33,47))
        roof.Material,roof.CanQuery=Enum.Material.Slate,true
        roof.CFrame*=CFrame.Angles(0,0,-side*math.atan(5/16))
    end
    local function label(text: string, position: Vector3, rotation: number?)
        local board=detail("StaffSign",Vector3.new(11,2.2,0.15),position,Color3.fromRGB(31,23,26))
        board.CFrame*=CFrame.Angles(0,rotation or 0,0)
        for _,face in {Enum.NormalId.Front,Enum.NormalId.Back} do
            local gui=Instance.new("SurfaceGui") gui.Face,gui.PixelsPerStud,gui.LightInfluence=face,60,0
            gui.SizingMode,gui.Parent=Enum.SurfaceGuiSizingMode.PixelsPerStud,board
            local writing=Instance.new("TextLabel") writing.Size,writing.BackgroundTransparency=UDim2.fromScale(1,1),1
            writing.Text,writing.TextScaled,writing.TextColor3=text,true,Color3.fromRGB(255,225,166)
            writing.Font,writing.Parent=Enum.Font.GothamBold,gui
        end
    end
    label("STAFF STAIRS\nGUEST ROOMS",Vector3.new(9,10,-39.3))
    label("STAFF STAIRS\nKITCHEN / BAR",Vector3.new(0,26,-39.3))
    label("KITCHEN / BAR\nFOLLOW PASSAGE",Vector3.new(12,6,-84.9))
    label("GUEST ROOMS\nSTAIRS UP",Vector3.new(23.3,8,-78),math.pi/2)
    for _,position in {Vector3.new(-5,8,-46),Vector3.new(-5,8,-80),Vector3.new(22,25,-45),Vector3.new(22,17,-64)} do
        local bulb=detail("StaffLantern",Vector3.new(0.6,1,0.6),position,Color3.fromRGB(255,190,100))
        bulb.Material=Enum.Material.Neon
        local light=Instance.new("PointLight")
        light.Name,light.Color,light.Range,light.Brightness="PowerLight",bulb.Color,28,0.35
        light.Shadows,light.Parent=true,bulb
    end
end
function Stairs.addRoutes(positions: {Vector3}, edges: {{number}}, corridor: number)
    local function extend(previous: number, position: Vector3): number
        table.insert(positions,position)
        table.insert(edges,{previous,#positions})
        return #positions
    end
    local previous=extend(corridor,Vector3.new(0,20.5,-44))
    previous=extend(previous,Vector3.new(12,20.5,-44))
    for step=16,0,-1 do previous=extend(previous,Vector3.new(12,4.5+step,-78+step*2)) end
    previous=extend(previous,Vector3.new(12,4.5,-82))
    previous=extend(previous,Vector3.new(-1,4.5,-82))
    previous=extend(previous,Vector3.new(-1,4.5,-44))
    previous=extend(previous,Vector3.new(9,4.5,-44))
    table.insert(edges,{previous,11}) -- existing kitchen north
end
return Stairs
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_33">
        <Properties>
          <string name="Name">StormWindows</string>
          <string name="Source">--!strict
-- Real openings in disposable runtime walls; invisible panes preserve solid/sight boundaries.
local Props=require(script.Parent.PubProps)
local Windows={}
type Add=(string,CFrame,Vector3?,{Instance}?,Instance?,string?)-&gt;Part
function Windows.build(map: Folder,add: Add)
    local folder=Instance.new("Folder") folder.Name,folder.Parent="StormViewWindows",map
    local oldNames={WindowRecess=true,StainedGlass=true,PointedGlass=true,LeadMullion=true,LeadCrossbar=true,
        GlassDiamond=true,PointedWindowFrame=true,WarmWindow=true,PointedWindow=true,WindowLead=true}
    for _,p in map:GetDescendants() do
        if p:IsA("BasePart") and math.abs(p.Position.X)&gt;46.8 and p.Position.Y&lt;31 and (oldNames[p.Name] or (p.Name=="GothicTimber" and p.Position.Y&gt;8 and p.Position.Y&lt;14 and p.Color==Color3.fromRGB(158,113,51))) then p:Destroy() end
    end
    local function split(wall: BasePart,holes: {{number}})
        local bottom,top=wall.Position.Y-wall.Size.Y/2,wall.Position.Y+wall.Size.Y/2
        local start,finish=wall.Position.Z-wall.Size.Z/2,wall.Position.Z+wall.Size.Z/2
        local function panel(z0: number,z1: number,y0: number,y1: number)
            if z1-z0&lt;0.01 or y1-y0&lt;0.01 then return end
            local p=wall:Clone() p.Name=wall.Name.."Segment"
            p.Size,p.Position=Vector3.new(wall.Size.X,y1-y0,z1-z0),Vector3.new(wall.Position.X,(y0+y1)/2,(z0+z1)/2)
            p:SetAttribute("BlocksNavigation",true) p.Parent=map
        end
        table.sort(holes,function(a,b) return a[1]&lt;b[1] end)
        local cursor=start
        for _,h in holes do
            local z0,z1=h[1]-h[2]/2,h[1]+h[2]/2
            panel(cursor,z0,bottom,top) panel(z0,z1,bottom,h[3]) panel(z0,z1,h[4],top)
            -- Preserve original collision and monster sight semantics while allowing the camera view.
            local barrier=wall:Clone() barrier.Name="WindowBarrier"
            barrier.Size,barrier.Position=Vector3.new(wall.Size.X,h[4]-h[3],h[2]),Vector3.new(wall.Position.X,(h[3]+h[4])/2,h[1])
            barrier.Transparency,barrier.CanCollide,barrier.CanQuery=1,true,true
            barrier:SetAttribute("BlocksNavigation",true) barrier.Parent=folder
            cursor=z1
        end
        panel(cursor,finish,bottom,top) wall:Destroy()
    end
    local function window(prefix: string,side: number,z: number,base: number)
        local w,h,columns=if prefix=="Bedroom" then 4.4 else 6.6,if prefix=="Bedroom" then 5.4 else 5.8,if prefix=="Bedroom" then 2 else 3
        local cf=CFrame.new(side*48,base,z)*CFrame.Angles(0,-side*math.pi/2,0)
        -- Extend just the native reveal to match the existing one-stud wall thickness.
        local fallback: {Instance}={}
        for _,x in {-w/2+0.14,w/2-0.14} do
            local p=Props.part(folder,"FallbackWindowFrame",Vector3.new(0.28,h,0.7),cf*CFrame.new(x,0.25+h/2,0),Color3.fromRGB(66,34,20)) table.insert(fallback,p)
        end
        for _,y in {0.39,0.25+h-0.14} do
            local p=Props.part(folder,"FallbackWindowFrame",Vector3.new(w,0.28,0.7),cf*CFrame.new(0,y,0),Color3.fromRGB(66,34,20)) table.insert(fallback,p)
        end
        for _,x in {-w/2+0.06,w/2-0.06} do
            Props.part(folder,"WindowReveal",Vector3.new(0.12,h,1),cf*CFrame.new(x,0.25+h/2,0),Color3.fromRGB(80,43,25))
        end
        add(prefix.."WindowFrame",cf,nil,fallback,nil,nil)
        add(prefix.."CurtainPair",cf,nil,nil,nil,nil)
        local iw,ih=w-0.56,h-0.56
        for i=0,columns-1 do for j=0,2 do
            local glass=Props.part(folder,"ClearWindowPane",Vector3.new(iw/columns-0.07,ih/3-0.07,0.025),
                cf*CFrame.new(-iw/2+iw*(i+0.5)/columns,0.53+ih*(j+0.5)/3,-0.065),Color3.fromRGB(190,207,216),Enum.Material.Glass)
            glass.Transparency,glass.Reflectance,glass.CastShadow=0.9,0.02,false
        end end
    end
    local ground={}
    for _,p in map:GetChildren() do
        if p:IsA("BasePart") and (p.Name=="WestWall" or p.Name=="EastWall") then table.insert(ground,p) end
    end
    for _,wall in ground do
        local side=if wall.Position.X&lt;0 then -1 else 1
        local a,b=if side&lt;0 then -28 else -27,if side&lt;0 then 26 else 27
        split(wall,{{a,4.4,4.05,9.45},{b,6.6,4.05,9.85}})
        window("Bedroom",side,a,3.8) window("Pub",side,b,3.8)
    end
    local upper={}
    for _,p in map:GetChildren() do if p:IsA("BasePart") and p.Name=="GuestOuterWall" then table.insert(upper,p) end end
    for _,wall in upper do
        local side=if wall.Position.X&lt;0 then -1 else 1
        local holes={}
        for _,z in {-30,-10,10,30} do table.insert(holes,{z,4.4,20.25,25.65}) end
        split(wall,holes)
        for _,z in {-30,-10,10,30} do window("Bedroom",side,z,20) end
    end
    folder:SetAttribute("WindowCount",12)
end
return Windows
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_34">
        <Properties>
          <string name="Name">TavernArchitecture</string>
          <string name="Source">--!strict
-- A coherent inn facade over the tested runtime shell. No new walking obstacles.
local Props=require(script.Parent.PubProps)
local Architecture={}
function Architecture.build(map: Folder)
    local facade=map.Exterior.PubFrontage
    local decor=Instance.new("Folder") decor.Name="TavernArchitecture"
    local oak=Color3.fromRGB(43,30,26)
    local iron=Color3.fromRGB(40,43,48)
    local slate=Color3.fromRGB(45,49,62)
    local stone=Color3.fromRGB(111,105,99)
    local function p(name: string,size: Vector3,cf: CFrame,color: Color3,material: Enum.Material?): Part
        return Props.part(decor,name,size,cf,color,material)
    end
    local function beam(name: string,a: Vector3,b: Vector3,width: number,color: Color3)
        return p(name,Vector3.new(width,width,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),color)
    end
    -- Warm limewash and a framed side elevation read clearly from the parked car.
    for _,wall in map:GetChildren() do
        if wall:IsA("BasePart") and (wall.Name=="LoungeSouthWall" or wall.Name=="LoungeWestWall" or wall.Name=="LoungeEastWall" or wall.Name=="FrontDoorLintel") then
            wall.Color,wall.Material=Color3.fromRGB(133,123,108),Enum.Material.Plaster
        end
    end
    for _,z in {41,56,72,87} do
        p("SideElevationPost",Vector3.new(.6,29,.7),CFrame.new(-8.65,15,z),oak)
    end
    for _,y in {2,15.8,29.5} do p("SideElevationRail",Vector3.new(.6,.55,48),CFrame.new(-8.65,y,64),oak) end
    for _,span in {{42,55},{57,71},{73,86}} do
        for _,base in {3,17} do
            beam("SideElevationBrace",Vector3.new(-8.68,base,span[1]),Vector3.new(-8.68,base+11,span[2]),.4,oak)
        end
        p("SideStoneBase",Vector3.new(.5,1.3,span[2]-span[1]),CFrame.new(-8.65,1.15,(span[1]+span[2])/2),stone,Enum.Material.Cobblestone)
    end
    -- Replace the small flat canopy with a proper projecting, timber-framed gable.
    local old=map.ExteriorFinishes:FindFirstChild("SlateEntranceCanopy") if old then old:Destroy() end
    local angle=math.atan(5/7)
    for _,side in {-1,1} do
        local roof=p("PorchSlateRoof",Vector3.new(math.sqrt(74)+.5,.35,5.8),CFrame.new(6+side*3.5,14.5,91.3)*CFrame.Angles(0,0,-side*angle),slate,Enum.Material.Slate)
        roof.CanQuery=true -- rain cover and camera avoidance under the new porch
        for _,z in {88.6,94.1} do
            beam("PorchBargeboard",Vector3.new(6+side*7,12,z),Vector3.new(6,17,z),.42,oak)
        end
        beam("PorchWallBracket",Vector3.new(6+side*6.6,9.4,89),Vector3.new(6+side*6.6,12,93.5),.32,oak)
        beam("PorchKingBrace",Vector3.new(6+side*5.5,12,94),Vector3.new(6,16,94),.2,oak)
    end
    beam("PorchRidge",Vector3.new(6,17.2,88.4),Vector3.new(6,17.2,94.4),.45,iron)
    beam("PorchTie",Vector3.new(-1,12,94),Vector3.new(13,12,94),.4,oak)
    beam("PorchKingPost",Vector3.new(6,12,94),Vector3.new(6,17,94),.3,oak)
    -- Give the brand its own clear bay, away from the porch and entrance prompts.
    local brand=facade.FrontPubName :: BasePart
    brand.Size,brand.Position=Vector3.new(29,2.5,.35),Vector3.new(30,13,89.25)
    for _,x in {15,45} do p("BrandBoardCorbel",Vector3.new(.5,3,.7),CFrame.new(x,12.8,89.2),oak) end
    -- Retire the duplicate exterior board; the hanging sign and fascia carry the name.
    local duplicate=map.OutsideSign :: BasePart duplicate.Transparency=1
    for _,gui in duplicate:GetChildren() do if gui:IsA("SurfaceGui") then gui.Enabled=false end end
    -- Layered front window cases and individual sill brackets, with clear glazing.
    for _,row in {{-2,7,5},{25,7,7},{40,7,7},{6,23,6},{25,23,6},{40,23,6}} do
        local x,y,w=row[1],row[2],row[3]
        for _,side in {-1,1} do
            p("WindowCarvedJamb",Vector3.new(.25,6.2,.65),CFrame.new(x+side*(w/2+.25),y-.7,89.25),oak)
            p("SillBracket",Vector3.new(.4,.7,.55),CFrame.new(x+side*(w/2-.5),y-4.45,89),stone,Enum.Material.Slate)
        end
        beam("WindowHoodMould",Vector3.new(x-w/2-.4,y+2.2,89.1),Vector3.new(x,y+5.35,89.1),.24,stone)
        beam("WindowHoodMould",Vector3.new(x,y+5.35,89.1),Vector3.new(x+w/2+.4,y+2.2,89.1),.24,stone)
    end
    -- Bargeboards, ridge caps and eaves give the long roof a finished silhouette.
    for _,g in {{20,88.95,28,7},{0,40.95,48,12},{0,-40.95,48,12}} do
        for _,side in {-1,1} do
            beam("RoofBargeboard",Vector3.new(g[1]+side*(g[3]+.5),29.9,g[2]),Vector3.new(g[1],30+g[4]+.25,g[2]),.75,oak)
        end
        beam("GableKingPost",Vector3.new(g[1],30,g[2]),Vector3.new(g[1],30+g[4],g[2]),.55,oak)
        for _,side in {-1,1} do
            beam("GableFanBrace",Vector3.new(g[1]+side*g[3]*.65,30,g[2]),Vector3.new(g[1],30+g[4]*.72,g[2]),.28,oak)
        end
    end
    for z=-39,39,6 do p("MainRidgeCap",Vector3.new(.85,.5,5.9),CFrame.new(0,42.5,z),iron,Enum.Material.Slate) end
    for z=44,86,6 do p("LoungeRidgeCap",Vector3.new(.8,.5,5.9),CFrame.new(20,37.5,z),iron,Enum.Material.Slate) end
    for _,side in {-1,1} do
        p("MainGutter",Vector3.new(.55,.45,82),CFrame.new(side*49,29.9,0),iron,Enum.Material.Metal)
        p("LoungeGutter",Vector3.new(.5,.4,49),CFrame.new(20+side*29,29.8,65),iron,Enum.Material.Metal)
        for _,z in {-39,39} do
            p("CastIronDownpipe",Vector3.new(.3,28,.3),CFrame.new(side*49,15,z),iron,Enum.Material.Metal)
            for _,y in {5,14,24} do p("PipeClip",Vector3.new(.6,.14,.45),CFrame.new(side*49,y,z),iron,Enum.Material.Metal) end
        end
    end
    -- Upgrade the swinging sign itself so the relief moves with the existing wind sway.
    local sign=facade.HangingPubSign :: Model
    local function signPart(name: string,size: Vector3,pos: Vector3,color: Color3,material: Enum.Material?)
        return Props.part(sign,name,size,CFrame.new(pos),color,material)
    end
    for _,x in {-4.7,3.7} do signPart("SignCarvedUpright",Vector3.new(.3,4.7,.6),Vector3.new(x,11,100),oak) end
    for _,y in {8.7,13.3} do signPart("SignCarvedRail",Vector3.new(8.8,.35,.6),Vector3.new(-.5,y,100),oak) end
    signPart("SignCrown",Vector3.new(5,.3,.5),Vector3.new(-.5,13.65,100),iron,Enum.Material.Metal)
    for _,x in {-4.65,3.65} do
        for _,y in {8.75,13.25} do
            local stud=signPart("SignBrassStud",Vector3.new(.17,.17,.7),Vector3.new(x,y,100),Color3.fromRGB(170,132,70),Enum.Material.Metal)
            stud.Shape=Enum.PartType.Ball
        end
    end
    -- Remove the extra advertising plaque above the door to reduce competing signage.
    local lodging=facade.RoomsAvailable :: BasePart lodging.Transparency=1
    for _,gui in lodging:GetChildren() do if gui:IsA("SurfaceGui") then gui.Enabled=false end end
    -- Door face detailing follows its existing swing automatically through SurfaceGuis.
    local door=map.FrontDoor :: BasePart door.Color=oak
    for _,face in {Enum.NormalId.Front,Enum.NormalId.Back} do
        local gui=Instance.new("SurfaceGui") gui.Name="CarvedDoorFace" gui.Face,gui.LightInfluence=face,1
        gui.SizingMode,gui.PixelsPerStud,gui.Parent=Enum.SurfaceGuiSizingMode.PixelsPerStud,40,door
        for column=0,1 do for row=0,1 do
            local panel=Instance.new("Frame") panel.Size,panel.Position=UDim2.fromScale(.36,.36),UDim2.fromScale(.09+column*.46,.09+row*.46)
            panel.BackgroundColor3,panel.BorderSizePixel,panel.Parent=Color3.fromRGB(64,40,28),0,gui
            local stroke=Instance.new("UIStroke") stroke.Color,stroke.Thickness,stroke.Parent=Color3.fromRGB(92,64,40),2,panel
        end end
    end
    decor.Parent=map
end
return Architecture
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAssetIntegration0_35">
        <Properties>
          <string name="Name">TavernSigns</string>
          <string name="Source">--!strict
-- Shared sign finish; preserves wording, prompts and physical board placement.
local Signs={}
local brass=Color3.fromRGB(188,161,106)
local ivory=Color3.fromRGB(240,223,188)
local oak=Color3.fromRGB(33,26,25)
local function shape(parent: Instance,name: string,pos: UDim2,size: UDim2,color: Color3,rotation: number?): Frame
    local f=Instance.new("Frame") f.Name,f.Position,f.Size=name,pos,size
    f.AnchorPoint,f.BorderSizePixel,f.BackgroundColor3=Vector2.new(.5,.5),0,color
    f.Rotation,f.Parent=rotation or 0,parent
    local round=Instance.new("UICorner") round.CornerRadius=UDim.new(.5,0) round.Parent=f
    return f
end
local function firefly(surface: SurfaceGui,fascia: boolean?)
    local art=Instance.new("Frame") art.Name="FireflyIllustration"
    art.Position,art.Size,art.BackgroundTransparency=UDim2.fromScale(if fascia then .04 else .1,.18),UDim2.fromScale(if fascia then .12 else .28,.64),1 art.Parent=surface
    local ratio=Instance.new("UIAspectRatioConstraint") ratio.AspectRatio,ratio.DominantAxis,ratio.Parent=1,Enum.DominantAxis.Height,art
    -- Symmetric engraved wings, dark thorax and a luminous golden abdomen.
    for _,side in {-1,1} do
        local wing=shape(art,"EngravedWing",UDim2.fromScale(.5+side*.2,.4),UDim2.fromScale(.27,.57),brass,side*28)
        local line=Instance.new("UIStroke") line.Color,line.Thickness,line.Parent=ivory,2,wing
        shape(art,"Antenna",UDim2.fromScale(.5+side*.09,.08),UDim2.fromScale(.025,.18),brass,side*35)
    end
    shape(art,"AbdomenGlow",UDim2.fromScale(.5,.78),UDim2.fromScale(.24,.28),Color3.fromRGB(224,193,94))
    shape(art,"Thorax",UDim2.fromScale(.5,.42),UDim2.fromScale(.13,.42),Color3.fromRGB(63,51,35))
    shape(art,"Head",UDim2.fromScale(.5,.19),UDim2.fromScale(.16,.15),ivory)
end
-- Native version of the refined Blender cartouche, keeping live sign text editable.
local function frame(parent: Instance,name: string,pos: UDim2,size: UDim2,color: Color3,z: number): Frame
    local f=Instance.new("Frame")
    f.Name,f.Position,f.Size,f.BackgroundColor3=name,pos,size,color
    f.BorderSizePixel,f.ZIndex,f.Parent=0,z,parent
    return f
end
local function finish(surface: SurfaceGui,board: BasePart)
    local previous=surface:FindFirstChild("RefinedSignFace")
    if previous then previous:Destroy() end
    -- Remove the previous native finish, including its separate firefly art.
    for _,name in {"OakSignFace","BrassBorder","FireflyIllustration"} do
        local old=surface:FindFirstChild(name) if old then old:Destroy() end
    end
    local root=frame(surface,"RefinedSignFace",UDim2.fromScale(0,0),UDim2.fromScale(1,1),Color3.fromRGB(66,34,20),0)
    frame(root,"OakMoulding",UDim2.fromScale(.012,.045),UDim2.fromScale(.976,.91),Color3.fromRGB(93,52,30),0)
    frame(root,"EnamelInset",UDim2.fromScale(.025,.09),UDim2.fromScale(.95,.82),Color3.fromRGB(31,25,29),0)
    local width,height=board.Size.X*80,board.Size.Y*80
    -- Pixel-space lengths preserve chamfer angles on both broad and narrow boards.
    local function line(name: string,x1: number,y1: number,x2: number,y2: number,thickness: number)
        local dx,dy=(x2-x1)*width,(y2-y1)*height
        local f=frame(root,name,UDim2.fromOffset((x1+x2)*width/2,(y1+y2)*height/2),UDim2.fromOffset(math.sqrt(dx*dx+dy*dy),thickness),brass,1)
        f.AnchorPoint,f.Rotation=Vector2.new(.5,.5),math.deg(math.atan2(dy,dx))
    end
    local x,y,cut=.045,.15,math.min(height*.07,width*.02)
    local cx,cy=cut/width,cut/height
    local points={{x+cx,y},{1-x-cx,y},{1-x,y+cy},{1-x,1-y-cy},{1-x-cx,1-y},{x+cx,1-y},{x,1-y-cy},{x,y+cy}}
    for i,p in points do
        local q=points[i%#points+1] line("CartoucheEdge",p[1],p[2],q[1],q[2],1.5)
    end
    for _,side in {-1,1} do
        local screw=frame(root,"BrassFixing",UDim2.fromScale(.5+side*.44,.5),UDim2.fromOffset(5,5),brass,1)
        screw.AnchorPoint=Vector2.new(.5,.5)
        local round=Instance.new("UICorner") round.CornerRadius,round.Parent=UDim.new(.5,0),screw
    end
    surface:SetAttribute("SignFinish","RefinedTavern")
    return root,line
end
function Signs.build(map: Folder)
    for _,gui in map:GetDescendants() do
        if not gui:IsA("SurfaceGui") then continue end
        local board=gui.Parent
        if not board or not board:IsA("BasePart") then continue end
        -- Papers and active control displays retain their own instructional treatment.
        if board.Name=="Warning" or board.Name=="CellarInstructions" or board.Name=="FadedWallpaper" or board.Name=="BedroomPlaqueLettering" then continue end
        local labels: {TextLabel}={}
        for _,child in gui:GetChildren() do if child:IsA("TextLabel") then table.insert(labels,child) end end
        if #labels==0 then continue end
        board.Color,board.Material=oak,Enum.Material.Wood
        gui.SizingMode,gui.PixelsPerStud=Enum.SurfaceGuiSizingMode.PixelsPerStud,80
        gui.LightInfluence,gui.Brightness=0,.9
        local root,line=finish(gui,board)
        for _,label in labels do
            label.BackgroundTransparency,label.TextColor3,label.TextStrokeTransparency=1,ivory,1
            label.Position,label.Size=UDim2.fromScale(.085,.27),UDim2.fromScale(.83,.46)
            label.TextWrapped,label.TextScaled,label.ZIndex=true,true,2
            local brand=board.Name=="PubName" or board.Name=="FrontPubName" or board.Name=="SignBoard" or board.Name=="OutsideSign"
            local short=not string.find(label.Text,"\n") and not string.find(label.Text,"/") and utf8.len(label.Text)&lt;=20
            label.FontFace=Font.new(if brand or short then "rbxasset://fonts/families/Fondamento.json" else "rbxasset://fonts/families/Nunito.json",Enum.FontWeight.Regular)
            if short and not brand then
                for _,y in {.23,.77} do
                    line("OrnamentRule",.17,y,.47,y,1)
                    line("OrnamentRule",.53,y,.83,y,1)
                    local diamond=frame(root,"DiamondInlay",UDim2.fromScale(.5,y),UDim2.fromOffset(4,4),brass,1)
                    diamond.AnchorPoint,diamond.Rotation=Vector2.new(.5,.5),45
                end
            end
            if board.Name=="SignBoard" then
                label.Text="THE FIREFLY\nTAVERN"
                label.Position,label.Size=UDim2.fromScale(.43,.25),UDim2.fromScale(.46,.45)
                firefly(gui)
                local closed=Instance.new("TextLabel") closed.Name="ClosedCaption"
                closed.BackgroundTransparency,closed.FontFace,closed.TextColor3=1,Font.new("rbxasset://fonts/families/Nunito.json"),brass
                closed.Text,closed.TextScaled,closed.Size,closed.Position="CLOSED",true,UDim2.fromScale(.28,.1),UDim2.fromScale(.52,.76)
                closed.ZIndex,closed.Parent=2,gui
            elseif board.Name=="FrontPubName" then
                label.Position,label.Size=UDim2.fromScale(.15,.27),UDim2.fromScale(.76,.46)
                firefly(gui,true)
            elseif not short then
                label.Position,label.Size=UDim2.fromScale(.085,.23),UDim2.fromScale(.83,.54)
            end
        end
    end
end
return Signs
</string>
        </Properties>
      </Item>
    </Item>
	</Item>
