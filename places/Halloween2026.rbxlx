			<Item class="ModuleScript" referent="RBX03e80c7ceab248e7ad142d3f64c4e812">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local Props = require(script.Parent.PubProps)
local Dressing = {}
local timber = Color3.fromRGB(36, 26, 24)
local brass = Color3.fromRGB(158, 113, 51)
local stone = Color3.fromRGB(79, 77, 85)
function Dressing.build(map: Folder)
    local decor = Instance.new("Folder")
    decor.Name = "GothicDressing"
    local function p(name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material?): Part
        return Props.part(decor, name, size, CFrame.new(position), color, material)
    end
    local function beam(a: Vector3, b: Vector3, width: number, color: Color3)
        return Props.part(decor, "GothicTimber", Vector3.new(width, width, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), color)
    end
    local function light(parent: BasePart, color: Color3, range: number, brightness: number, powered: boolean)
        local l = Instance.new("PointLight")
        l.Name = if powered then "PowerLight" else "Firelight"
        l.Color, l.Range, l.Brightness, l.Shadows = color, range, brightness, true
        l.Parent = parent
    end
    -- Keep the existing furniture blocks as invisible authoritative collision proxies.
    for _, object in map:GetChildren() do
        if object:IsA("Part") then
            if object.Name == "PubTable" or object.Name == "SnugTable" or object.Name == "OfficeDesk" then
                object.Transparency = 1
                Props.table(decor, CFrame.new(object.Position.X, 0.5, object.Position.Z), Vector3.new(object.Size.X / 7, 1, object.Size.Z / 6))
            elseif object.Name == "CellarBarrel" then
                object.Transparency = 1
                Props.barrel(decor, CFrame.new(object.Position.X, -15.5, object.Position.Z))
            elseif string.find(object.Name, "Wall") or object.Name == "OfficeSnugPartition" then
                object.Material, object.Color = Enum.Material.Plaster, Color3.fromRGB(107, 100, 110)
            elseif object.Name == "MainFloor" or object.Name == "EastFrontFloor" or object.Name == "EastBackFloor" then
                object.Color = Color3.fromRGB(59, 37, 29)
            end
        end
    end
    -- Chairs are tucked against their tables, outside the tested walking lanes.
    for _, x in {-17, 25} do
        Props.chair(decor, CFrame.new(x, 0.5, 33.3))
    end
    Props.chair(decor, CFrame.new(-41, 0.5, -3) * CFrame.Angles(0, -math.pi / 2, 0))
    Props.chair(decor, CFrame.new(-37, 0.5, -37.3) * CFrame.Angles(0, math.pi, 0))
    -- Bar front, carved panels and shelves; warning and bell retain their exact positions.
    local bar = map:FindFirstChild("Bar") :: Part
    bar.Color, bar.Material = timber, Enum.Material.Wood
    p("OakBarTop", Vector3.new(19, 0.22, 4.5), Vector3.new(-27, 4.5, 17), Color3.fromRGB(94, 49, 30))
    for _, x in {-34, -30.5, -27, -23.5, -20} do
        p("BarPanel", Vector3.new(2.9, 2.7, 0.15), Vector3.new(x, 2.6, 19.1), Color3.fromRGB(77, 38, 28))
        p("BarPanelInlay", Vector3.new(2.3, 0.08, 0.08), Vector3.new(x, 3.65, 19.22), brass, Enum.Material.Metal)
    end
    for _, y in {5.3, 7.5} do
        p("BackBarShelf", Vector3.new(15, 0.25, 1.4), Vector3.new(-28, y, 9.2), timber)
        for i = 0, 6 do
            local bottle = p("DustyBottle", Vector3.new(0.5, 1.3, 0.5), Vector3.new(-34 + i * 2, y + 0.8, 9.2), Color3.fromRGB(46, 67 + i * 3, 54), Enum.Material.Glass)
            bottle.Transparency = 0.15
            p("BottleNeck", Vector3.new(0.24, 0.45, 0.24), bottle.Position + Vector3.new(0, 0.85, 0), Color3.fromRGB(47, 69, 53), Enum.Material.Glass)
        end
    end
    -- Timber posts and wainscot are decorative, flush with the outer walls.
    for _, x in {-47.3, 47.3} do
        for _, z in {-38, -16, 7, 38} do p("OakPost", Vector3.new(0.7, 14, 0.8), Vector3.new(x, 7, z), timber) end
        p("WallDado", Vector3.new(0.28, 2.8, 78), Vector3.new(x, 1.9, 0), timber)
        p("BrassDadoRail", Vector3.new(0.4, 0.12, 78), Vector3.new(x, 3.35, 0), brass)
    end
    for _, z in {-39.3, 39.3} do
        for _, x in {-46, -16, 22, 46} do p("OakPost", Vector3.new(0.8, 14, 0.7), Vector3.new(x, 7, z), timber) end
    end
    for _, z in {-34, -8, 18, 36} do
        beam(Vector3.new(-48, 29.7, z), Vector3.new(0, 41.7, z), 0.85, timber)
        beam(Vector3.new(0, 41.7, z), Vector3.new(48, 29.7, z), 0.85, timber)
        beam(Vector3.new(-48, 13.2, z), Vector3.new(48, 13.2, z), 0.7, timber)
    end
    -- A vaulted slate roof closes the daylight opening without changing walking collision.
    local angle = math.atan(12 / 48)
    for _, side in {-1, 1} do
        local roof = p("SlateRoof", Vector3.new(math.sqrt(48 * 48 + 12 * 12) + 1, 0.8, 82), Vector3.new(side * 24, 36, 0), Color3.fromRGB(34, 33, 47), Enum.Material.Slate)
        roof.CFrame *= CFrame.Angles(0, 0, -side * angle)
        roof.CanQuery = true -- lets the third-person camera avoid the roof
    end
    -- Pointed stained-glass panels: blue/purple glass, lead tracery and brass corners.
    local function window(origin: CFrame)
        local function panel(name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material?)
            return Props.part(decor, name, size, origin * localCF, color, material)
        end
        panel("WindowRecess", Vector3.new(9.2, 10.2, 0.25), CFrame.new(0, 7.5, 0.08), timber)
        panel("StainedGlass", Vector3.new(7.6, 5.8, 0.1), CFrame.new(0, 6, -0.1), Color3.fromRGB(43, 60, 102), Enum.Material.Neon)
        panel("PointedGlass", Vector3.new(4.2, 4.2, 0.1), CFrame.new(0, 9.5, -0.12) * CFrame.Angles(0, 0, math.pi / 4), Color3.fromRGB(81, 47, 105), Enum.Material.Neon)
        for _, x in {-4.1, 0, 4.1} do panel("LeadMullion", Vector3.new(0.18, 6.2, 0.3), CFrame.new(x, 6, -0.25), timber, Enum.Material.Metal) end
        for _, y in {3, 6, 9} do panel("LeadCrossbar", Vector3.new(8.3, 0.16, 0.3), CFrame.new(0, y, -0.25), timber, Enum.Material.Metal) end
        for _, side in {-1, 1} do
            local a, b = origin:PointToWorldSpace(Vector3.new(side * 4.1, 9, -0.25)), origin:PointToWorldSpace(Vector3.new(0, 12.5, -0.25))
            beam(a, b, 0.28, brass)
        end
        for _, x in {-2, 2} do
            for _, y in {4.5, 7.5} do panel("GlassDiamond", Vector3.new(0.8, 0.8, 0.12), CFrame.new(x, y, -0.24) * CFrame.Angles(0, 0, math.pi / 4), Color3.fromRGB(116, 58, 87), Enum.Material.Neon) end
        end
    end
    for _, z in {-28, 26} do window(CFrame.new(-47.35, 0, z) * CFrame.Angles(0, -math.pi / 2, 0)) end
    for _, z in {-27, 27} do window(CFrame.new(47.35, 0, z) * CFrame.Angles(0, math.pi / 2, 0)) end
    -- A fireplace in the snug, flush to its far wall and away from the key route.
    p("FireplaceBacking", Vector3.new(1, 10, 11), Vector3.new(-46.5, 5.5, -3), stone, Enum.Material.Slate)
    p("FireplaceOpening", Vector3.new(0.2, 5, 6), Vector3.new(-45.9, 3.3, -3), Color3.fromRGB(17, 13, 18))
    for _, z in {-7, 1} do p("StoneFireplaceJamb", Vector3.new(1.5, 6, 1.4), Vector3.new(-45.3, 3.5, z), stone, Enum.Material.Slate) end
    p("StoneMantel", Vector3.new(2.2, 0.8, 10), Vector3.new(-45.3, 6.6, -3), stone, Enum.Material.Slate)
    p("Hearth", Vector3.new(3, 0.15, 10), Vector3.new(-45.3, 0.6, -3), stone, Enum.Material.Slate)
    local coal = p("GlowingCoals", Vector3.new(0.8, 0.3, 4), Vector3.new(-45.3, 1, -3), Color3.fromRGB(255, 105, 34), Enum.Material.Neon)
    local fire = Instance.new("Fire")
    fire.Size, fire.Heat = 3, 0
    fire.Color, fire.SecondaryColor = Color3.fromRGB(255, 156, 58), Color3.fromRGB(153, 52, 36)
    fire.Parent = coal
    light(coal, Color3.fromRGB(255, 160, 78), 24, 2.2, false)
    -- Candle chandeliers and wall sconces; all lights remain readable before power.
    for _, center in {Vector3.new(-10, 10.5, 27), Vector3.new(28, 10.5, 25), Vector3.new(-34, 10.5, -29), Vector3.new(-34, 10.5, -5)} do
        p("ChandelierStem", Vector3.new(0.12, 5, 0.12), center + Vector3.new(0, 2.5, 0), brass, Enum.Material.Metal)
        p("CandleArm", Vector3.new(4.6, 0.16, 0.16), center, brass, Enum.Material.Metal)
        for _, x in {-2, 0, 2} do
            p("WaxCandle", Vector3.new(0.28, 0.75, 0.28), center + Vector3.new(x, 0.45, 0), Color3.fromRGB(228, 207, 162))
            local flame = p("CandleFlame", Vector3.new(0.2, 0.4, 0.2), center + Vector3.new(x, 1, 0), Color3.fromRGB(255, 183, 82), Enum.Material.Neon)
            flame.Shape = Enum.PartType.Ball
            if x == 0 then light(flame, Color3.fromRGB(255, 189, 108), 27, 0.9, false) end
        end
    end
    -- Stair rails sit outside the walking lane and preserve the bright tread markers.
    for _, x in {25, 47} do
        beam(Vector3.new(x, 3.5, 7), Vector3.new(x, -11.5, -23), 0.22, brass)
        for step = 0, 15, 3 do
            p("StairBaluster", Vector3.new(0.14, 3, 0.14), Vector3.new(x, 2 - step, 7 - step * 2), timber, Enum.Material.Metal)
        end
    end
    -- Kitchen and office details, deliberately kept at the back of existing furniture.
    p("OfficeRunner", Vector3.new(8, 0.04, 3), Vector3.new(-37, 3.53, -33), Color3.fromRGB(93, 28, 46), Enum.Material.Fabric)
    for _, x in {-40, -39.3, -38.6} do p("OldLedger", Vector3.new(0.5, 1.2, 0.8), Vector3.new(x, 4.1, -34.5), Color3.fromRGB(73, 42, 38)) end
    p("KitchenWorktop", Vector3.new(6.2, 0.2, 20.2), Vector3.new(19, 3.6, -25), Color3.fromRGB(142, 135, 124), Enum.Material.Marble)
    local trim = p("ExitBrassHandle", Vector3.new(2, 0.25, 0.3), Vector3.new(-36, 5.5, 39.25), brass, Enum.Material.Metal)
    trim.Name = "ExitHandle"
    -- Original broad greybox light blocks become lantern fixtures.
    for _, object in map:GetChildren() do
        if object:IsA("Part") and object.Name == "PubLamp" then
            object.Color, object.Material, object.Transparency = brass, Enum.Material.Metal, 0
            local glow = p("LanternGlass", Vector3.new(0.8, 1.1, 0.8), object.Position - Vector3.new(0, 0.5, 0), Color3.fromRGB(255, 190, 100), Enum.Material.Neon)
            for _, side in {-1, 1} do p("LanternIron", Vector3.new(0.1, 1.4, 0.1), glow.Position + Vector3.new(side * 0.45, 0, 0.45), timber, Enum.Material.Metal) end
        end
    end
    decor.Parent = map
end
return Dressing
]]></ProtectedString>
					<string name="ScriptGuid">{ee6e68c7-2d05-4172-a64f-8a2a49f571b7}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">PubDressing</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1cc4a23d2efb10e70af0fd5700002ce0</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4cc81a2c6c854d9c88dcb911a4880f15">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Hand-authored extension of the disposable pub; original Studio geometry is untouched.
local Props = require(script.Parent.PubProps)
local Expansion = {}
local centers = {-30, -10, 10, 30}
function Expansion.build(map: Folder)
    local wood = Color3.fromRGB(59, 37, 29)
    local plaster = Color3.fromRGB(107, 100, 110)
    local brass = Color3.fromRGB(158, 113, 51)
    local function solid(name: string, size: Vector3, pos: Vector3, material: Enum.Material?): Part
        local p = Instance.new("Part")
        p.Name, p.Size, p.Position, p.Color = name, size, pos, plaster
        p.Material, p.Anchored, p.CanCollide = material or Enum.Material.Plaster, true, true
        p:SetAttribute("BlocksNavigation", not string.find(name, "Floor") and not string.find(name, "Step"))
        p.Parent = map
        return p
    end
    local decor = Instance.new("Folder")
    decor.Name = "GuestWingDressing"
    decor.Parent = map
    local function detail(name: string, size: Vector3, pos: Vector3, color: Color3, material: Enum.Material?): Part
        return Props.part(decor, name, size, CFrame.new(pos), color, material)
    end
    local function label(text: string, position: Vector3, rotation: number, width: number)
        local board = detail("GuestSign", Vector3.new(width, 1.7, 0.15), position, Color3.fromRGB(31, 23, 26))
        board.CFrame *= CFrame.Angles(0, rotation, 0)
        for _, face in {Enum.NormalId.Front, Enum.NormalId.Back} do
            local surface = Instance.new("SurfaceGui")
            surface.Face, surface.SizingMode = face, Enum.SurfaceGuiSizingMode.PixelsPerStud
            surface.PixelsPerStud, surface.LightInfluence = 60, 0
            surface.Parent = board
            local textLabel = Instance.new("TextLabel")
            textLabel.Size, textLabel.BackgroundTransparency = UDim2.fromScale(1, 1), 1
            textLabel.TextColor3, textLabel.Font = Color3.fromRGB(255, 225, 166), Enum.Font.GothamBold
            textLabel.TextScaled, textLabel.Text = true, text
            textLabel.Parent = surface
        end
    end
    local function lamp(position: Vector3)
        local base = detail("GuestLantern", Vector3.new(0.6, 0.9, 0.6), position, Color3.fromRGB(255, 190, 100), Enum.Material.Neon)
        local light = Instance.new("PointLight")
        light.Name, light.Color, light.Brightness, light.Range = "PowerLight", base.Color, 0.35, 30
        light.Shadows, light.Parent = true, base
    end
    -- The larger lounge occupies a south-east extension; the existing exit remains outdoors.
    local formerWall = map:FindFirstChild("SouthRight") :: Part
    formerWall.Size, formerWall.Position = Vector3.new(46, 14, 1), Vector3.new(-7, 7, 40)
    formerWall:SetAttribute("BlocksNavigation", true)
    solid("LoungeEntryWall", Vector3.new(8, 14, 1), Vector3.new(44, 7, 40))
    local floor = solid("LoungeFloor", Vector3.new(56, 1, 48), Vector3.new(20, 0, 64), Enum.Material.WoodPlanks)
    floor.Color = wood
    solid("LoungeWestWall", Vector3.new(1, 30, 48), Vector3.new(-8, 15, 64))
    solid("LoungeEastWall", Vector3.new(1, 30, 48), Vector3.new(48, 15, 64))
    solid("LoungeSouthWall", Vector3.new(56, 30, 1), Vector3.new(20, 15, 88))
    for _, name in {"JammedEntrance", "EntranceLabel", "OutsideSign"} do
        local object = map:FindFirstChild(name) :: BasePart
        object.Position += Vector3.new(0, 0, 48)
    end
    label("GUEST ROOMS — UPSTAIRS", Vector3.new(27, 10, 41), 0, 19)
    label("BAR  /  CELLAR", Vector3.new(6, 7, 41), 0, 12)
    label("ROOMS 1–8\nSTAIRS UP", Vector3.new(43, 6, 80), 0, 8)
    -- First-floor slab and broad landing. No slab is placed across the stair opening.
    local upper = solid("GuestFloor", Vector3.new(96, 1, 80), Vector3.new(0, 16, 0), Enum.Material.WoodPlanks)
    upper.Color = wood
    local landing = solid("GuestLandingFloor", Vector3.new(56, 1, 8), Vector3.new(20, 16, 44), Enum.Material.WoodPlanks)
    landing.Color = wood
    solid("GuestNorthWall", Vector3.new(97, 14, 1), Vector3.new(0, 23.5, -40))
    for _, x in {-48, 48} do solid("GuestOuterWall", Vector3.new(1, 14, 80), Vector3.new(x, 23.5, 0)) end
    for _, x in {-28, 28} do solid("GuestSouthWall", Vector3.new(40, 14, 1), Vector3.new(x, 23.5, 40)) end
    -- Ground floor and landing supply the end surfaces; do not overlay coplanar treads.
    for step = 0, 16 do
        local y, z = step, 78 - step * 2
        if step > 0 and step < 16 then
            solid("GuestStep", Vector3.new(24, 1, 2), Vector3.new(28, y, z), Enum.Material.WoodPlanks).Color = wood
        end
        detail("GuestStairEdge", Vector3.new(23, 0.06, 0.15), Vector3.new(28, y + 0.55, z - 0.85), brass, Enum.Material.Neon)
    end
    for _, x in {15.5, 40.5} do
        for step = 0, 16, 2 do
            detail("GuestBaluster", Vector3.new(0.15, 3, 0.15), Vector3.new(x, step + 2, 78 - step * 2), brass, Enum.Material.Metal)
        end
        local a, b = Vector3.new(x, 3.5, 78), Vector3.new(x, 19.5, 46)
        Props.part(decor, "GuestStairRail", Vector3.new(0.25, 0.25, (b-a).Magnitude), CFrame.lookAt((a+b)/2,b), brass)
        -- Stop the solid rail short of the landing so it cannot catch a turning avatar.
        local ga,gb=a-Vector3.new(0,1.3,0),b+Vector3.new(0,-2.3,2)
        local guard = solid("GuestStairGuard", Vector3.new(0.3, 3, (gb-ga).Magnitude), (ga+gb)/2)
        guard.CFrame = CFrame.lookAt(guard.Position, gb)
        guard.Transparency = 1
    end
    -- Guard the edges of the landing without obstructing the central stair mouth.
    for _, span in {{4, 24}, {44, 8}} do
        detail("LandingRail", Vector3.new(span[2], 0.3, 0.3), Vector3.new(span[1], 19.5, 47.5), brass)
        solid("GuestLandingGuard", Vector3.new(span[2],3,0.3), Vector3.new(span[1],18,47.5)).Transparency=1
        for x = span[1] - span[2]/2, span[1] + span[2]/2, 3 do
            detail("LandingBaluster", Vector3.new(0.15, 3, 0.15), Vector3.new(x, 18, 47.5), brass)
        end
    end
    -- Markers choose one fixed location per run; they are not collectible objects themselves.
    local locations = Instance.new("Folder")
    locations.Name, locations.Parent = "KeyLocations", map
    local function marker(name: string, position: Vector3)
        local spot = Instance.new("Part")
        spot.Name, spot.Size, spot.Position = name, Vector3.one, position
        spot.Anchored, spot.CanCollide, spot.CanTouch, spot.CanQuery, spot.Transparency = true, false, false, false, 1
        spot.Parent = locations
    end
    marker("Office", (map:FindFirstChild("OfficeKey") :: Part).Position)
    for sideIndex, side in {-1, 1} do
        -- Four separate doorways along each side of the sixteen-stud corridor.
        for roomIndex, z in centers do
            local number = (sideIndex - 1) * 4 + roomIndex
            for _, edge in {-1, 1} do
                solid("BedroomDoorWall", Vector3.new(1, 14, 4), Vector3.new(side * 8, 23.5, z + edge * 8))
            end
            solid("BedroomDoorLintel", Vector3.new(1, 3, 12), Vector3.new(side * 8, 29, z))
            label("ROOM " .. number, Vector3.new(side * 7.35, 25.8, z), math.pi/2, 9)
            -- Beds, dresser and wardrobe are kept against the outer half of each room.
            local bed = solid("BedroomBed", Vector3.new(4.6, 2.6, 7.1), Vector3.new(side * 40, 17.8, z + 3), Enum.Material.Wood)
            bed.Color = Color3.fromRGB(46, 28, 26)
            detail("IvoryMattress", Vector3.new(4.4, 0.65, 6.8), Vector3.new(side * 40, 18.6, z + 3), Color3.fromRGB(213, 197, 164), Enum.Material.Fabric)
            detail("BurgundyBedspread", Vector3.new(4.45, 0.2, 4.5), Vector3.new(side * 40, 19, z + 4), Color3.fromRGB(90 + number * 3, 28, 45), Enum.Material.Fabric)
            detail("IvoryPillow", Vector3.new(3.5, 0.4, 1.2), Vector3.new(side * 40, 19.1, z + 0.3), Color3.fromRGB(233, 219, 188), Enum.Material.Fabric)
            solid("BedroomHeadboard", Vector3.new(4.8, 3.8, 0.3), Vector3.new(side * 40, 18.4, z - 0.5), Enum.Material.Wood).Color = wood
            local dresser = solid("BedroomDresser", Vector3.new(5, 3, 2.4), Vector3.new(side * 25, 18, z - 6), Enum.Material.Wood)
            dresser.Color = wood
            for _, y in {17.2, 18.1, 19} do
                detail("DresserDrawer", Vector3.new(4.7, 0.7, 0.12), Vector3.new(side * 25, y, z - 4.75), Color3.fromRGB(89, 47, 30))
                detail("BrassDrawerHandle", Vector3.new(0.8, 0.1, 0.2), Vector3.new(side * 25, y, z - 4.6), brass, Enum.Material.Metal)
            end
            local wardrobe = solid("BedroomWardrobe", Vector3.new(4.3, 7, 2.7), Vector3.new(side * 43, 20, z - 6), Enum.Material.Wood)
            wardrobe.Color = wood
            detail("WardrobeBrass", Vector3.new(0.12, 1.2, 0.15), Vector3.new(side * 43, 20, z - 4.55), brass, Enum.Material.Metal)
            marker(string.format("Room%02d", number), Vector3.new(side * 25, 20, z - 5.6))
            lamp(Vector3.new(side * 23, 27, z))
        end
        for _, z in {-20, 0, 20} do solid("BedroomPartition", Vector3.new(40, 14, 1), Vector3.new(side * 28, 23.5, z)) end
    end
    for _, z in centers do
        lamp(Vector3.new(0, 27, z))
        detail("CorridorRunner", Vector3.new(8, 0.04, 18), Vector3.new(0, 16.53, z), Color3.fromRGB(83, 28, 44), Enum.Material.Fabric)
    end
    label("ROOMS 1–4  /  5–8", Vector3.new(0, 25.8, 39), 0, 16)
    lamp(Vector3.new(6, 11, 60))
    lamp(Vector3.new(28, 27, 62))
    lamp(Vector3.new(28, 7, 82))
    Props.table(decor, CFrame.new(-2, 0.5, 56))
    Props.chair(decor, CFrame.new(-2, 0.5, 60))
    -- Roof over the extension, separate from the raised roof over the eight bedrooms.
    for _, side in {-1, 1} do
        local roof = detail("LoungeRoof", Vector3.new(math.sqrt(28*28 + 7*7) + 1, 0.8, 48), Vector3.new(20 + side*14, 33.5, 65), Color3.fromRGB(34, 33, 47), Enum.Material.Slate)
        roof.CFrame *= CFrame.Angles(0, 0, -side * math.atan(7/28))
        roof.CanQuery = true
    end
end
function Expansion.addRoutes(positions: {Vector3}, edges: {{number}})
    local function node(position: Vector3): number
        table.insert(positions, position)
        return #positions
    end
    local function link(a: number, b: number) table.insert(edges, {a,b}) end
    local approach = node(Vector3.new(40,4.5,36))
    local entry = node(Vector3.new(28,4.5,36))
    local inner = node(Vector3.new(28,4.5,44))
    local near = node(Vector3.new(6,4.5,44))
    local south = node(Vector3.new(6,4.5,84))
    local bottom = node(Vector3.new(28,4.5,84))
    link(3,approach) link(approach,entry) link(entry,inner) link(inner,near) link(near,south) link(south,bottom)
    local previous = bottom
    for step = 0,16 do
        local current = node(Vector3.new(28,4.5+step,78-step*2))
        link(previous,current) previous=current
    end
    local landing = node(Vector3.new(28,20.5,44))
    local corridorEnd = node(Vector3.new(0,20.5,44))
    link(previous,landing) link(landing,corridorEnd)
    previous = corridorEnd
    for i = #centers,1,-1 do
        local z = centers[i]
        local hall = node(Vector3.new(0,20.5,z))
        link(previous,hall) previous=hall
        for _,side in {-1,1} do
            local door=node(Vector3.new(side*14,20.5,z))
            local room=node(Vector3.new(side*26,20.5,z))
            link(hall,door) link(door,room)
        end
    end
end
return Expansion
]]></ProtectedString>
