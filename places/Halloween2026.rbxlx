        <Item class="LocalScript" referent="RBXAssetIntegration1_2">
          <Properties>
            <string name="Name">AvatarFace</string>
            <string name="Source">--!strict
-- Only use the bundled face when the avatar's original head/face content actually fails.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local ContentProvider=game:GetService("ContentProvider")
if workspace:GetAttribute("LastOrdersGreybox")~=true then return end
local player=Players.LocalPlayer
local Visual=require(script.Parent.AvatarFaceVisual)
local generation=0
local connections: {RBXScriptConnection}={}
local assetConnections: {RBXScriptConnection}={}
local visual: any=nil
local function clear()
    generation+=1
    for _,c in connections do c:Disconnect() end connections={}
    for _,c in assetConnections do c:Disconnect() end assetConnections={}
    if visual then visual.clear() visual=nil end
end
local function attach(character: Model)
    clear() local token=generation
    local head=character:WaitForChild("Head",10)
    if not head or not head:IsA("BasePart") or character~=player.Character or token~=generation then return end
    visual=Visual.new(character,head)
    local revision=0
    local function watch()
        revision+=1 local currentRevision=revision
        for _,c in assetConnections do c:Disconnect() end assetConnections={}
        local meshId=""
        if head:IsA("MeshPart") then meshId=head.MeshId
        else local mesh=head:FindFirstChildOfClass("SpecialMesh") if mesh and mesh.MeshType==Enum.MeshType.FileMesh then meshId=mesh.MeshId end end
        local faceIds: {string}={}
        for _,face in head:GetChildren() do
            if face:IsA("Decal") and face.Face==Enum.NormalId.Front and face.Name~="LocalClassicFace" and face.Texture~="" then table.insert(faceIds,face.Texture) end
        end
        local ids=table.clone(faceIds) if meshId~="" then table.insert(ids,meshId) end
        local function failed(id: string): boolean
            local ok,status=pcall(function() return ContentProvider:GetAssetFetchStatus(id) end)
            return ok and (status.Name=="Failure" or status.Name=="TimedOut")
        end
        local function check()
            if currentRevision~=revision or token~=generation or not visual or character~=player.Character then return end
            if meshId~="" and failed(meshId) then visual.show(true) return end
            for _,id in faceIds do if failed(id) then visual.show(false) return end end
            visual.clear()
        end
        for _,id in ids do table.insert(assetConnections,ContentProvider:GetAssetFetchStatusChangedSignal(id):Connect(check)) end
        check()
        if #ids&gt;0 then task.spawn(function() pcall(function() ContentProvider:PreloadAsync(ids) end) check() end) end
    end
    if head:IsA("MeshPart") then table.insert(connections,head:GetPropertyChangedSignal("MeshId"):Connect(watch)) end
    table.insert(connections,head.ChildAdded:Connect(function(child) if child:IsA("Decal") and child.Name~="LocalClassicFace" then watch() end end))
    table.insert(connections,head.AncestryChanged:Connect(function() if not head:IsDescendantOf(character) then clear() end end))
    watch()
end
local added=player.CharacterAdded:Connect(attach)
local removed=player.CharacterRemoving:Connect(clear)
RunService:BindToRenderStep("LastOrdersAvatarFace",Enum.RenderPriority.Camera.Value+15,function() if visual then visual.update() end end)
if player.Character then task.spawn(attach,player.Character) end
script.Destroying:Connect(function() added:Disconnect() removed:Disconnect() clear() RunService:UnbindFromRenderStep("LastOrdersAvatarFace") end)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAssetIntegration1_3">
          <Properties>
            <string name="Name">AvatarFaceVisual</string>
            <string name="Source">--!strict
-- Local visual repair only; preserve the real head, joints, accessories and server hitbox.
local Visual={}
function Visual.new(character: Model,head: BasePart)
    local part: Part?=nil
    local decal: Decal?=nil
    local originalAlpha: number?=nil
    local hidden: {[Decal]: number}={}
    local mode: boolean?=nil
    local controller={}
    function controller.clear()
        if part then part:Destroy() part=nil end
        if decal then decal:Destroy() decal=nil end
        if originalAlpha~=nil and head.Parent then head.Transparency=originalAlpha end
        originalAlpha=nil
        for old,alpha in hidden do if old.Parent then old.Transparency=alpha end end
        hidden={} mode=nil
    end
    function controller.show(fullHead: boolean)
        if mode==fullHead and decal and decal.Parent then return end
        controller.clear() mode=fullHead
        local parent: Instance=head
        if fullHead then
            originalAlpha=head.Transparency head.Transparency=1
            local replacement=Instance.new("Part") replacement.Name="UnavailableHeadFallback"
            replacement.Anchored,replacement.CanCollide,replacement.CanTouch,replacement.CanQuery=true,false,false,false
            replacement.Size,replacement.Color,replacement.CFrame=head.Size,head.Color,head.CFrame
            replacement.Transparency,replacement.Massless=originalAlpha,true
            local mesh=Instance.new("SpecialMesh") mesh.MeshType,mesh.Scale,mesh.Parent=Enum.MeshType.Head,Vector3.one*1.25,replacement
            replacement.Parent=character part=replacement parent=replacement
        else
            for _,old in head:GetChildren() do
                if old:IsA("Decal") and old.Face==Enum.NormalId.Front then hidden[old]=old.Transparency old.Transparency=1 end
            end
        end
        local face=Instance.new("Decal") face.Name,face.Face,face.Texture="LocalClassicFace",Enum.NormalId.Front,"rbxasset://textures/face.png"
        face.Parent=parent decal=face
    end
    function controller.update()
        if part and part.Parent and head.Parent then
            part.CFrame,part.Color,part.Size=head.CFrame,head.Color,head.Size
            part.LocalTransparencyModifier=head.LocalTransparencyModifier
        end
    end
    return controller
end
return Visual
</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBXAssetIntegration1_4">
          <Properties>
            <string name="Name">Bell</string>
            <string name="Source">--!strict
-- Display only: cooldown and noise decisions remain on the server.
if workspace:GetAttribute("LastOrdersGreybox") ~= true then return end
local bell = workspace:WaitForChild("LastOrdersPrototype"):WaitForChild("Bell")
local prompt = bell:WaitForChild("ProximityPrompt") :: ProximityPrompt
while bell:IsDescendantOf(workspace) do
    local readyAt = bell:GetAttribute("ReadyAt")
    local remaining = if typeof(readyAt) == "number" then math.max(0, math.ceil(readyAt - workspace:GetServerTimeNow())) else 0
    prompt.ObjectText = if remaining &gt; 0 then "Bell · distraction ready in " .. remaining .. "s" else "Service bell"
    task.wait(0.2)
end
</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBXAssetIntegration1_5">
          <Properties>
            <string name="Name">CellarReveal</string>
            <string name="Source">--!strict
-- Deliberate, collision-checked reveal; fade masks the cut instead of spinning the player.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local TweenService=game:GetService("TweenService")
if workspace:GetAttribute("LastOrdersGreybox")~=true then return end
local player=Players.LocalPlayer
local monster=workspace:WaitForChild("LastOrdersPrototype"):WaitForChild("ChuggernaughtPlaceholder") :: BasePart
local gui=Instance.new("ScreenGui") gui.Name,gui.ResetOnSpawn,gui.DisplayOrder="AwakeningView",false,25
local fade=Instance.new("Frame") fade.Name,fade.Size,fade.BackgroundColor3,fade.BorderSizePixel="Fade",UDim2.fromScale(1,1),Color3.new(),0
fade.BackgroundTransparency,fade.Parent=1,gui gui.Parent=player:WaitForChild("PlayerGui")
local saved: CFrame?=nil
local subject: Instance?=nil
local eye=Vector3.zero
local tween: Tween?=nil
local function restore()
    if not saved then return end
    local camera=workspace.CurrentCamera
    if camera then
        local character=player.Character
        local live=if character then character:FindFirstChildOfClass("Humanoid") else nil
        camera.CFrame=saved camera.CameraSubject=live or subject camera.CameraType=Enum.CameraType.Custom
    end
    saved=nil
    if tween then tween:Cancel() end
    fade.BackgroundTransparency=0
    tween=TweenService:Create(fade,TweenInfo.new(.2),{BackgroundTransparency=1}) tween:Play()
end
RunService:BindToRenderStep("LastOrdersCellarReveal",Enum.RenderPriority.Camera.Value+1,function()
    local camera=workspace.CurrentCamera
    if not camera then return end
    if player:GetAttribute("LastOrdersRevealScene")~=true or not monster:IsDescendantOf(workspace) then restore() return end
    if not saved then
        saved,subject=camera.CFrame,camera.CameraSubject
        local focus=monster.Position+Vector3.new(0,1.5,0)
        local desired=monster.Position+monster.CFrame.LookVector*12+monster.CFrame.RightVector*4+Vector3.new(0,2.5,0)
        local cast=RaycastParams.new() cast.FilterType=Enum.RaycastFilterType.Exclude
        cast.FilterDescendantsInstances=if player.Character then {player.Character,monster} else {monster}
        local hit=workspace:Blockcast(CFrame.new(focus),Vector3.one*.6,desired-focus,cast)
        eye=if hit then hit.Position+hit.Normal*.6 else desired
        if (eye-focus).Magnitude&lt;5 then eye=monster.Position+Vector3.new(-8,2,5) end
    end
    camera.CameraType=Enum.CameraType.Scriptable
    local started=player:GetAttribute("LastOrdersSceneStarted")
    local duration=player:GetAttribute("LastOrdersSceneDuration")
    local elapsed=if typeof(started)=="number" then workspace:GetServerTimeNow()-started else 0
    local seconds=if typeof(duration)=="number" then duration else 4.5
    fade.BackgroundTransparency=math.min(math.clamp(elapsed/.2,0,1),math.clamp((seconds-elapsed)/.2,0,1))
    camera.CFrame=CFrame.lookAt(eye,monster.Position+Vector3.new(0,1.5,0))
end)
script.Destroying:Connect(function() restore() RunService:UnbindFromRenderStep("LastOrdersCellarReveal") gui:Destroy() end)
</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBXAssetIntegration1_6">
          <Properties>
            <string name="Name">Chuggernaught</string>
            <string name="Source">--!strict
local RunService=game:GetService("RunService")
local Players=game:GetService("Players")
if workspace:GetAttribute("LastOrdersGreybox")~=true then return end
local root=workspace:WaitForChild("LastOrdersPrototype"):WaitForChild("ChuggernaughtPlaceholder") :: BasePart
local Config=require(game.ReplicatedStorage:WaitForChild("HalloweenShared"):WaitForChild("Config"))
local rig=require(script.Parent.ChuggernaughtRig).new()
local Pose=require(script.Parent.ChuggernaughtPose)
local function sound(name: string,path: string,volume: number,pitch: number): Sound
    local s=Instance.new("Sound") s.Name,s.SoundId=name,path
    s.Volume,s.PlaybackSpeed,s.RollOffMaxDistance,s.RollOffMinDistance=volume,pitch,65,7
    s.Parent=root return s
end
-- Bundled Roblox sounds verified locally; no uploaded sound IDs or invented voice assets.
local stepSound=sound("HeavyFootsteps","rbxasset://sounds/action_footsteps_plastic.mp3",0.48,0.62)
local drinkSound=sound("TankardGlug","rbxasset://sounds/impact_water.mp3",0.42,0.65)
local grabSound=sound("GrabThud","rbxasset://sounds/action_footsteps_plastic.mp3",0.5,0.5)
local caption=Instance.new("BillboardGui")
caption.Name,caption.Size,caption.StudsOffsetWorldSpace="ChuggernaughtCaption",UDim2.fromOffset(260,50),Vector3.new(0,5.1,0)
caption.MaxDistance,caption.Adornee,caption.Parent=70,root,rig.model
local text=Instance.new("TextLabel")
text.Size,text.BackgroundTransparency=UDim2.fromScale(1,1),1
text.TextColor3,text.TextStrokeTransparency=Color3.fromRGB(255,224,170),0.15
text.Font,text.TextScaled,text.Parent=Enum.Font.GothamBold,true,caption
local displayed=root.Position
local last=displayed
local facing=Vector3.new(0,0,1)
local phase,lastStep,lastGlug=0,-1,-1
local previousMode=""
local lastFootfall=-math.huge
local mix=require(script.Parent.MonsterAudio).new(root,{stepSound,drinkSound,grabSound})
local lastChest: Vector3?=nil
local connection: RBXScriptConnection? = nil
connection=RunService.RenderStepped:Connect(function(dt: number)
    if not root:IsDescendantOf(workspace) then
        if connection then connection:Disconnect() end
        rig.destroy() stepSound:Destroy() drinkSound:Destroy() grabSound:Destroy() return
    end
    mix(Players.LocalPlayer.Character,dt)
    local mode=root:GetAttribute("MonsterMode")
    if typeof(mode)~="string" then mode="Dormant" end
    local started=root:GetAttribute("MonsterModeStarted")
    local elapsed=if typeof(started)=="number" then math.max(0,workspace:GetServerTimeNow()-started) else 0
    if mode~=previousMode then
        lastGlug=-1 previousMode=mode
        if mode=="Hold" then grabSound:Play() end
        if mode=="Dormant" then phase,lastStep=0,-1 lastChest=nil stepSound:Stop() drinkSound:Stop() grabSound:Stop() end
    end
    local targetPosition=root.Position
    if (targetPosition-displayed).Magnitude&gt;12 then displayed=targetPosition
    else displayed=displayed:Lerp(targetPosition,1-math.exp(-dt*20)) end
    local delta=displayed-last last=displayed
    local horizontal=Vector3.new(delta.X,0,delta.Z)
    local moving=horizontal.Magnitude&gt;0.001 and horizontal.Magnitude&lt;5
    if moving then
        facing=facing:Lerp(horizontal.Unit,math.clamp(dt*12,0,1))
        if facing.Magnitude&lt;0.01 then facing=horizontal.Unit end
        phase+=horizontal.Magnitude*2
    elseif mode=="Reveal" then
        local character=Players.LocalPlayer.Character
        local playerRoot=if character then character:FindFirstChild("HumanoidRootPart") else nil
        if playerRoot and playerRoot:IsA("BasePart") then
            local look=playerRoot.Position-root.Position local flat=Vector3.new(look.X,0,look.Z)
            if flat.Magnitude&gt;0.1 then facing=facing:Lerp(flat.Unit,math.clamp(dt*4,0,1)) end
        end
    else
        local look=root.CFrame.LookVector
        facing=facing:Lerp(Vector3.new(look.X,0,look.Z),math.clamp(dt*12,0,1))
    end
    if facing.Magnitude&lt;0.01 then facing=Vector3.zAxis end
    local feet=displayed-Vector3.new(0,4,0)
    local basis=CFrame.lookAt(feet,feet+facing.Unit)
    local duration=if mode=="Reveal" then Config.MonsterRevealSeconds
        elseif mode=="Grab" then Config.GrabWindupSeconds
        elseif mode=="Recover" then Config.GrabRecoverySeconds
        elseif mode=="Hold" then Config.PlayerHoldSeconds
        elseif mode=="Stunned" then Config.MonsterHitRecoverySeconds
        elseif mode=="Defeat" then Config.GameOverSeconds else Config.MonsterChugSeconds
    local alpha=if mode=="Dormant" then 1 elseif mode=="Reveal" then 1-math.clamp(elapsed/0.35,0,1) else 0
    local chest=root:GetAttribute("HeldChestPosition")
    if mode=="Hold" or mode=="Defeat" then
        local character=Players.LocalPlayer.Character
        local playerRoot=if character then character:FindFirstChild("HumanoidRootPart") else nil
        if playerRoot and playerRoot:IsA("BasePart") then chest=playerRoot.Position+Vector3.new(0,0.8,0) end
        if typeof(chest)=="Vector3" then lastChest=chest end
    elseif mode=="Stunned" then chest=lastChest end
    rig.pose(Pose.frames(basis,phase,moving,mode,elapsed,duration,if typeof(chest)=="Vector3" then chest else nil),alpha,basis)
    local beat=math.floor(phase/math.pi)
    if moving and beat~=lastStep and mode~="Dormant" and os.clock()-lastFootfall&gt;=.32 then
        lastFootfall=os.clock() stepSound:Play()
    end
    lastStep=beat
    if mode=="Reveal" or mode=="Chug" then
        local glug=math.floor((elapsed-0.85)/0.5)
        if glug&gt;=0 and glug&lt;3 and glug~=lastGlug then drinkSound:Play() lastGlug=glug end
    end
    text.Text=if mode=="Reveal" then "GLUG. GLUG. GLUG." elseif mode=="Grab" then "!"
        elseif mode=="Hold" then "GOT YOU!" elseif mode=="Stunned" then "…"
        elseif mode=="Search" and elapsed&lt;1.5 then "?"
        elseif mode=="Chase" and elapsed&lt;1.5 then "LAST ORDERS!" else ""
    caption.Enabled=text.Text~=""
end)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAssetIntegration1_7">
          <Properties>
            <string name="Name">ChuggernaughtPose</string>
            <string name="Source">--!strict
-- Joint poses in the original model's floor-centred coordinate space; no uploaded animations.
local Pose = {}
local function smooth(value: number): number
    local t=math.clamp(value,0,1)
    return t*t*(3-2*t)
end
local function rotation(from: Vector3, to: Vector3): CFrame
    local a,b=from.Unit,to.Unit
    local axis=a:Cross(b)
    if axis.Magnitude&lt;0.00001 then return CFrame.identity end
    return CFrame.fromAxisAngle(axis.Unit,math.acos(math.clamp(a:Dot(b),-1,1)))
end
local function rightArm(hand: Vector3): (CFrame,CFrame)
    local shoulder=Vector3.new(1.5,6,0)
    local upperBind,lowerBind=Vector3.new(0.5,-1.15,0),Vector3.new(0.05,-1.37,-0.09)
    local delta=hand-shoulder
    local distance=math.clamp(delta.Magnitude,0.1,upperBind.Magnitude+lowerBind.Magnitude-0.001)
    local direction=delta.Unit
    local outward=Vector3.xAxis-direction*direction:Dot(Vector3.xAxis)
    if outward.Magnitude&lt;0.01 then outward=Vector3.zAxis end
    local along=(upperBind.Magnitude^2+distance^2-lowerBind.Magnitude^2)/(2*distance)
    local height=math.sqrt(math.max(0,upperBind.Magnitude^2-along^2))
    local elbow=shoulder+direction*along+outward.Unit*height
    return CFrame.new(shoulder)*rotation(upperBind,elbow-shoulder), CFrame.new(elbow)*rotation(lowerBind,hand-elbow)
end
local function leftArm(hand: Vector3): (CFrame,CFrame)
    local shoulder=Vector3.new(-1.5,6,0)
    local upperBind,lowerBind=Vector3.new(-0.5,-1.15,0),Vector3.new(-0.05,-1.37,-0.09)
    local delta=hand-shoulder
    if delta.Magnitude&lt;0.01 then delta=Vector3.new(0,-1,0) end
    local distance=math.clamp(delta.Magnitude,0.1,upperBind.Magnitude+lowerBind.Magnitude-0.001)
    local direction=delta.Unit
    local outward=-Vector3.xAxis+direction*direction:Dot(Vector3.xAxis)
    if outward.Magnitude&lt;0.01 then outward=Vector3.zAxis end
    local along=(upperBind.Magnitude^2+distance^2-lowerBind.Magnitude^2)/(2*distance)
    local height=math.sqrt(math.max(0,upperBind.Magnitude^2-along^2))
    local elbow=shoulder+direction*along+outward.Unit*height
    local reached=shoulder+direction*distance
    return CFrame.new(shoulder)*rotation(upperBind,elbow-shoulder),CFrame.new(elbow)*rotation(lowerBind,reached-elbow)
end
function Pose.frames(feet: CFrame, phase: number, moving: boolean, mode: string, elapsed: number, duration: number, heldChest: Vector3?): {[string]: CFrame}
    local gait=if moving and mode~="Hold" and mode~="Defeat" then math.sin(phase) else 0
    local drink=0
    if mode=="Reveal" or mode=="Chug" then
        local amount=math.clamp(math.min(elapsed/0.8,(duration-elapsed)/0.7),0,1)
        drink=amount*amount*(3-2*amount)
    end
    local breath=math.sin(elapsed*2)*0.02
    local body=feet*CFrame.new(0,3.5+math.abs(gait)*0.035+breath,0)*CFrame.Angles(0,gait*0.025,-gait*0.015)*CFrame.new(0,-3.5,0)
    if mode=="Hold" then
        local reach=smooth(elapsed/0.24)
        local lift=smooth((elapsed-0.24)/0.31)
        local lower=smooth((elapsed-duration+0.4)/0.4)
        body*=CFrame.new(0,3.5,0)*CFrame.Angles(-0.13*reach*(1-lift)+0.06*lift*(1-lower),0,-0.035*reach*(1-lower))*CFrame.new(0,-3.5,0)
    end
    local standing=CFrame.new(3.4,2.35,-0.09)
    local drinking=CFrame.new(0.3,6.9,-0.8)*CFrame.Angles(0,math.pi,0)*CFrame.Angles(-1.1+math.sin(elapsed*12)*0.035,0,0)*CFrame.new(0,-2.15,0)
    local mug=standing:Lerp(drinking,drink)+Vector3.new(0,0,-math.sin(drink*math.pi)*0.6)
    local upper,lower=rightArm(mug:PointToWorldSpace(Vector3.new(-1.35,1.13,0)))
    local grab=if mode=="Grab" then math.clamp(elapsed/duration,0,1)
        elseif mode=="Recover" then 1-math.clamp(elapsed/duration,0,1) else 0
    local left=body*CFrame.new(-1.5,6,0)*CFrame.Angles(-gait*0.4+grab*1.5,0,0.04)
    local lowerLeft=left*CFrame.new(-0.5,-1.15,0)*CFrame.Angles(0.1,0,0)
    if mode=="Hold" or mode=="Defeat" then
        local target=if heldChest then body:PointToObjectSpace(heldChest) else Vector3.new(-1.7,5.4,-2.1)
        local upperHold,lowerHold=leftArm(target)
        local reach=body*CFrame.new(-1.5,6,0)*CFrame.Angles(1.5,0,0.04)
        local blend=if mode=="Defeat" then 1 else smooth(elapsed/0.18)
        left,lowerLeft=reach:Lerp(body*upperHold,blend),(reach*CFrame.new(-0.5,-1.15,0)*CFrame.Angles(0.1,0,0)):Lerp(body*lowerHold,blend)
    elseif mode=="Stunned" then
        left=body*CFrame.new(-1.5,6,0)*CFrame.Angles(0.25,0,0.15+math.sin(elapsed*5)*0.05)
        lowerLeft=left*CFrame.new(-0.5,-1.15,0)*CFrame.Angles(0.25,0,0)
        if heldChest and elapsed&lt;0.3 then
            local upperRelease,lowerRelease=leftArm(body:PointToObjectSpace(heldChest))
            left,lowerLeft=(body*upperRelease):Lerp(left,smooth(elapsed/0.3)),(body*lowerRelease):Lerp(lowerLeft,smooth(elapsed/0.3))
        end
    end
    return {
        Torso=body*CFrame.new(0,3.5,0),
        Head=body*CFrame.new(0,6.2,0)*CFrame.Angles(drink*0.14,0,0),
        UpperArmLeft=left,
        LowerArmLeft=lowerLeft,
        UpperArmRight=body*upper,LowerArmRight=body*lower,
        LegLeft=feet*CFrame.new(-0.73,3.3,0)*CFrame.Angles(gait*0.4,0,0),
        LegRight=feet*CFrame.new(0.73,3.3,0)*CFrame.Angles(-gait*0.4,0,0),
        Tankard=body*mug,
    }
end
return Pose
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAssetIntegration1_8">
          <Properties>
            <string name="Name">ChuggernaughtRig</string>
            <string name="Source">--!strict
-- Original GLB geometry in one client-only skinned mesh. No asset uploads.
local AssetService=game:GetService("AssetService")
local HttpService=game:GetService("HttpService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("HalloweenShared")
local Rig={}
export type Group={name: string,center: {number},joint: {number},size: {number},color: number,
    positions: {number},normals: {number},faces: {number},colors: {number}}
local function vector(values: {number}): Vector3 return Vector3.new(values[1],values[2],values[3]) end
local function configure(part: BasePart)
    part.Anchored,part.CanCollide,part.CanTouch,part.CanQuery=true,false,false,false
    part.CastShadow=true
end
function Rig.new()
    local data=HttpService:JSONDecode(require(Shared:WaitForChild("ChuggernaughtMeshData")))
    local model=Instance.new("Model") model.Name="Chuggernaught" model:SetAttribute("Rendering","Loading")
    local fallback: {[string]: BasePart}={}
    local groups: {[string]: Group}={}
    local liveBones: {[string]: Bone}={}
    local editable: EditableMesh?=nil
    local skin: MeshPart?=nil
    local center=Vector3.zero
    local alive=true
    for _,group: Group in data.groups do
        groups[group.name]=group
        local part=Instance.new("Part") part.Name,part.Size=group.name,vector(group.size)
        part.Color=Color3.new(table.unpack(data.palette[group.color]))
        part.Material,part.Transparency=Enum.Material.SmoothPlastic,1
        configure(part) part.Parent=model fallback[group.name]=part
    end
    model.Parent=workspace
    local controller={model=model}
    function controller.pose(frames: {[string]: CFrame},transparency: number,feet: CFrame)
        local mesh,part=editable,skin
        if mesh and part then
            part.CFrame,part.Transparency=feet*CFrame.new(center),transparency
            -- Keep EditableMesh bind-pose data fixed during animation.
            -- Named Bone instances drive the visible skin through their Transform property.
            for name,bone in liveBones do
                bone.Transform=bone.CFrame:ToObjectSpace(part.CFrame:ToObjectSpace(frames[name]))
            end
        else
            for name,partFallback in fallback do
                local group=groups[name]
                partFallback.CFrame=frames[name]*CFrame.new(vector(group.center)-vector(group.joint))
                partFallback.Transparency=transparency
            end
        end
    end
    function controller.destroy()
        alive=false model:Destroy()
        if editable then editable:Destroy() editable=nil end
    end
    task.spawn(function()
        local part: MeshPart?=nil
        local ok,err=pcall(function()
            local lo,hi=Vector3.new(math.huge,math.huge,math.huge),Vector3.new(-math.huge,-math.huge,-math.huge)
            for _,group: Group in data.groups do
                local c,s=vector(group.center),vector(group.size)/2
                lo=lo:Min(c-s) hi=hi:Max(c+s)
            end
            center=(lo+hi)/2
            local mesh=AssetService:CreateEditableMesh()
            assert(mesh,"Local editable mesh budget exhausted") editable=mesh
            local colors: {number}={}
            for _,rgb in data.palette do table.insert(colors,mesh:AddColor(Color3.new(table.unpack(rgb)),1)) end
            local uv=mesh:AddUV(Vector2.zero)
            local normalCache: {[string]: number}={}
            for _,group: Group in data.groups do
                if not alive then return end
                model:SetAttribute("BuildingGroup",group.name)
                local bone=mesh:AddBone({Name=group.name,CFrame=CFrame.new(vector(group.joint)-center),Virtual=false})
                local ids: {number},normals: {number}={},{}
                local vertexCache: {[string]: number}={}
                local c=vector(group.center)-center
                for i=1,#group.positions,3 do
                    local p,n=group.positions,group.normals
                    local pk=string.format("%.6f,%.6f,%.6f",p[i],p[i+1],p[i+2])
                    local nk=string.format("%.6f,%.6f,%.6f",n[i],n[i+1],n[i+2])
                    local id=vertexCache[pk]
                    if not id then
                        id=mesh:AddVertex(Vector3.new(p[i],p[i+1],p[i+2])+c)
                        vertexCache[pk]=id
                        mesh:SetVertexBones(id,{bone}) mesh:SetVertexBoneWeights(id,{1})
                    end
                    if not normalCache[nk] then normalCache[nk]=mesh:AddNormal(Vector3.new(n[i],n[i+1],n[i+2])) end
                    table.insert(ids,id) table.insert(normals,normalCache[nk])
                end
                for i=1,#group.faces,3 do
                    local a,b,cIndex=group.faces[i],group.faces[i+1],group.faces[i+2]
                    local face=mesh:AddTriangle(ids[a],ids[b],ids[cIndex])
                    mesh:SetFaceNormals(face,{normals[a],normals[b],normals[cIndex]})
                    mesh:SetFaceColors(face,{colors[group.colors[a]],colors[group.colors[b]],colors[group.colors[cIndex]]})
                    mesh:SetFaceUVs(face,{uv,uv,uv})
                end
                task.wait() -- one bounded group per frame
            end
            if not alive then return end
            mesh:RemoveUnused()
            -- Bones animate the skin; topology stays fixed, freeing room for shared scenery meshes.
            local compact=AssetService:CreateEditableMeshAsync(Content.fromObject(mesh),{FixedSize=true})
            assert(compact,"Character fixed-size mesh memory unavailable")
            mesh:Destroy() mesh=compact editable=compact
            part=AssetService:CreateMeshPartAsync(Content.fromObject(mesh),{CollisionFidelity=Enum.CollisionFidelity.Box})
            local built=part :: MeshPart
            built.Name,built.Size,built.Color="OriginalCharacterMesh",hi-lo,Color3.new(1,1,1)
            built.Material,built.DoubleSided,built.Transparency=Enum.Material.SmoothPlastic,true,1
            configure(built)
            for _,group: Group in data.groups do
                local bone=Instance.new("Bone")
                bone.Name=group.name
                bone.CFrame=CFrame.new(vector(group.joint)-center)
                bone.Parent=built
                liveBones[group.name]=bone
            end
        end)
        if not alive then if part then part:Destroy() end return end
        if not ok then
            if part then part:Destroy() end
            if editable then editable:Destroy() editable=nil end
            model:SetAttribute("Rendering","Fallback") model:SetAttribute("MeshError",tostring(err))
            warn("Chuggernaught mesh presentation unavailable; keeping fallback rig: "..tostring(err))
            return
        end
        assert(part)
        skin=part skin.Parent=model
        for _,old in fallback do old:Destroy() end table.clear(fallback)
        model:SetAttribute("Rendering","OriginalMesh")
        model:SetAttribute("TriangleCount",6449) model:SetAttribute("BoneCount",9)
    end)
    return controller
end
return Rig
</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBXAssetIntegration1_9">
          <Properties>
            <string name="Name">GrabCamera</string>
            <string name="Source">--!strict
-- Brief, collision-checked framing makes the hold visible; restore the player's view afterwards.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
if workspace:GetAttribute("LastOrdersGreybox")~=true then return end
local player=Players.LocalPlayer
local monster=workspace:WaitForChild("LastOrdersPrototype"):WaitForChild("ChuggernaughtPlaceholder") :: BasePart
local savedCamera: Camera?=nil
local savedFrame,savedFocus=CFrame.identity,CFrame.identity
local savedSubject: Instance?=nil
local started=0
local view=Vector3.zero
local visibility: {[BasePart]: number}={}
local characterReady=player.Character~=nil
local ray=RaycastParams.new() ray.FilterType,ray.RespectCanCollide=Enum.RaycastFilterType.Exclude,true
local function clearEye(focus: Vector3,eye: Vector3): Vector3
    local delta=eye-focus
    if delta.Magnitude&lt;0.01 then return eye end
    local hit=workspace:Raycast(focus,delta,ray)
    return if hit then focus+delta.Unit*math.max(0.2,hit.Distance-0.9) else eye
end
local function restore()
    local camera=savedCamera
    savedCamera=nil
    for part,alpha in visibility do if part.Parent then part.LocalTransparencyModifier=alpha end end
    visibility={}
    if camera and camera.Parent then
        local character=player.Character
        local subject=if savedSubject and savedSubject:IsDescendantOf(workspace) then savedSubject else if character then character:FindFirstChildOfClass("Humanoid") else nil
        camera.CameraSubject=subject
        camera.CFrame,camera.Focus,camera.CameraType=savedFrame,savedFocus,Enum.CameraType.Custom
    end
end
RunService:BindToRenderStep("LastOrdersGrabCamera",Enum.RenderPriority.Camera.Value+10,function()
    if not monster:IsDescendantOf(workspace) then restore() RunService:UnbindFromRenderStep("LastOrdersGrabCamera") return end
    local character=player.Character
    local camera=workspace.CurrentCamera
    if savedCamera and camera~=savedCamera then restore() end
    local held=player:GetAttribute("LastOrdersHeld")==true and monster:GetAttribute("MonsterMode")=="Hold"
    if not held or not characterReady or not character or not camera then if savedCamera then restore() end return end
    ray.FilterDescendantsInstances={character,monster}
    local basis=CFrame.new(monster.Position-Vector3.new(0,4,0))*monster.CFrame.Rotation
    local focus=basis:PointToWorldSpace(Vector3.new(-0.8,4.7,-0.9))
    if not savedCamera then
        if camera.CameraType~=Enum.CameraType.Custom then return end
        savedCamera,savedFrame,savedFocus,savedSubject=camera,camera.CFrame,camera.Focus,camera.CameraSubject
        started=os.clock()
        local distance=-1
        for _,offset in {Vector3.new(-9,6.2,-11),Vector3.new(9,6.2,-11),Vector3.new(0,6.8,-14)} do
            local candidate=clearEye(focus,basis:PointToWorldSpace(offset))
            local length=(candidate-focus).Magnitude
            if length&gt;distance then distance,view=length,candidate end
        end
        for _,part in character:GetDescendants() do
            if part:IsA("BasePart") then visibility[part]=part.LocalTransparencyModifier end
        end
        camera.CameraType=Enum.CameraType.Scriptable
    end
    local t=math.clamp((os.clock()-started)/0.2,0,1)
    local eye=clearEye(focus,savedFrame.Position:Lerp(view,t*t*(3-2*t)))
    -- Keep close first-person head geometry out of the lens while pulling back.
    for part in visibility do
        if part.Parent then part.LocalTransparencyModifier=if (part.Position-eye).Magnitude&lt;1.5 then 1 else 0 end
    end
    camera.CFrame,camera.Focus=CFrame.lookAt(eye,focus),CFrame.new(focus)
end)
player.CharacterRemoving:Connect(function() characterReady=false restore() end)
player.CharacterAdded:Connect(function() characterReady=true end)
script.Destroying:Connect(function() restore() RunService:UnbindFromRenderStep("LastOrdersGrabCamera") end)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAssetIntegration1_10">
          <Properties>
            <string name="Name">HealthDial</string>
            <string name="Source">--!strict
-- Two separated semicircles. Depleted health is outlined, not merely recoloured.
local UI=require(script.Parent.TavernUI)
local Dial={}
function Dial.new(gui: ScreenGui)
    local frame=UI.frame(gui,"HealthBar") frame.Size=UDim2.fromOffset(56,56) frame.AnchorPoint=Vector2.new(.5,1)
    local corner=frame:FindFirstChildOfClass("UICorner") if corner then corner.CornerRadius=UDim.new(.5,0) end
    local halves: {{Frame}}={{},{}}
    for half=1,2 do for i=1,22 do
        local angle=math.rad((half-1)*180+7+(i-1)*166/21)
        local segment=Instance.new("Frame") segment.Name="Half"..half.."Segment"..i
        segment.AnchorPoint,segment.Size=Vector2.new(.5,.5),UDim2.fromOffset(4,5)
        segment.Position,segment.Rotation=UDim2.fromOffset(28+math.sin(angle)*21,28-math.cos(angle)*21),math.deg(angle)
        segment.BorderSizePixel,segment.Parent=0,frame
        local stroke=Instance.new("UIStroke") stroke.Thickness,stroke.Color,stroke.Parent=1,UI.Muted,segment
        table.insert(halves[half],segment)
    end end
    local count=Instance.new("TextLabel") count.Name,count.Size,count.BackgroundTransparency="HealthCount",UDim2.fromScale(1,1),1
    count.FontFace,count.TextSize,count.TextColor3,count.Parent=UI.Body,18,UI.Ivory,frame
    local controller={frame=frame}
    function controller.update(health: number)
        count.Text=tostring(health)
        for half,segments in halves do for _,segment in segments do
            local filled=half&lt;=health
            segment.BackgroundTransparency=if filled then 0 else 1
            segment.BackgroundColor3=UI.Crimson
            local stroke=segment:FindFirstChildOfClass("UIStroke")
            if stroke then stroke.Transparency=if filled then .8 else .3 end
        end end
    end
    return controller
end
return Dial
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAssetIntegration1_11">
          <Properties>
            <string name="Name">HoldToSkip</string>
            <string name="Source">--!strict
local Input=game:GetService("UserInputService")
local RunService=game:GetService("RunService")
local UI=require(script.Parent.TavernUI)
local Hold={}
function Hold.new(gui: ScreenGui,player: Player)
    local remote=game.ReplicatedStorage.HalloweenShared:WaitForChild("SceneRequest") :: RemoteEvent
    local button=Instance.new("TextButton") button.Name="HoldToSkip" button.Text=""
    button.Size,button.Position=UDim2.fromOffset(200,48),UDim2.new(1,-212,0,12)
    button.BackgroundColor3,button.BackgroundTransparency,button.BorderSizePixel=UI.Ink,.04,0 button.Visible=false button.Parent=gui
    local label=Instance.new("TextLabel") label.Name="Label" label.Size,label.Position=UDim2.new(1,-52,1,0),UDim2.fromOffset(48,0)
    label.BackgroundTransparency,label.FontFace,label.TextSize,label.TextColor3=1,UI.Body,17,UI.Ivory
    label.Text,label.Parent="Hold to skip",button
    local segments: {Frame}={}
    for i=1,32 do
        local a=(i-1)/32*math.pi*2
        local s=Instance.new("Frame") s.Name="Progress"..i s.AnchorPoint=Vector2.new(.5,.5)
        s.Position,s.Size=UDim2.fromOffset(24+math.sin(a)*14,24-math.cos(a)*14),UDim2.fromOffset(3,4)
        s.Rotation,s.BorderSizePixel,s.BackgroundColor3,s.Parent=math.deg(a),0,UI.Muted,button table.insert(segments,s)
    end
    local held: InputObject?=nil
    local started=0
    local heldScene=""
    local sent=false
    local connections: {RBXScriptConnection}={}
    local function eligible(): boolean
        return player:GetAttribute("LastOrdersSceneSkippable")==true and player:GetAttribute("LastOrdersScene")~=""
    end
    local function cancel()
        if held then remote:FireServer("Cancel",heldScene) end
        held=nil started=0 sent=false
    end
    local function begin(input: InputObject)
        if held or not eligible() then return end
        held=input started=os.clock() sent=false heldScene=player:GetAttribute("LastOrdersScene") :: string
        remote:FireServer("Begin",heldScene)
    end
    table.insert(connections,button.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then begin(input) end
    end))
    table.insert(connections,Input.InputBegan:Connect(function(input,processed)
        if not processed and (input.KeyCode==Enum.KeyCode.Space or input.KeyCode==Enum.KeyCode.ButtonB) then begin(input) end
    end))
    table.insert(connections,Input.InputEnded:Connect(function(input)
        if input==held or (held and input.KeyCode==held.KeyCode and input.KeyCode~=Enum.KeyCode.Unknown) then cancel() end
    end))
    table.insert(connections,Input.InputChanged:Connect(function(input)
        if input==held and input.UserInputState==Enum.UserInputState.Cancel then cancel() end
        if input==held and input.UserInputType==Enum.UserInputType.Touch then
            local pos,size=button.AbsolutePosition,button.AbsoluteSize
            if input.Position.X&lt;pos.X or input.Position.X&gt;pos.X+size.X or input.Position.Y&lt;pos.Y or input.Position.Y&gt;pos.Y+size.Y then cancel() end
        end
    end))
    table.insert(connections,Input.WindowFocusReleased:Connect(cancel))
    table.insert(connections,player:GetAttributeChangedSignal("LastOrdersScene"):Connect(cancel))
    table.insert(connections,RunService.RenderStepped:Connect(function()
        button.Visible=eligible()
        if not button.Visible then cancel() end
        local progress=if held then math.clamp((os.clock()-started)/1.05,0,1) else 0
        for i,s in segments do s.BackgroundColor3=if i&lt;=math.floor(progress*32) then UI.Brass else Color3.fromRGB(70,62,55) end
        if held and progress&gt;=1 and not sent then sent=true remote:FireServer("Finish",heldScene) end
    end))
    return function() cancel() for _,c in connections do c:Disconnect() end button:Destroy() end
end
return Hold
</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBXAssetIntegration1_12">
          <Properties>
            <string name="Name">Journey</string>
            <string name="Source">--!strict
-- Short entrance reaction and car escape presentation; the server owns progression.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Input=game:GetService("UserInputService")
local Config=require(game.ReplicatedStorage:WaitForChild("HalloweenShared"):WaitForChild("Config"))
if workspace:GetAttribute("LastOrdersGreybox")~=true then return end
local player=Players.LocalPlayer
local gui=Instance.new("ScreenGui") gui.Name,gui.ResetOnSpawn,gui.DisplayOrder="LastOrdersJourney",false,30
local fade=Instance.new("Frame") fade.Size,fade.BackgroundColor3,fade.BackgroundTransparency=UDim2.fromScale(1,1),Color3.new(),1
fade.Parent=gui
local UI=require(script.Parent.TavernUI)
local title=UI.title(gui) title.Visible=false
local titleGroup=Instance.new("CanvasGroup") titleGroup.Name="ArrivalTitle" titleGroup.Size=UDim2.fromScale(1,1) titleGroup.BackgroundTransparency=1 titleGroup.Parent=gui title.Parent=titleGroup
local card=UI.ending(fade,false) card.Visible=false
local replay=Instance.new("TextButton") replay.Name="Replay"
replay.Size,replay.Text,replay.FontFace,replay.TextSize=UDim2.new(1,0,0,52),"Play again",UI.Body,20
replay.BackgroundColor3,replay.TextColor3,replay.AutoButtonColor=Color3.fromRGB(70,48,35),UI.Ivory,true
replay.BorderSizePixel,replay.LayoutOrder,replay.Parent=0,6,card
local corner=Instance.new("UICorner") corner.CornerRadius,corner.Parent=UDim.new(0,4),replay
local stroke=Instance.new("UIStroke") stroke.Color,stroke.Transparency,stroke.Parent=UI.Brass,.4,replay
gui.Parent=player:WaitForChild("PlayerGui")
replay.Activated:Connect(function() game.ReplicatedStorage.HalloweenShared:WaitForChild("RestartJourney"):FireServer() end)
local function faceEntrance()
    task.defer(function()
        local character=player.Character
        if not character then return end
        local root=character:WaitForChild("HumanoidRootPart",10)
        task.wait(.2)
        if not root or character~=player.Character or player:GetAttribute("LastOrdersStage")~=0 then return end
        local camera=workspace.CurrentCamera
        if camera then
            local direction=Vector3.new(6-root.Position.X,0,88-root.Position.Z).Unit
            camera.CFrame=CFrame.lookAt(root.Position-direction*10+Vector3.new(0,4,0),root.Position+direction*12)
        end
    end)
end
player.CharacterAdded:Connect(faceEntrance)
player:GetAttributeChangedSignal("LastOrdersStage"):Connect(function() if player:GetAttribute("LastOrdersStage")==0 then faceEntrance() end end)
faceEntrance()
local bars={}
for _,y in {0,.93} do
    local bar=Instance.new("Frame") bar.Name="CinemaBar" bar.Position,bar.Size=UDim2.fromScale(0,y),UDim2.fromScale(1,.07)
    bar.BackgroundColor3,bar.BorderSizePixel,bar.Visible,bar.Parent=Color3.new(),0,false,gui table.insert(bars,bar)
end
local caption=Instance.new("TextLabel") caption.Name="SceneCaption"
caption.Size,caption.Position=UDim2.fromScale(.86,.12),UDim2.fromScale(.07,.78)
caption.BackgroundTransparency,caption.FontFace,caption.TextSize,caption.TextWrapped=1,UI.Body,21,true
caption.TextColor3,caption.TextStrokeTransparency,caption.Visible,caption.Parent=UI.Ivory,.25,false,gui
local cleanupSkip=require(script.Parent.HoldToSkip).new(gui,player)
local previousType: Enum.CameraType?=nil
local previousSubject: Instance?=nil
local previousFrame=CFrame.identity
local lastScene=""
local sceneAt=0
local arrivalEnd: CFrame?=nil
local function restore()
    local camera=workspace.CurrentCamera
    if camera and previousType then
        local character=player.Character
        local live=if character then character:FindFirstChildOfClass("Humanoid") else nil
        camera.CameraType=previousType camera.CameraSubject=live or previousSubject camera.CFrame=previousFrame
    end
    previousType=nil
end
RunService:BindToRenderStep("LastOrdersJourney",Enum.RenderPriority.Camera.Value+2,function()
    local camera=workspace.CurrentCamera
    if not camera then return end
    local entry=player:GetAttribute("LastOrdersEntryScene")==true
    local driving=player:GetAttribute("LastOrdersDriving")==true
    local stage=player:GetAttribute("LastOrdersStage")
    local arrival=player:GetAttribute("LastOrdersArrivalScene")==true
    card.Visible=stage==7
    if stage==7 then fade.BackgroundColor3=UI.Ink end
    local scene=if arrival then "Arrival" elseif entry then "Entry" elseif driving then "Drive" else ""
    if scene~=lastScene then sceneAt=os.clock() lastScene=scene arrivalEnd=nil end
    caption.Visible=scene~="" and stage~=7
    for _,bar in bars do bar.Visible=caption.Visible end
    if scene=="" then title.Visible=false restore() fade.BackgroundTransparency=if stage==7 then 0 else 1 return end
    if not previousType then previousType,previousSubject,previousFrame=camera.CameraType,camera.CameraSubject,camera.CFrame end
    camera.CameraType=Enum.CameraType.Scriptable
    if arrival then
        local started=player:GetAttribute("LastOrdersSceneStarted")
        local elapsed=if typeof(started)=="number" then workspace:GetServerTimeNow()-started else os.clock()-sceneAt
        local t=math.clamp(elapsed/Config.ArrivalSceneSeconds,0,1)
        title.Visible=elapsed&lt;4.5
        titleGroup.GroupTransparency=math.clamp(math.max(1-elapsed/.45,(elapsed-3.6)/.9),0,1)
        if not arrivalEnd then
            local character=player.Character
            local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
            if root and root:IsA("BasePart") then
                local direction=Vector3.new(6-root.Position.X,0,88-root.Position.Z).Unit
                arrivalEnd=CFrame.lookAt(root.Position-direction*10+Vector3.new(0,4,0),root.Position+direction*12)
            else arrivalEnd=previousFrame end
        end
        local finish=arrivalEnd :: CFrame
        local establish=CFrame.lookAt(finish.Position+Vector3.new(0,4.5,5),Vector3.new(14,24,89))
        camera.CFrame=establish:Lerp(finish,t*t*(3-2*t))
        previousFrame=finish
        caption.Text=if t&lt;.4 then "The Firefly Tavern. Halloween night." elseif t&lt;.75 then "One dare: get the lights working." else "Find your way inside."

    elseif entry then
        title.Visible=false
        local map=workspace:FindFirstChild("LastOrdersPrototype")
        local started=if map then map:GetAttribute("EntranceCollapseStarted") else nil
        local elapsed=if typeof(started)=="number" then workspace:GetServerTimeNow()-started else os.clock()-sceneAt
        local t=math.clamp(elapsed/Config.EntrySceneSeconds,0,1)
        camera.CFrame=previousFrame:Lerp(CFrame.lookAt(previousFrame.Position,Vector3.new(6,5,88)),math.sin(t*math.pi)^2*.8)
        caption.Text="The entrance is blocked. Find another way out."
    else
        title.Visible=false
        -- Locate by model name so the camera also follows a translated test fixture.
        local car=workspace:FindFirstChild("BrokenDownCar",true)
        if car and car:IsA("Model") then
            local cf=car:GetPivot()
            local elapsed=os.clock()-sceneAt
            local boardView=CFrame.lookAt((cf*CFrame.new(-5,4,-9)).Position,cf.Position+Vector3.new(0,2,0))
            local escapeView=CFrame.lookAt((cf*CFrame.new(-15,8,-12)).Position,cf.Position+Vector3.new(0,2,0))
            local blend=math.clamp((elapsed-.4)/1.2,0,1)
            camera.CFrame=boardView:Lerp(escapeView,blend*blend*(3-2*blend))
            caption.Text="Go. Just go."
            fade.BackgroundTransparency=if stage==7 then 0 else math.clamp((Config.DriveSeconds-elapsed)/.8,0,1)
            if stage~=7 and elapsed&lt;.35 then fade.BackgroundTransparency=math.clamp(elapsed/.35,0,1) end
        end
        if stage==7 then fade.BackgroundTransparency=0 end
    end
end)
script.Destroying:Connect(function() cleanupSkip() RunService:UnbindFromRenderStep("LastOrdersJourney") restore() gui:Destroy() end)
</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBXAssetIntegration1_13">
          <Properties>
            <string name="Name">Loading</string>
            <string name="Source">--!strict
-- Brief presentation while replicated run state arrives; no extra start gate or fake progress.
local Players=game:GetService("Players")
local TweenService=game:GetService("TweenService")
if workspace:GetAttribute("LastOrdersGreybox")~=true then return end
local player=Players.LocalPlayer
local UI=require(script.Parent.TavernUI)
local gui=Instance.new("ScreenGui") gui.Name,gui.ResetOnSpawn,gui.DisplayOrder="LastOrdersLoading",false,80
local group=Instance.new("CanvasGroup") group.Size,group.BackgroundColor3=UDim2.fromScale(1,1),UI.Ink group.Parent=gui
local card=UI.title(group)
local status=UI.text(card,"LoadingStatus","Preparing the tavern…",UI.Body,16,UI.Muted,5)
status.TextXAlignment=Enum.TextXAlignment.Center
gui.Parent=player:WaitForChild("PlayerGui")
while player:GetAttribute("LastOrdersStage")==nil or not player.Character do
    task.wait(.1)
    if not gui.Parent then return end
end
local fade=TweenService:Create(group,TweenInfo.new(.35),{GroupTransparency=1})
fade:Play() fade.Completed:Wait() gui:Destroy()
</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBXAssetIntegration1_14">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source">--!strict
-- Compact objective strip, opt-in detail, and a separate short-lived feedback card.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Input=game:GetService("UserInputService")
local Config=require(game.ReplicatedStorage:WaitForChild("HalloweenShared"):WaitForChild("Config"))
local UI=require(script.Parent.TavernUI)
local player=Players.LocalPlayer
local gui=Instance.new("ScreenGui") gui.Name,gui.ResetOnSpawn="LastOrdersHUD",false
local panel=UI.frame(gui,"ObjectivePanel") panel.Position,panel.Size=UDim2.fromOffset(76,8),UDim2.new(1,-88,0,48)
local limit=Instance.new("UISizeConstraint") limit.MaxSize,limit.Parent=Vector2.new(340,48),panel
local heading=Instance.new("TextLabel") heading.Name="ObjectiveHeading"
heading.Size,heading.Position=UDim2.new(1,-62,1,0),UDim2.fromOffset(12,0)
heading.BackgroundTransparency,heading.FontFace,heading.TextSize,heading.TextColor3=1,UI.Heading,21,UI.Ivory
heading.TextXAlignment,heading.TextWrapped,heading.Parent=Enum.TextXAlignment.Left,true,panel
local toggle=Instance.new("TextButton") toggle.Name,toggle.Text="DetailsToggle","+"
toggle.Size,toggle.Position=UDim2.fromOffset(44,44),UDim2.new(1,-46,0,2)
toggle.BackgroundTransparency,toggle.FontFace,toggle.TextSize,toggle.TextColor3=1,UI.Body,26,UI.Brass toggle.Parent=panel
local icon=UI.frame(gui,"ObjectiveIcon") icon.Size,icon.Position=UDim2.fromOffset(56,56),UDim2.fromOffset(76,8)
local iconButton=Instance.new("TextButton") iconButton.Name,iconButton.Text,iconButton.Size="Objectives","",UDim2.fromScale(1,1)
iconButton.BackgroundTransparency,iconButton.Parent=1,icon
local page=Instance.new("Frame") page.Size,page.Position=UDim2.fromOffset(22,28),UDim2.fromOffset(17,14)
page.BackgroundTransparency,page.Parent=1,iconButton
local border=Instance.new("UIStroke") border.Color,border.Thickness,border.Parent=UI.Brass,2,page
for i=1,3 do
    local line=Instance.new("Frame") line.Size,line.Position=UDim2.fromOffset(13,2),UDim2.fromOffset(4,5+i*5)
    line.BackgroundColor3,line.BorderSizePixel,line.Parent=UI.Ivory,0,page
end
local details=UI.frame(gui,"ObjectiveDetails") details.Size,details.AutomaticSize=UDim2.new(1,-24,0,0),Enum.AutomaticSize.Y
details.Position=UDim2.fromOffset(12,76)
local detailLimit=Instance.new("UISizeConstraint") detailLimit.MaxSize,detailLimit.Parent=Vector2.new(340,600),details
UI.stack(details,12,6)
local drawerHeading=UI.text(details,"ObjectiveHeading","",UI.Heading,24,UI.Brass,0)
local detail=UI.text(details,"ObjectiveDetail","",UI.Body,18,UI.Ivory,1)
local circuits=UI.text(details,"Circuits","",UI.Body,16,UI.Brass,2)
local feedbackPanel=UI.frame(gui,"FeedbackCard") feedbackPanel.Size,feedbackPanel.AutomaticSize=UDim2.new(1,-24,0,0),Enum.AutomaticSize.Y
local feedbackLimit=Instance.new("UISizeConstraint") feedbackLimit.MaxSize,feedbackLimit.Parent=Vector2.new(340,600),feedbackPanel
UI.stack(feedbackPanel,12,0)
local feedback=UI.text(feedbackPanel,"Feedback","",UI.Body,17,UI.Ivory,1)
-- Notes are explicitly dismissed; reading them never freezes the hunt.
local note=UI.frame(gui,"ReadingPanel") note.AnchorPoint,note.Position=Vector2.new(.5,.5),UDim2.fromScale(.5,.5)
note.Size,note.AutomaticSize=UDim2.new(.88,0,0,0),Enum.AutomaticSize.Y note.Visible=false
local noteLimit=Instance.new("UISizeConstraint") noteLimit.MaxSize,noteLimit.Parent=Vector2.new(480,700),note
UI.stack(note,18,12)
UI.text(note,"Heading","A note from the tavern",UI.Heading,26,UI.Brass,1)
local noteText=UI.text(note,"Writing","",UI.Body,20,UI.Ivory,2)
local close=Instance.new("TextButton") close.Name,close.Text,close.Size="CloseNote","Close",UDim2.new(1,0,0,44)
close.FontFace,close.TextSize,close.TextColor3,close.BackgroundColor3=UI.Body,18,UI.Ivory,Color3.fromRGB(70,48,35)
close.LayoutOrder,close.Parent=3,note
local headings={[0]="Enter the tavern","Read the staff note","Restore power","Find the exit key","Unlock the exit","Run for the car","Leave the tavern","You survived"}
local expanded=false
local lastFeedback=""
local expandUntil,feedbackUntil=0,0
local oldStage: any=nil
local wasHidden=true
local noteSerial: any=nil
local function hidden(): boolean
    return player:GetAttribute("LastOrdersGameOver")==true or player:GetAttribute("LastOrdersDriving")==true
        or player:GetAttribute("LastOrdersEntryScene")==true or player:GetAttribute("LastOrdersArrivalScene")==true
        or player:GetAttribute("LastOrdersRevealScene")==true
end
local function update()
    local stage=player:GetAttribute("LastOrdersStage")
    if stage~=oldStage then oldStage=stage expanded=false expandUntil=os.clock()+4 note.Visible=false end
    heading.Text=if typeof(stage)=="number" then headings[stage] or "Last orders" else "The Firefly Tavern"
    detail.Text=if typeof(stage)=="number" then Config.Objectives[stage] or "" else "Waiting for the local prototype…"
    local character=player.Character
    local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
    local map=workspace:FindFirstChild("LastOrdersPrototype")
    local panelPart=if map then map:FindFirstChild("CellarFuseBox") else nil
    circuits.Visible=stage==2 and root~=nil and root:IsA("BasePart") and panelPart~=nil and panelPart:IsA("BasePart") and (root.Position-panelPart.Position).Magnitude&lt;20
    if circuits.Visible then
        local value=player:GetAttribute("CellarBreakerProgress")
        local count=if typeof(value)=="number" then value else 0
        circuits.Text="CIRCUITS "..count.." / 3  ·  "..(if count==3 then "MAIN LEVER READY" else "TRY THE CIRCUITS")
    end
    local phone=Input.TouchEnabled or (workspace.CurrentCamera~=nil and workspace.CurrentCamera.ViewportSize.X&lt;600)
    local blocked=hidden()
    if wasHidden and not blocked then
        expandUntil=os.clock()+4
        if lastFeedback~="" then feedbackUntil=os.clock()+5 end
    end
    wasHidden=blocked
    panel.Visible=not blocked and not phone
    icon.Visible=not blocked and phone
    drawerHeading.Text,drawerHeading.Visible=heading.Text,phone
    details.Visible=not blocked and (expanded or (not phone and (os.clock()&lt;expandUntil or circuits.Visible)))
    toggle.Text=if expanded then "−" else "+"
    local held=player:GetAttribute("LastOrdersHeld")==true
    local protected=player:GetAttribute("LastOrdersProtected")==true
    if held then note.Visible=false end
    local health=player:GetAttribute("LastOrdersHealth")
    local combat=if held then (if health==0 then "CAUGHT AGAIN" else "ONE HIT LEFT · GET READY TO RUN") elseif protected then "ONE HIT LEFT · GET AWAY!" else ""
    feedback.Text=if combat~="" then combat else lastFeedback
    feedbackPanel.Visible=not blocked and not note.Visible and (combat~="" or os.clock()&lt;feedbackUntil)
    feedbackPanel.Position=UDim2.fromOffset(12,if details.Visible then 84+details.AbsoluteSize.Y else 76)
    if blocked then note.Visible=false end
end
local function message()
    local value=player:GetAttribute("LastOrdersMessage")
    lastFeedback=if typeof(value)=="string" then value else ""
    feedbackUntil=if lastFeedback~="" then os.clock()+5 else 0
    update()
end
local function toggleDetails() expanded=not expanded expandUntil=0 update() end
toggle.Activated:Connect(toggleDetails)
iconButton.Activated:Connect(toggleDetails)
close.Activated:Connect(function() note.Visible=false update() end)
local function readNote()
    local serial=player:GetAttribute("LastOrdersNoteSerial")
    if serial==noteSerial then return end noteSerial=serial
    local text=player:GetAttribute("LastOrdersNoteText")
    if typeof(text)=="string" and text~="" then task.defer(function() noteText.Text=text note.Visible=true feedbackUntil=0 end) end
end
for _,name in {"LastOrdersHealth","LastOrdersHeld","LastOrdersProtected","LastOrdersArrivalScene","LastOrdersStage","CellarBreakerProgress","LastOrdersGameOver","LastOrdersDriving","LastOrdersEntryScene","LastOrdersRevealScene"} do player:GetAttributeChangedSignal(name):Connect(update) end
player:GetAttributeChangedSignal("LastOrdersMessage"):Connect(message)
player:GetAttributeChangedSignal("LastOrdersNoteSerial"):Connect(readNote)
local elapsed=0
local connection=RunService.Heartbeat:Connect(function(dt) elapsed+=dt if elapsed&gt;.15 then elapsed=0 update() end end)
script.Destroying:Connect(function() connection:Disconnect() gui:Destroy() end)
update() message() gui.Parent=player:WaitForChild("PlayerGui")
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAssetIntegration1_15">
          <Properties>
            <string name="Name">MonsterAudio</string>
            <string name="Source">--!strict
-- A cheap listener-to-monster occlusion sample preserves spatial cues through the pub.
local Audio={}
function Audio.new(root: BasePart,sounds: {Sound})
    local filters: {[Sound]: EqualizerSoundEffect}={}
    local base: {[Sound]: number}={}
    for _,sound in sounds do
        base[sound]=sound.Volume
        local eq=Instance.new("EqualizerSoundEffect") eq.Name="PubOcclusion" eq.Parent=sound filters[sound]=eq
    end
    local elapsed=0
    return function(character: Model?,dt: number)
        elapsed+=dt if elapsed&lt;.2 then return end elapsed=0
        local listener=if character then character:FindFirstChild("Head") else nil
        if not listener or not listener:IsA("BasePart") then return end
        local cast=RaycastParams.new() cast.FilterType=Enum.RaycastFilterType.Exclude cast.FilterDescendantsInstances={root,character :: Model}
        local blocked=workspace:Raycast(listener.Position,root.Position-listener.Position,cast)~=nil
        local otherFloor=math.abs(listener.Position.Y-root.Position.Y)&gt;9
        local gain=if otherFloor then .28 elseif blocked then .48 else 1
        for sound,eq in filters do
            sound.Volume=base[sound]*gain
            eq.HighGain,eq.MidGain=if blocked then -16 else 0,if otherFloor then -8 elseif blocked then -3 else 0
        end
    end
end
return Audio
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAssetIntegration1_16">
          <Properties>
            <string name="Name">PropRenderer</string>
            <string name="Source">--!strict
-- Original uploaded-free GLB geometry. Fixed-size templates are shared between repeated props.
local AssetService=game:GetService("AssetService")
local HttpService=game:GetService("HttpService")
local Shared=game.ReplicatedStorage:WaitForChild("HalloweenShared")
local Data=Shared:WaitForChild("PropMeshData")
local Renderer={}
local function vector(v: {number}): Vector3 return Vector3.new(v[1],v[2],v[3]) end
local function configure(p: BasePart,web: boolean)
    p.Anchored,p.CanCollide,p.CanTouch,p.CanQuery=true,false,false,false
    p.CastShadow=not web
end
function Renderer.new(map: Folder)
    local markers=map:WaitForChild("AssetPlacements")
    while not markers:GetAttribute("PlacementCount") do task.wait() end
    local model=Instance.new("Folder") model.Name="OriginalAssetVisuals" model.Parent=workspace
    model:SetAttribute("Rendering","Loading") model:SetAttribute("LoadedPlacements",0) model:SetAttribute("FailedAssets",0)
    local alive=true
    local fixedMeshes: {EditableMesh}={}
    local templates: {MeshPart}={}
    local dynamic: {any}={}
    local hidden: {[BasePart]: number}={}
    local function hide(p: BasePart)
        if hidden[p]==nil then hidden[p]=p.LocalTransparencyModifier end
        p.LocalTransparencyModifier=1
    end
    local function buildGroup(group: any,palette: any): MeshPart
        local mesh=AssetService:CreateEditableMesh()
        assert(mesh,"Editable mesh memory unavailable")
        local fixed: EditableMesh?=nil
        local part: MeshPart?=nil
        local ok,err=pcall(function()
            local ids: {number},normalIds: {number}={},{}
            local positions: {[string]: number},normals: {[string]: number}={},{}
            local colorIds: {number}={}
            for _,rgb in palette do table.insert(colorIds,mesh:AddColor(Color3.new(table.unpack(rgb)),1)) end
            local uv=mesh:AddUV(Vector2.zero)
            for i=1,#group.positions,3 do
                local p,n=group.positions,group.normals
                local pk=string.format("%.6f,%.6f,%.6f",p[i],p[i+1],p[i+2])
                local nk=string.format("%.6f,%.6f,%.6f",n[i],n[i+1],n[i+2])
                if not positions[pk] then positions[pk]=mesh:AddVertex(Vector3.new(p[i],p[i+1],p[i+2])) end
                if not normals[nk] then normals[nk]=mesh:AddNormal(Vector3.new(n[i],n[i+1],n[i+2])) end
                table.insert(ids,positions[pk]) table.insert(normalIds,normals[nk])
            end
            for i=1,#group.faces,3 do
                local a,b,c=group.faces[i],group.faces[i+1],group.faces[i+2]
                local face=mesh:AddTriangle(ids[a],ids[b],ids[c])
                mesh:SetFaceNormals(face,{normalIds[a],normalIds[b],normalIds[c]})
                mesh:SetFaceColors(face,{colorIds[group.colors[a]],colorIds[group.colors[b]],colorIds[group.colors[c]]})
                mesh:SetFaceUVs(face,{uv,uv,uv})
                if i%6000==1 then task.wait() end
            end
            mesh:RemoveUnused()
            fixed=AssetService:CreateEditableMeshAsync(Content.fromObject(mesh),{FixedSize=true})
            assert(fixed,"Fixed-size mesh memory unavailable")
            mesh:Destroy()
            part=AssetService:CreateMeshPartAsync(Content.fromObject(fixed :: EditableMesh),{CollisionFidelity=Enum.CollisionFidelity.Box})
            local built=part :: MeshPart
            built.Name,built.Size,built.Color=group.name,vector(group.size),Color3.new(1,1,1)
            built.DoubleSided,built.Material=true,Enum.Material.SmoothPlastic
            built.Transparency=group.transparency or 0
            built.CastShadow=(group.transparency or 0)==0
        end)
        if not ok then
            pcall(function() mesh:Destroy() end)
            if fixed then fixed:Destroy() end
            if part then part:Destroy() end
            error(tostring(err))
        end
        assert(fixed and part)
        table.insert(fixedMeshes,fixed) table.insert(templates,part)
        return part
    end
    local function pose(entry: any)
        local marker=entry.marker :: BasePart
        if not marker:IsDescendantOf(map) then return end
        local target=entry.target :: BasePart?
        local mode=entry.mode :: string
        local origin=marker.CFrame
        if target and target:IsDescendantOf(map) and mode~="Power" then
            origin=target.CFrame*(marker:GetAttribute("FollowOffset") :: CFrame)
        end
        local visible=marker:GetAttribute("Enabled")~=false
        if mode=="Key" and target then
            visible=visible and target.Transparency&lt;0.5
            hide(target)
            local fallback=target:FindFirstChild("BrassKey")
            if fallback then for _,p in fallback:GetDescendants() do if p:IsA("BasePart") then hide(p) end end end
        end
        if mode=="Door" and target and target.Transparency&gt;0.5 then visible=false end
        for _,piece in entry.pieces do
            local data=piece.data
            local offset=CFrame.new(vector(data.center)*entry.scale)
            if mode=="Power" and data.name=="Switch" then
                local pivot=vector(data.pivot)*entry.scale
                local powered=target and target:GetAttribute("Powered")==true
                offset=CFrame.new(pivot)*CFrame.Angles(if powered then -math.pi else 0,0,0)*CFrame.new((vector(data.center)-vector(data.pivot))*entry.scale)
            elseif mode=="Power" and data.name=="Indicator" and target then
                local on=target:GetAttribute("Powered")==true
                piece.part.Color=if on then Color3.new(1,1,1) else Color3.new(0.18,0.18,0.18)
                piece.part.Material=if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
            elseif mode=="Bell" and data.name=="Press" and target then
                local ready=target:GetAttribute("ReadyAt")
                local age=if typeof(ready)=="number" and ready&gt;0 then workspace:GetServerTimeNow()-(ready-entry.cooldown) else math.huge
                local press=if age&gt;=0 then 0.065*math.max(0,1-age/0.25) else 0
                offset=CFrame.new(0,-press,0)*offset
            end
            piece.part.CFrame=origin*offset
            piece.part.Transparency=if visible then piece.data.transparency or 0 else 1
        end
    end
    task.spawn(function()
        -- Reserve the established monster's mesh budget before loading optional scenery.
        for _=1,100 do
            local character=workspace:FindFirstChild("Chuggernaught")
            if character and character:GetAttribute("Rendering")~="Loading" then break end
            task.wait(0.1)
        end
        local byAsset: {[string]: {BasePart}}={}
        for _,marker in markers:GetChildren() do
            if marker:IsA("BasePart") and typeof(marker:GetAttribute("AssetName"))=="string" then
                local name=marker:GetAttribute("AssetName") :: string
                if not byAsset[name] then byAsset[name]={} end
                table.insert(byAsset[name],marker)
            end
        end
        local names={} for name in byAsset do table.insert(names,name) end
        -- Build large scratch meshes first; later small templates need less peak memory.
        table.sort(names,function(a,b)
            local left,right=#require(Data:WaitForChild(a)),#require(Data:WaitForChild(b))
            return if left==right then a&lt;b else left&gt;right
        end)
        local failures,loaded=0,0
        for _,name in names do
            if not alive then return end
            model:SetAttribute("BuildingAsset",name)
            local data=HttpService:JSONDecode(require(Data:WaitForChild(name)))
            local built={}
            local ok,err=pcall(function()
                for _,group in data.groups do table.insert(built,{template=buildGroup(group,data.palette),data=group}) end
            end)
            if ok then
                for _,marker in byAsset[name] do
                    local scale=marker:GetAttribute("AssetScale") :: Vector3
                    local targetValue=marker:FindFirstChild("Target") :: ObjectValue?
                    local target=if targetValue then targetValue.Value else nil
                    local entry={marker=marker,scale=scale,target=target,mode=marker:GetAttribute("Mode"),pieces={},cooldown=require(Shared.Config).BellCooldownSeconds}
                    for _,piece in built do
                        local part=piece.template:Clone() part.Name=name.."_"..piece.data.name
                        part.Size=vector(piece.data.size)*scale configure(part,marker:GetAttribute("CobwebCandidate")==true or (piece.data.transparency or 0)&gt;0)
                        part:SetAttribute("SourceAsset",name) part:SetAttribute("Placement",marker.Name)
                        table.insert(entry.pieces,{part=part,data=piece.data})
                    end
                    pose(entry)
                    for _,piece in entry.pieces do piece.part.Parent=model end
                    for _,reference in marker:GetChildren() do
                        if reference:IsA("ObjectValue") and string.sub(reference.Name,1,11)=="Replacement" then
                            local old=reference.Value
                            if old and old:IsA("BasePart") then hide(old) end
                        end
                    end
                    if entry.mode~="Static" or marker:GetAttribute("CobwebCandidate") then table.insert(dynamic,entry) end
                    marker:SetAttribute("VisualLoaded",true)
                    loaded+=1 model:SetAttribute("LoadedPlacements",loaded)
                end
            else
                failures+=1 model:SetAttribute("FailedAssets",failures) model:SetAttribute("LastError",name..": "..tostring(err))
                warn("Original prop kept fallback for "..name..": "..tostring(err))
            end
            task.wait()
        end
        model:SetAttribute("Rendering",if failures==0 then "OriginalMeshes" else "PartialFallback")
        model:SetAttribute("FixedMeshCount",#fixedMeshes)
    end)
    local connection=game:GetService("RunService").Heartbeat:Connect(function()
        for _,entry in dynamic do pose(entry) end
    end)
    local controller={model=model}
    function controller.destroy()
        alive=false connection:Disconnect() model:Destroy()
        for p,old in hidden do if p.Parent then p.LocalTransparencyModifier=old end end
        for _,p in templates do p:Destroy() end
        for _,mesh in fixedMeshes do mesh:Destroy() end
    end
    map.Destroying:Once(controller.destroy)
    return controller
end
return Renderer
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAssetIntegration1_17">
          <Properties>
            <string name="Name">SkyLightning</string>
            <string name="Source">--!strict
-- One brief distant bolt per storm event. Outdoor fill restores after the flash/cleanup.
local TweenService=game:GetService("TweenService")
local Lighting=game:GetService("Lighting")
local Sky={}
function Sky.new(folder: Folder)
    local ambient=Lighting.OutdoorAmbient
    local tween: Tween?=nil
    local random=Random.new()
    local controller={}
    function controller.flash()
        if tween then tween:Cancel() end
        Lighting.OutdoorAmbient=Color3.fromRGB(165,184,224)
        tween=TweenService:Create(Lighting,TweenInfo.new(.38),{OutdoorAmbient=ambient}) tween:Play()
        local origin=Vector3.new(random:NextNumber(-100,100),130,random:NextNumber(-90,30))
        local previous=origin
        local function segment(a: Vector3,b: Vector3,width: number)
            local p=Instance.new("Part") p.Name="DistantLightningBolt" p.Size=Vector3.new(width,width,(b-a).Magnitude)
            p.CFrame,p.Anchored,p.Material=CFrame.lookAt((a+b)/2,b),true,Enum.Material.Neon
            p.CanCollide,p.CanQuery,p.CanTouch=false,false,false
            p.Color,p.Parent=Color3.fromRGB(210,228,255),folder
            TweenService:Create(p,TweenInfo.new(.35),{Transparency=1}):Play()
            task.delay(.45,function() p:Destroy() end)
        end
        for i=1,5 do
            local point=origin+Vector3.new(random:NextNumber(-8,8),-i*12,random:NextNumber(-4,4))
            segment(previous,point,.32)
            if i==3 then segment(point,point+Vector3.new(16,-16,3),.16) end
            previous=point
        end
    end
    function controller.destroy()
        if tween then tween:Cancel() end
        Lighting.OutdoorAmbient=ambient
    end
    return controller
end
return Sky
</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBXAssetIntegration1_18">
          <Properties>
            <string name="Name">Storm</string>
            <string name="Source">--!strict
-- Exterior ambience only. No player movement, objectives, NPC states or inventory changes.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local TweenService=game:GetService("TweenService")
local SoundService=game:GetService("SoundService")
local UserInputService=game:GetService("UserInputService")
if workspace:GetAttribute("LastOrdersGreybox")~=true then return end
local map=workspace:WaitForChild("LastOrdersPrototype")
local exterior=map:WaitForChild("Exterior")
local player=Players.LocalPlayer
local folder=Instance.new("Folder") folder.Name="LastOrdersStorm" folder.Parent=workspace
local rain=require(script.Parent.StormRain).new(folder,if UserInputService.TouchEnabled then 64 else 100)
local function audio(name: string,id: string,volume: number,pitch: number,looped: boolean): Sound
    local s=Instance.new("Sound") s.Name,s.SoundId=name,id
    s.Volume,s.PlaybackSpeed,s.Looped=volume,pitch,looped s.Parent=SoundService return s
end
-- Bundled water/impact clips provide local placeholder storm audio without uploads.
local rainSound=audio("LastOrdersRain","rbxasset://sounds/action_swim.mp3",0.04,0.7,true)
local thunder=audio("LastOrdersThunder","rbxasset://sounds/impact_explosion_03.mp3",0.12,0.45,false)
local eq=Instance.new("EqualizerSoundEffect") eq.HighGain,eq.MidGain,eq.LowGain=-20,-8,4 eq.Parent=thunder
rainSound:Play()
local flash=Instance.new("ColorCorrectionEffect") flash.Name="LastOrdersLightning" flash.Parent=game:GetService("Lighting")
local windowLightning=require(script.Parent.WindowLightning).new(map,folder)
local skyLightning=require(script.Parent.SkyLightning).new(folder)
local random=Random.new()
local nextThunder=os.clock()+random:NextNumber(6,11)
local inside=true
local accumulator,coverTime=0,0
local coverCast=RaycastParams.new() coverCast.FilterType=Enum.RaycastFilterType.Exclude
local sign=exterior:WaitForChild("PubFrontage"):WaitForChild("HangingPubSign") :: Model
local signPivot=sign:GetPivot()
local hazards: {BasePart}={}
local car=exterior:WaitForChild("BrokenDownCar")
for _,object in car:GetChildren() do
    if object:IsA("BasePart") and object.Name=="HazardLamp" then table.insert(hazards,object) end
end
local alive=true
local connection: RBXScriptConnection?=nil
connection=RunService.Heartbeat:Connect(function(dt: number)
    if not map:IsDescendantOf(workspace) then
        alive=false
        if connection then connection:Disconnect() end
        skyLightning.destroy() folder:Destroy() rainSound:Destroy() thunder:Destroy() flash:Destroy() return
    end
    local character=player.Character
    local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
    if not root or not root:IsA("BasePart") then return end
    accumulator+=dt coverTime+=dt
    if coverTime&gt;=0.5 then
        coverTime=0 coverCast.FilterDescendantsInstances={character,folder}
        inside=workspace:Raycast(root.Position+Vector3.new(0,1,0),Vector3.new(0,100,0),coverCast)~=nil
        rainSound.Volume=if inside then 0.035 else 0.16
    end
    if accumulator&gt;=1/30 then
        rain.step(root.Position,character,accumulator) accumulator=0
        local t=workspace:GetServerTimeNow()
        sign:PivotTo(signPivot*CFrame.Angles(0,0,math.sin(t*1.1)*0.025))
        local on=car:GetAttribute("HazardsEnabled")==true and math.floor(t*1.3)%2==0
        for _,p in hazards do p.Material=if on then Enum.Material.Neon else Enum.Material.Glass p.Transparency=if on then 0 else 0.5 end
    end
    if os.clock()&gt;=nextThunder then
        nextThunder=os.clock()+random:NextNumber(22,40)
        skyLightning.flash()
        windowLightning.flash()
        flash.Brightness=if inside then 0 else 0.09
        TweenService:Create(flash,TweenInfo.new(0.3),{Brightness=0}):Play()
        task.delay(random:NextNumber(0.8,1.7),function()
            if alive then thunder.Volume=if inside then 0.1 else 0.22 thunder:Play() end
        end)
    end
end)
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAssetIntegration1_19">
          <Properties>
            <string name="Name">StormRain</string>
            <string name="Source">--!strict
-- Recycled local rain columns. Roof hits are sampled before spawning each streak.
local Rain={}
function Rain.new(parent: Folder,count: number)
    local random=Random.new()
    local parts: {Part}={}
    local stops: {number}={}
    local valid: {boolean}={}
    local cast=RaycastParams.new()
    cast.FilterType=Enum.RaycastFilterType.Exclude
    for i=1,count do
        local p=Instance.new("Part") p.Name="RainStreak" p.Size=Vector3.new(0.025,1.8,0.025)
        p.Color,p.Material,p.Transparency=Color3.fromRGB(166,185,210),Enum.Material.Neon,1
        p.Anchored,p.CanCollide,p.CanTouch,p.CanQuery=true,false,false,false
        p.CastShadow,p.Parent=false,parent parts[i]=p valid[i]=false
    end
    local controller={}
    function controller.step(center: Vector3,character: Model?,dt: number)
        cast.FilterDescendantsInstances=if character then {parent,character} else {parent}
        for i,p in parts do
            local offset=p.Position-center
            if not valid[i] or p.Position.Y&lt;=stops[i]+1.2 or Vector2.new(offset.X,offset.Z).Magnitude&gt;44 then
                local x,z=center.X+random:NextNumber(-32,32),center.Z+random:NextNumber(-32,32)
                local hit=workspace:Raycast(Vector3.new(x,center.Y+100,z),Vector3.new(0,-200,0),cast)
                stops[i]=if hit then hit.Position.Y else -30
                local y=math.max(center.Y+random:NextNumber(16,32),stops[i]+random:NextNumber(4,18))
                p.Position=Vector3.new(x,y,z)
                p:SetAttribute("RainStopY",stops[i]) valid[i]=true
            else
                -- Fixed X/Z columns keep roof clipping valid; the streak shape suggests wind.
                p.Position-=Vector3.new(0,42*math.min(dt,0.05),0)
                if p.Position.Y&lt;=stops[i]+1.2 then valid[i]=false end
            end
            p.Transparency=if valid[i] then 0.58 else 1
            p.CFrame=CFrame.lookAt(p.Position,p.Position+Vector3.new(5,-42,2))*CFrame.Angles(math.pi/2,0,0)
        end
    end
    return controller
end
return Rain
</string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBXAssetIntegration1_20">
          <Properties>
            <string name="Name">Survival</string>
            <string name="Source">--!strict
-- Presentation/input only. Server attributes own health, holds and game-over timing.
local Players=game:GetService("Players")
local StarterGui=game:GetService("StarterGui")
if workspace:GetAttribute("LastOrdersGreybox")~=true then return end
local player=Players.LocalPlayer
local gui=Instance.new("ScreenGui") gui.Name,gui.ResetOnSpawn,gui.DisplayOrder="LastOrdersSurvival",false,20
local UI=require(script.Parent.TavernUI)
local dial=require(script.Parent.HealthDial).new(gui)
local bar=dial.frame
local overlay=Instance.new("Frame") overlay.Name,overlay.Size="GameOver",UDim2.fromScale(1,1)
overlay.BackgroundColor3,overlay.BackgroundTransparency,overlay.Visible=UI.Ink,.02,false overlay.BorderSizePixel=0
UI.ending(overlay,true)
overlay.Parent=gui
gui.Parent=player:WaitForChild("PlayerGui")
local controls=require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
local movementLocked=false
pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health,false) end)
local function update()
    local value=player:GetAttribute("LastOrdersHealth")
    local health=if typeof(value)=="number" then math.clamp(value,0,2) else 2
    local held=player:GetAttribute("LastOrdersHeld")==true
    local gameOver=player:GetAttribute("LastOrdersGameOver")==true
    dial.update(health)
    local driving=player:GetAttribute("LastOrdersDriving")==true
    overlay.Visible,bar.Visible=gameOver,not gameOver and not driving and player:GetAttribute("LastOrdersArrivalScene")~=true and player:GetAttribute("LastOrdersEntryScene")~=true and player:GetAttribute("LastOrdersRevealScene")~=true
    bar.AnchorPoint,bar.Position=Vector2.zero,UDim2.fromOffset(12,8)
    local locked=held or gameOver or driving or player:GetAttribute("LastOrdersEntryScene")==true or player:GetAttribute("LastOrdersArrivalScene")==true or player:GetAttribute("LastOrdersRevealScene")==true
    if locked~=movementLocked then
        movementLocked=locked
        if locked then controls:Disable() else controls:Enable() end
    end
end
for _,name in {"LastOrdersRevealScene","LastOrdersArrivalScene","LastOrdersDriving","LastOrdersEntryScene","LastOrdersHealth","LastOrdersHeld","LastOrdersGameOver","LastOrdersProtected"} do
    player:GetAttributeChangedSignal(name):Connect(update)
end
script.Destroying:Connect(function()
    if movementLocked then controls:Enable() end
    pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health,true) end)
    gui:Destroy()
end)
update()
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAssetIntegration1_21">
          <Properties>
            <string name="Name">TavernUI</string>
            <string name="Source">--!strict
-- Shared presentation primitives; gameplay and restart timing remain server-owned.
local UI={}
UI.Ink=Color3.fromRGB(23,19,22)
UI.Ivory=Color3.fromRGB(240,223,188)
UI.Brass=Color3.fromRGB(188,161,106)
UI.Muted=Color3.fromRGB(188,177,159)
UI.Crimson=Color3.fromRGB(196,59,71)
UI.Heading=Font.new("rbxasset://fonts/families/Fondamento.json")
UI.Body=Font.new("rbxasset://fonts/families/Nunito.json")
UI.Defeat=Font.new("rbxasset://fonts/families/Creepster.json")
function UI.frame(parent: Instance,name: string): Frame
    local frame=Instance.new("Frame") frame.Name,frame.BackgroundColor3,frame.BorderSizePixel=name,UI.Ink,0
    frame.BackgroundTransparency=.03 frame.Parent=parent
    local stroke=Instance.new("UIStroke") stroke.Color,stroke.Transparency,stroke.Thickness,stroke.Parent=UI.Brass,.45,1,frame
    local corner=Instance.new("UICorner") corner.CornerRadius,corner.Parent=UDim.new(0,5),frame
    return frame
end
function UI.stack(frame: Frame,padding: number,gap: number)
    local inset=Instance.new("UIPadding")
    inset.PaddingLeft,inset.PaddingRight=UDim.new(0,padding),UDim.new(0,padding)
    inset.PaddingTop,inset.PaddingBottom=UDim.new(0,padding),UDim.new(0,padding) inset.Parent=frame
    local layout=Instance.new("UIListLayout") layout.SortOrder,layout.Padding=Enum.SortOrder.LayoutOrder,UDim.new(0,gap) layout.Parent=frame
end
function UI.text(parent: Instance,name: string,text: string,font: Font,size: number,color: Color3,order: number): TextLabel
    local label=Instance.new("TextLabel") label.Name,label.Text=name,text
    label.Size,label.AutomaticSize=UDim2.new(1,0,0,0),Enum.AutomaticSize.Y
    label.BackgroundTransparency,label.FontFace,label.TextSize,label.TextColor3=1,font,size,color
    label.TextWrapped,label.TextXAlignment,label.TextYAlignment=true,Enum.TextXAlignment.Left,Enum.TextYAlignment.Top
    label.LayoutOrder,label.Parent=order,parent
    return label
end
function UI.rule(parent: Instance,order: number)
    local line=Instance.new("Frame") line.Name,line.Size="BrassRule",UDim2.new(1,0,0,1)
    line.BackgroundColor3,line.BackgroundTransparency,line.BorderSizePixel=UI.Brass,.6,0 line.LayoutOrder,line.Parent=order,parent
end
-- Vector-like local crest: no image download or asset permission dependency.
function UI.crest(parent: Instance,size: number,order: number): Frame
    local holder=Instance.new("Frame") holder.Name="FireflyCrest"
    holder.Size,holder.BackgroundTransparency,holder.LayoutOrder=UDim2.new(1,0,0,size),1,order
    holder.Parent=parent
    local function shape(name: string,x: number,y: number,w: number,h: number,rotation: number,color: Color3)
        local f=Instance.new("Frame") f.Name=name f.AnchorPoint=Vector2.new(.5,.5)
        f.Position,f.Size=UDim2.new(.5,x*size,0,y*size),UDim2.fromOffset(w*size,h*size)
        f.Rotation,f.BackgroundColor3,f.BorderSizePixel=rotation,color,0
        local c=Instance.new("UICorner") c.CornerRadius,c.Parent=UDim.new(1,0),f f.Parent=holder
    end
    for _,side in {-1,1} do
        shape("Wing",side*.18,.37,.32,.12,side*-30,UI.Brass)
        shape("Wing",side*.16,.52,.27,.10,side*30,UI.Brass)
    end
    shape("Body",0,.52,.09,.34,0,UI.Brass)
    shape("Light",0,.64,.08,.12,0,UI.Ivory)
    shape("Head",0,.29,.12,.12,0,UI.Ivory)
    return holder
end
function UI.title(parent: Instance): Frame
    local card=UI.frame(parent,"TitleCard")
    card.Size,card.AutomaticSize=UDim2.new(.88,0,0,0),Enum.AutomaticSize.Y
    card.AnchorPoint,card.Position=Vector2.new(.5,.5),UDim2.fromScale(.5,.43)
    local limit=Instance.new("UISizeConstraint") limit.MaxSize,limit.Parent=Vector2.new(480,1000),card
    UI.stack(card,18,5) UI.crest(card,52,0)
    local a=UI.text(card,"Title","THE CHUGGERNAUGHT",UI.Heading,30,UI.Ivory,1)
    local b=UI.text(card,"Subtitle","LAST ORDERS",UI.Heading,23,UI.Brass,2)
    UI.rule(card,3)
    local c=UI.text(card,"Location","THE FIREFLY TAVERN",UI.Body,14,UI.Muted,4)
    for _,label in {a,b,c} do label.TextXAlignment=Enum.TextXAlignment.Center end
    return card
end
function UI.ending(parent: Instance,defeat: boolean): Frame
    local card=UI.frame(parent,if defeat then "DefeatCard" else "VictoryCard")
    card.Size,card.AutomaticSize=UDim2.new(.88,0,0,0),Enum.AutomaticSize.Y
    card.AnchorPoint,card.Position=Vector2.new(.5,.5),UDim2.fromScale(.5,.5)
    local limit=Instance.new("UISizeConstraint") limit.MaxSize,limit.Parent=Vector2.new(520,1000),card
    UI.stack(card,18,7)
    UI.crest(card,48,0)
    local eyebrow=UI.text(card,"Eyebrow",if defeat then "YOU WERE" else "THE CHUGGERNAUGHT · LAST ORDERS",UI.Body,15,UI.Brass,1)
    local title=UI.text(card,"Headline",if defeat then "CAUGHT" else "You survived",if defeat then UI.Defeat else UI.Heading,if defeat then 44 else 34,if defeat then UI.Crimson else UI.Ivory,2)
    UI.rule(card,3)
    local detail=UI.text(card,"Detail",if defeat then "The Chuggernaught caught you." else "The Firefly Tavern is behind you.\nThe dare is over. Never again.",UI.Body,18,UI.Ivory,4)
    local status=UI.text(card,"Status",if defeat then "Restarting…" else "RESTORE THE LIGHTS. FIND THE KEY. ESCAPE.",UI.Body,15,UI.Muted,5)
    for _,label in {eyebrow,title,detail,status} do label.TextXAlignment=Enum.TextXAlignment.Center end
    return card
end
return UI
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAssetIntegration1_22">
          <Properties>
            <string name="Name">WindowLightning</string>
            <string name="Source">--!strict
-- Local light sources inside the window reveals; shadowing contains light to connected rooms.
local TweenService=game:GetService("TweenService")
local Lightning={}
function Lightning.new(map: Folder,folder: Folder)
    local lights: {PointLight}={}
    local function source(position: Vector3)
        local p=Instance.new("Part") p.Name="WindowLightningSource" p.Size=Vector3.one*.1
        p.Position,p.Anchored,p.Transparency=position,true,1
        p.CanCollide,p.CanTouch,p.CanQuery=false,false,false p.Parent=folder
        local l=Instance.new("PointLight") l.Name="WindowFlash" l.Color=Color3.fromRGB(185,207,255)
        l.Range,l.Brightness,l.Shadows,l.Parent=38,0,true,p table.insert(lights,l)
    end
    local windows=map:WaitForChild("StormViewWindows")
    for _,p in windows:GetChildren() do
        if p:IsA("BasePart") and p.Name=="WindowBarrier" then
            source(Vector3.new(p.Position.X-math.sign(p.Position.X)*2,p.Position.Y,p.Position.Z))
        end
    end
    -- Front facade windows overlook the tall lounge and two southern bedrooms.
    for _,x in {6,25,40} do source(Vector3.new(x,24,86)) end
    for _,x in {-40,-18} do source(Vector3.new(x,24,38)) end
    local controller={}
    function controller.flash()
        for _,l in lights do
            l.Brightness=3.5
            TweenService:Create(l,TweenInfo.new(.32,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Brightness=0}):Play()
        end
    end
    return controller
end
return Lightning
</string>
          </Properties>
