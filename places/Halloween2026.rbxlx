					<ProtectedString name="Source"><![CDATA[--!strict
return table.freeze({
    Title = "The Chuggernaught: Last Orders",
    Objectives = table.freeze({
        "Read the warning at the bar.",
        "Restore the pub's lights at the cellar fuse box.",
        "Search the eight guest rooms and office for the exit key.",
        "Unlock the emergency exit with the key.",
        "YOU SURVIVED LAST ORDERS!",
    }),
    InteractionDistance = 12,
    MonsterSpeed = 9,
    MonsterRevealSeconds = 3.5,
    MonsterChugSeconds = 2.8,
    MonsterDrinkInterval = 12,
    MonsterMaxDrinkBoosts = 3,
    MonsterDrinkSpeedBoost = 0.5,
    ChaseSpeed = 13,
    CatchDistance = 4,
    DistractionSeconds = 12,
})
]]></ProtectedString>
