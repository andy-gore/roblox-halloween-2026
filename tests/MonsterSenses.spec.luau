--!strict
-- Studio Edit server Command Bar: real rays, field of view, furniture and floor occlusion.
local folder=Instance.new("Folder") folder.Name="MonsterSensesTest" folder.Parent=workspace
local offset=Vector3.new(8000,0,0)
local function part(name: string,size: Vector3,position: Vector3,parent: Instance): Part
    local p=Instance.new("Part") p.Name,p.Size,p.Position=name,size,position+offset
    p.Anchored,p.Parent=true,parent return p
end
local ok,err=pcall(function()
    local monster=part("Monster",Vector3.new(4,8,4),Vector3.new(0,4.5,0),folder)
    monster.CFrame=CFrame.lookAt(monster.Position,monster.Position+Vector3.zAxis)
    local character=Instance.new("Model") character.Name,character.Parent="Target",folder
    local root=part("HumanoidRootPart",Vector3.new(2,2,1),Vector3.new(0,3,20),character)
    local head=part("Head",Vector3.one,Vector3.new(0,4.5,20),character)
    local senses=require(game.ServerScriptService.HalloweenServer.MonsterSenses).new(monster)
    local function move(position: Vector3)
        root.Position=offset+position head.Position=root.Position+Vector3.new(0,1.5,0)
    end
    local seen,reach=senses.sample(character,root)
    assert(seen and not reach,"Visible distant target should trigger pursuit, not capture")
    move(Vector3.new(0,3,-20))
    assert(not senses.sample(character,root),"Rear target outside peripheral range must stay unseen")
    move(Vector3.new(0,3,-5))
    seen,reach=senses.sample(character,root)
    assert(seen and not reach,"Nearby noise-awareness must not give a backwards grab")
    move(Vector3.new(0,3,-12))
    assert(not senses.sample(character,root),"Calm peripheral range must stay limited")
    assert(senses.sample(character,root,true),"An alert monster must notice a nearby player looping behind him")
    move(Vector3.new(0,3,-2))
    local contact
    seen,reach,contact=senses.sample(character,root)
    assert(seen and reach and contact,"Passing through his body must remain dangerous from either side")
    move(Vector3.new(0,3,5))
    seen,reach=senses.sample(character,root)
    assert(seen and reach,"Close frontal target must be dangerous")
    local wall=part("Wall",Vector3.new(10,12,1),Vector3.new(0,6,2.5),folder)
    seen,reach=senses.sample(character,root)
    assert(not seen and not reach,"Walls must block detection and grabs")
    assert(not senses.sample(character,root,true),"Alert vision must still respect walls")
    wall:Destroy()
    move(Vector3.new(0,19,5))
    local floor=part("UpperFloor",Vector3.new(30,1,30),Vector3.new(0,16,0),folder)
    seen,reach=senses.sample(character,root)
    assert(not seen and not reach,"No detection/capture through a storey")
    assert(not senses.sample(character,root,true),"Alert vision must not see through floors")
    floor:Destroy()
    move(Vector3.new(0,3,100))
    assert(not senses.sample(character,root),"Sight must have a bounded range")
    local ground=part("Ground",Vector3.new(100,1,100),Vector3.new(0,0,0),folder)
    move(Vector3.new(0,3,-20))
    root.Anchored=false root.AssemblyLinearVelocity=Vector3.new(12,0,0)
    assert(senses.footsteps(character,root),"Nearby fast grounded movement must be audible")
    root.AssemblyLinearVelocity=Vector3.zero
    assert(not senses.footsteps(character,root),"Standing still must not update the monster")
    root.AssemblyLinearVelocity=Vector3.new(12,0,0)
    move(Vector3.new(0,3,-40))
    assert(not senses.footsteps(character,root),"Footsteps must have bounded range")
    move(Vector3.new(0,19,-5))
    assert(not senses.footsteps(character,root),"Footsteps cannot identify a player on another storey")
    move(Vector3.new(0,3,-20))
    local soundWall=part("SoundWall",Vector3.new(20,12,1),Vector3.new(0,6,-10),folder)
    assert(not senses.footsteps(character,root),"A wall must muffle distant footsteps")
    move(Vector3.new(0,3,-8))
    soundWall.Position=offset+Vector3.new(0,6,-4)
    assert(senses.footsteps(character,root),"Very close footsteps can carry around an interior wall")
    ground:Destroy()
end)
folder:Destroy()
assert(ok,tostring(err))
print("Senses: frontal/peripheral detection, reach, walls, floors and range passed")
